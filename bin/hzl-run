#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# hzl-run — the unattended runner. Started by launchd, or by `hzl run-now`.
#
# This half of Heinzel never uses privilege and never asks a question. It has
# no path to sudo at all, and nothing here writes the session's mode: it reads
# state.json and acts, or does nothing.
#
# Seven gates stand between being started and calling an engine, ordered
# cheapest first. If any of them closes, no API call is made and nothing is
# billed. The `todo == 0` gate is deliberately last, immediately before the
# call, so that an empty backlog costs a fraction of a second.
#
# There were eight. The first was a global `lockf` on `run.lock`, held from the
# first gate to the last line, and it was the last thing left spelling "another
# runner is running" (docs/RUNTIME-BACKENDS.md §14.3). What replaced it is not a
# different lock but three narrower statements that were already true: every
# ledger and session mutation goes under the short backlog lock, the workspace
# writer lease refuses a second run on the same checkout, and `state.json` holds
# exactly one workdir. A second runner now walks as far as the lease and skips
# there, before it has claimed anything or spent anything.

set -uo pipefail

HEINZEL_ROOT=$(
  src=${BASH_SOURCE[0]}
  while [ -L "${src}" ]; do
    dir=$(cd -P "$(dirname "${src}")" && pwd)
    src=$(readlink "${src}")
    case ${src} in
      (/*) ;;
      (*) src=${dir}/${src} ;;
    esac
  done
  cd -P "$(dirname "${src}")/.." && pwd
)
export HEINZEL_ROOT

# launchd hands over a minimal environment. The plist sets these too; both are
# needed, and neither is redundant.
export PATH="${PATH}:/usr/local/bin:/opt/homebrew/bin:${HOME}/.local/bin"
export HOME="${HOME:-$(cd ~ && pwd)}"

# shellcheck source=lib/common.sh
. "${HEINZEL_ROOT}/lib/common.sh"
# shellcheck source=lib/posture.sh
. "${HEINZEL_ROOT}/lib/posture.sh"
# shellcheck source=lib/watchdog.sh
. "${HEINZEL_ROOT}/lib/watchdog.sh"
# shellcheck source=lib/runstore.sh
. "${HEINZEL_ROOT}/lib/runstore.sh"
# shellcheck source=lib/claims.sh
. "${HEINZEL_ROOT}/lib/claims.sh"
# shellcheck source=lib/locks.sh
. "${HEINZEL_ROOT}/lib/locks.sh"
# shellcheck source=lib/finalize.sh
. "${HEINZEL_ROOT}/lib/finalize.sh"
# shellcheck source=lib/cancel.sh
. "${HEINZEL_ROOT}/lib/cancel.sh"
# shellcheck source=lib/runtimes.sh
. "${HEINZEL_ROOT}/lib/runtimes.sh"
# shellcheck source=lib/engines.sh
. "${HEINZEL_ROOT}/lib/engines.sh"

TRIGGER=launchd
DRY_RUN=0
while [ $# -gt 0 ]; do
  case $1 in
    --from) TRIGGER=${2:-launchd}; shift ;;
    --dry-run) DRY_RUN=1 ;;
    *) printf 'hzl-run: unknown option %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

hzl_load_conf
hzl_validate_conf || { log_event abort "invalid configuration"; exit 1; }

mkdir -p "${HEINZEL_HOME}" 2>/dev/null

# --- gate 1: is a session actually live? ----------------------------------
# The common case by far: four of five nightly slots, plus every slot on a day
# with no session at all. It writes nothing and exits, so that a machine in
# normal mode is untouched by having Heinzel installed.
hzl_eval_mode
if [ "${HZ_MODE}" != heinzel ]; then
  # Silence here is deliberate for launchd: this is the common case, several
  # times a night, and a machine with no session should be untouched by having
  # Heinzel installed. It is the wrong answer for a human who just typed
  # `hzl run-now` and would otherwise get no output and exit 0.
  if [ "${TRIGGER}" = manual ]; then
    log_event skip "not in a session: ${HZ_REASON}"
    err "nothing to do: ${HZ_REASON}"
    err "start a session with 'hzl work' or 'hzl mobile' first."
  elif [ "${HEINZEL_DEBUG:-0}" = 1 ]; then
    log_event skip "not in a session: ${HZ_REASON}"
  fi
  exit 0
fi

RUN_ID=$(date +%Y%m%d-%H%M%S)
# The durable run id, alongside the second-precision one and not instead of it.
# `RUN_ID` is what the ledger's `run:` provenance and `runs.jsonl` are written
# in and it does not change; this one keys the store under HEINZEL_HOME, where a
# second is not fine enough to tell two runs apart (§14.2).
STORE_RUN_ID=$(runstore_new_id)
RUN_DAY=$(date +%Y-%m-%d)
RUN_DIR="${LOG_DIR}/${RUN_DAY}"
RUN_LOG="${RUN_DIR}/run-$(date +%H%M%S).log"
EXEC_DIR="${RUN_DIR}/exec-$(date +%H%M%S)"
SNAP_DIR="${RUN_DIR}/snapshot-$(date +%H%M%S)"
NOTES="${RUN_DIR}/notes.md"
mkdir -p "${RUN_DIR}" || { log_event abort "cannot create ${RUN_DIR}"; exit 1; }

# Every workspace this session may work in. Which one this run works in is not
# known yet and cannot be: it is the workspace of the highest-priority task
# still in the queue, and the queue is not swept until further down. `WORKDIR`
# is set the moment that is decided, and everything past it - the worksheet,
# the snapshot, the engine's cwd, the reviewer, the changeset - reads that one
# value exactly as it did when a session had only ever had one.
WORKDIRS=$(state_get_workdirs)
WORKDIR=""
BACKLOG=$(state_get .backlog "")
RUN_TIMEOUT=$(state_get .run_timeout_sec 3600)
MAX_PER_RUN=$(state_get .max_tasks_per_run 3)
MAX_TOTAL=$(state_get .max_tasks_total 3)
DONE_TOTAL=$(state_get .tasks_done_total 0)

# The ledger half of the cleanup, as one function, so that the whole of it goes
# under one lock rather than a lock per marker.
cleanup_ledger() {
  # Only this run's own claims, and only in the workspace it chose - which it
  # may never have got as far as choosing, in which case it took none.
  if [ -n "${CLAIMS_READY:-}" ] && [ -n "${WS_IDENTITY:-}" ]; then
    claims_rollback_run "${WS_IDENTITY}" "${BACKLOG}" "${STORE_RUN_ID}" \
      >/dev/null 2>&1
  fi
  # The blanket pass returns *every* `[~]` in the ledger to `[ ]`, whoever set
  # it, so it may only run for the one process that holds the checkout. While
  # the global run lock existed, a second runner could not reach this line; now
  # that it does not, a runner that skipped at the lease would otherwise release
  # the live run's markers on its way out — which is precisely the "blanket
  # rollback cannot coexist with two runs" of §14.3.
  if [ -n "${LEASE_HELD:-}" ] && [ -n "${BACKLOG}" ] && [ -w "${BACKLOG}" ]; then
    backlog_reset_inprogress "${BACKLOG}" >/dev/null 2>&1
  fi
  return 0
}

# The steps the agent wrote for a person, out of the working directory. By the
# time this runs the merge has already carried them beside the ledger, where a
# person reads them; what is left here is a copy, and a copy left behind is one
# the *next* run's block would install as its own. Kept with the run's record
# first when there is somewhere to keep it.
#
# Named files and `rmdir`, never `rm -r` on a path built from configuration.
stash_steps() { # [exec-dir]
  local d=${WS_DIR:-}/blocked dest="" f
  [ -n "${WS_DIR:-}" ] && [ -d "${d}" ] || return 0
  [ -n "${1:-}" ] && [ -d "$1" ] && dest=$1/blocked
  [ -n "${dest}" ] && mkdir -p "${dest}" 2>/dev/null
  for f in "${d}"/*.md; do
    [ -f "${f}" ] || continue
    # Kept before it is removed, and removed only once it is kept: this may be
    # the only copy of instructions a person has not read yet - a run stopped
    # between its intent and its merge is finished by the next run, and that
    # run's recovery reads the copy kept here when the working directory's is
    # gone. A run with nowhere to keep it leaves it where it is.
    [ -n "${dest}" ] && [ -d "${dest}" ] &&
      cp "${f}" "${dest}/$(basename "${f}")" 2>/dev/null || continue
    rm -f "${f}"
  done
  rmdir "${d}" 2>/dev/null
  return 0
}

# Roll back an in-progress marker left by an interrupted run, and release the
# lock, whatever happens from here on.
cleanup() {
  local rc=$? stopped=1
  # First, and before anything below tries to take it: a run killed inside a
  # ledger mutation is still holding the backlog lock, and it is holding it
  # against itself. `lock_release` drops it only if this process is the holder,
  # so a lock somebody else has is left exactly where it is.
  lock_release "${LOCK_BACKLOG}" >/dev/null 2>&1

  # The stop barrier, and it comes first because everything below it is a thing
  # this run gives back (§14.5). A run ending here was killed — at the deadline,
  # by `hzl off`, by a closed lid — and the engine underneath it did not stop
  # just because the runner was told to: it is a live writer in the working
  # directory. Soft interrupt, bounded grace, force stop, then look. The
  # process group and not the process, because `hzl_timeout` starts every engine
  # at the head of one so that its own children go with it.
  if [ -n "${HEINZEL_ENGINE_PID:-}" ] && pid_alive "${HEINZEL_ENGINE_PID}"; then
    cancel_stop "${HEINZEL_ENGINE_PID}" "${CANCEL_GRACE_SEC}" "${CANCEL_KILL_SEC}" tree ||
      stopped=0
  fi
  # A quiesce that already gave up says so, and is not asked again.
  [ -n "${ORPHANED:-}" ] && stopped=0

  # A run that stops here stopped early. The snapshot already says which tasks
  # it was holding, and this is the line that says nobody finished; recovery
  # reads the two together. `workflow.json` is what recovery reads, and one left
  # saying `running` by a run that is not is a lie a reader has no way to catch.
  if [ -n "${STORE_READY:-}" ] && [ -z "${STORE_ENDED:-}" ]; then
    if [ "${stopped}" = 0 ]; then
      runstore_event "${STORE_RUN_ID}" run.orphaned \
        "the writer could not be confirmed stopped; ownership is kept" 2>/dev/null
      store_snapshot orphaned
    elif cancel_requested "${STORE_RUN_ID}"; then
      # Somebody asked for this. The receipt is what makes the release below
      # safe, and the record says cancelled rather than interrupted — a run that
      # was told to stop and did is not the same event as one that fell over.
      cancel_confirm "${STORE_RUN_ID}" "the engine is gone and the runner is exiting" \
        >/dev/null 2>&1
      runstore_event "${STORE_RUN_ID}" run.cancelled \
        "stopped on a '$(cancel_reason "${STORE_RUN_ID}")' request (status ${rc})" 2>/dev/null
      store_snapshot cancelled
    else
      runstore_event "${STORE_RUN_ID}" run.interrupted \
        "the runner stopped before the run ended (status ${rc})" 2>/dev/null
      store_snapshot interrupted
    fi
  fi

  if [ "${stopped}" = 1 ]; then
    # This run's claims first, and only this run's: the tasks it was holding go
    # back to `[ ]` and the claims go with them. Then the blanket pass, which is
    # the legacy path and catches a `[~]` no claim ever covered. One
    # transaction, because a reader who caught the ledger between the two would
    # see a run that had given half its tasks back.
    with_backlog_lock cleanup_ledger >/dev/null 2>&1
    # An interrupted run leaves its worksheet in the working directory. It is
    # scaffolding, and a stale one would be merged by nothing and read by
    # nobody. The steps beside it go the same way and for the same reason: the
    # tasks they were written for have just gone back to `[ ]`.
    if [ -n "${WS_DIR:-}" ]; then
      stash_steps "${EXEC_DIR:-}"
      rm -f "${WS_DIR}/worksheet.md"
      rmdir "${WS_DIR}" 2>/dev/null
    fi
    # Ownership goes last, and only after the writer has been confirmed gone: a
    # lease released while the engine it stands for is still running would let
    # the next run into a working directory that has one (§14.3, invariant 14).
    # Every lease, not the one for the workspace this run chose: a run holds
    # the writer lease on all of the session's workspaces for as long as it
    # could still choose any of them, and it hands all of them back.
    if [ -n "${LEASE_HELD:-}" ]; then
      while IFS= read -r released; do
        [ -n "${released}" ] || continue
        lease_release "${released}" "${STORE_RUN_ID}" >/dev/null 2>&1
      done <<EOF
${LEASE_HELD}
EOF
    fi
  else
    # `ORPHANED`: not a failure and not a success, but a stop nothing could
    # confirm. Everything stays where it is — the task claims, the worksheet and
    # the writer lease — so that no new writer is started into a checkout that
    # may still have one, and a human is told plainly (§9.2, §14.5).
    log_event HALT "run ${STORE_RUN_ID:-?} is ORPHANED: its writer could not be confirmed stopped. Task claims and the writer lease are kept - look before starting another run."
    [ "${rc}" -eq 0 ] && rc=1
  fi

  if [ -n "${RUN_LOCK_HELD:-}" ]; then
    lock_release "${RUN_LOCK_NAME}" >/dev/null 2>&1
  fi
  # Only this process's own pid file, and only if it still says this process.
  # `hzl off` kills by that file: a runner that removed one it did not write
  # would leave the live run unstoppable by the command whose whole job is
  # stopping it.
  if [ -n "${RUN_PID_HELD:-}" ] && [ "$(cat "${RUN_PID_FILE}" 2>/dev/null)" = "$$" ]; then
    rm -f "${RUN_PID_FILE}"
  fi
  exit ${rc}
}
trap cleanup EXIT INT TERM

# A gate closing is a log line for launchd and a sentence for a person: the
# operator asked for this run and is owed the reason it did not happen.
skip() {
  log_event skip "$*"
  [ "${TRIGGER}" = manual ] && err "skipped: $*"
  exit 0
}
abort() {
  log_event abort "$*"
  [ "${TRIGGER}" = manual ] && err "aborted: $*"
  exit 1
}

# --- the durable store ------------------------------------------------------
# Written under HEINZEL_HOME, which the agent cannot reach, alongside the day
# log rather than instead of it (§14.1). Nothing here is load-bearing yet: it
# records, and a store that cannot be written leaves a line in the runner log
# and changes nothing else. A run must not fail because its own record failed.

STORE_READY=""

# The ids this run claimed, as a JSON array. Empty until the worksheet exists,
# and empty rather than absent if it cannot be read: a snapshot that says "no
# tasks" is recoverable, one that will not parse is not.
store_task_ids() {
  local v=""
  if [ -n "${WORKSHEET_IDS:-}" ] && [ -r "${WORKSHEET_IDS}" ]; then
    v=$(jq -R -s -c 'split("\n") | map(select(length > 0))' \
        "${WORKSHEET_IDS}" 2>/dev/null)
  fi
  case ${v} in
    "") printf '[]' ;;
    *) printf '%s' "${v}" ;;
  esac
}

# The recovery snapshot: which run this was, where it was working, which task
# ids it had claimed, and how far it got. Everything in it is already true when
# it is written — nothing here is a prediction, because a snapshot is read by
# something trying to find out what happened after this process stopped.
#
# `runner_state` is lowercase on purpose. The uppercase workflow states of §9.2
# belong to a state machine this runner is not yet, and a legacy run that
# labelled itself `RUNNING` would be claiming to be one. The two fields that
# machine will fill are here and null, so the shape does not change under it.
store_snapshot() { # runner-state
  [ -n "${STORE_READY}" ] || return 0
  local snap
  snap=$(jq -n \
    --argjson schema_version "${RUNSTORE_SCHEMA}" \
    --arg run_id "${STORE_RUN_ID}" \
    --arg legacy_run_id "${RUN_ID}" \
    --arg runner_state "$1" \
    --arg trigger "${TRIGGER}" \
    --arg workdir "${WORKDIR}" \
    --arg backlog "${BACKLOG}" \
    --arg runtime_backend "$(runtime_selected)" \
    --argjson pid "$$" \
    --arg started_at "$(iso_at "${STARTED:-}")" \
    --arg updated_at "$(iso_at)" \
    --arg exec_dir "${EXEC_DIR}" \
    --arg log "${RUN_LOG}" \
    --argjson task_ids "$(store_task_ids)" \
    --arg verdict "${VERDICT:-}" \
    '{schema_version: $schema_version, run_id: $run_id,
      legacy_run_id: $legacy_run_id, runner_state: $runner_state,
      workflow_state: null, workflow_outcome: null,
      trigger: $trigger, workdir: $workdir, backlog: $backlog,
      runtime_backend: $runtime_backend, pid: $pid,
      started_at: $started_at, updated_at: $updated_at,
      task_ids: $task_ids, exec_dir: $exec_dir, log: $log,
      verdict: (if $verdict == "" then null else $verdict end)}' 2>/dev/null) ||
    { log_event skip "could not build the run snapshot for ${STORE_RUN_ID}"; return 0; }
  runstore_snapshot "${STORE_RUN_ID}" "${snap}" ||
    log_event skip "could not write the run snapshot for ${STORE_RUN_ID}"
  return 0
}

store_event() { # kind [message]
  [ -n "${STORE_READY}" ] || return 0
  runstore_event "${STORE_RUN_ID}" "$@" 2>/dev/null
  return 0
}

# --- gate 2: the schedule window ------------------------------------------
# launchd replays calendar events it missed while the machine was asleep, all
# at once on wake. Without this guard a laptop opened at lunchtime would fire
# every slot it slept through, in the middle of the working day.
if [ "${TRIGGER}" != manual ] && ! in_window; then
  skip "outside the run window (hours: $(hours_display))"
fi

# --- gate 2b: the minimum gap ----------------------------------------------
# What is left of gate 2 when the window is every hour. `HEINZEL_HOURS=all` is
# a legitimate schedule — a session that is on may be allowed to work whenever
# it is on — but it makes the window guard above always true, and the burst it
# was there to stop comes back: every slot the machine slept through fires at
# once on wake, and each one is now inside the window.
#
# So the gap is measured from the last run that actually ran, not from the
# schedule. An hourly schedule never trips it; a replay of six missed slots
# runs one of them and skips five. Manual runs are not gated, here as above:
# `hzl run-now` means now.
if [ "${TRIGGER}" != manual ] && [ "${HEINZEL_MIN_RUN_GAP_SEC}" -gt 0 ]; then
  LAST_START=$(last_run_started_epoch) || LAST_START=""
  if [ -n "${LAST_START}" ]; then
    SINCE_LAST=$(( $(now_epoch) - LAST_START ))
    # A record from the future is a clock that moved, not a run that has not
    # happened yet. Treated as "long enough ago", because the alternative is a
    # machine that refuses to work until its own clock catches up.
    if [ "${SINCE_LAST}" -ge 0 ] &&
       [ "${SINCE_LAST}" -lt "${HEINZEL_MIN_RUN_GAP_SEC}" ]; then
      skip "the last run started ${SINCE_LAST}s ago, inside the ${HEINZEL_MIN_RUN_GAP_SEC}s minimum gap"
    fi
  fi
fi

# --- gate 3: the session budget -------------------------------------------
REMAINING=$((MAX_TOTAL - DONE_TOTAL))
[ "${REMAINING}" -gt 0 ] || skip "session budget spent (${DONE_TOTAL}/${MAX_TOTAL})"

# --- gate 4: power ---------------------------------------------------------
# Work-mode scheduled runs never run on battery. Mobile mode is the explicit,
# confirmed exception, recorded in the session so launchd makes the same
# decision after the person has left. A manual run is also exempt, loudly.
if ! on_ac_power; then
  if session_allows_battery; then
    warn "mobile mode: running on battery ($(battery_pct))"
  elif [ "${TRIGGER}" = manual ]; then
    warn "running on battery ($(battery_pct)) because you asked for this run explicitly"
  else
    skip "on battery ($(battery_pct))"
  fi
fi

# --- gate 5: do not start a run that cannot finish ------------------------
EXPIRES=$(state_get .expires_at_epoch 0)
LEFT=$((EXPIRES - $(now_epoch)))
[ "${LEFT}" -ge "${RUN_TIMEOUT}" ] ||
  skip "too close to the deadline (${LEFT}s left, a run may need ${RUN_TIMEOUT}s)"

# --- gate 6: the things that must be true before an agent starts ----------
# Every workspace the session named, not one of them. A checkout that is not
# there is a night's tasks that cannot be worked, and the run that finds out is
# the one a task for it reaches - which could be a week later. Said here, once,
# before anything is spent.
[ -n "${WORKDIRS}" ] || abort "the session records no workdir"
while IFS= read -r one_wd; do
  [ -n "${one_wd}" ] || continue
  [ -d "${one_wd}" ] || abort "workdir is missing: ${one_wd}"
done <<EOF
${WORKDIRS}
EOF
[ -n "${BACKLOG}" ] && [ -w "${BACKLOG}" ] || abort "backlog is not writable: ${BACKLOG}"
engine_available "${HEINZEL_EXECUTOR_ENGINE}" ||
  abort "executor engine not found: ${HEINZEL_EXECUTOR_ENGINE}"

SETTINGS="${HEINZEL_ROOT}/etc/heinzel-settings.json"
# claude --print silently ignores a malformed settings file. A run that loses
# its deny list without saying so is the worst available failure, so a bad file
# stops the run rather than relaxing it.
[ -f "${SETTINGS}" ] || abort "missing ${SETTINGS} - refusing to run unconfined"
jq -e . "${SETTINGS}" >/dev/null 2>&1 ||
  abort "${SETTINGS} is not valid JSON - refusing to run unconfined"
# Valid JSON is not the same as a file that says anything. A rule still holding
# a `__NAME__` placeholder parses, is accepted, and matches nothing.
grep -q '__[A-Z_]*__' "${SETTINGS}" &&
  abort "${SETTINGS} still contains placeholders - run 'hzl install'"
# Safe mode is a claim `etc/heinzel.conf` makes and this file keeps, and they go
# out of step the moment the setting changes without `hzl install` - the
# permission file is generated, and nothing regenerates it on its own. A run
# that believes it cannot reach a cluster and can is the worst shape available,
# so the mismatch aborts here rather than being warned about at 03:00 into a log
# nobody reads. The other direction - the setting off, the file still carrying
# the rules - costs nothing and is left to `hzl doctor` to mention.
if [ "${HEINZEL_SAFE_MODE}" = 1 ]; then
  SAFE_MISSING=$(safe_mode_missing_rules "${SETTINGS}")
  [ -z "${SAFE_MISSING}" ] ||
    abort "HEINZEL_SAFE_MODE=1 but ${SETTINGS} does not deny $(printf '%s\n' "${SAFE_MISSING}" | safe_mode_missing_summary) - run 'hzl install'"
fi

# --- ownership: the writer lease and this run's own lock -------------------
# The working directory takes one writer at a time (§14.3, invariant 13), and
# since the global `run.lock` went this is the *only* thing that says so. It says
# more than that lock did, and about the right thing: the lock was about two
# runners under one `HEINZEL_HOME` and lasted exactly as long as a process,
# whereas the lease is about the checkout, names the run holding it, and survives
# the process — because a run that was killed still owns the working directory
# until something confirms it stopped.
#
# A lease left by a run that is gone is recovered here, on the way in, the same
# way stale claims are below: deliberately, and named in the log rather than
# taken silently by whoever wanted it next.
#
# A workspace with no identity is now an abort rather than a shrug. It used to
# mean "no lease, carry on", which was survivable only because the global lock
# was underneath it; a run that cannot name its workspace cannot take the lease
# that stands for it, and would be the second writer nothing had refused.
#
# All of the session's workspaces, and here rather than after the one this run
# will use is known. The order matters and this is the only order available:
# the choice is made from the queue, the queue is read after the sweep, and the
# sweep is a ledger write this run must already own the checkouts to make. So a
# run holds the writer lease on every workspace it could still choose, and
# hands back the ones it did not use with the one it did.
#
# It costs nothing that was previously possible. Two runs never overlapped
# before - a session had one workspace and one lease - and launchd fires these
# one at a time. What it buys is that "the checkout takes one writer" stays
# exactly as true with six checkouts as with one, with no window between
# choosing a workspace and owning it.
#
# Taken in configuration order, which is a fixed order, so two runs racing for
# the same set contend on the same first entry rather than deadlocking half way
# into each other's.
WS_IDENTITIES=""
while IFS= read -r one_wd; do
  [ -n "${one_wd}" ] || continue
  one_id=$(claims_workspace_identity "${one_wd}")
  [ -n "${one_id}" ] ||
    abort "cannot identify the workspace at ${one_wd} - refusing to run without a writer lease"
  WS_IDENTITIES="${WS_IDENTITIES}${one_id}
"
done <<EOF
${WORKDIRS}
EOF

LEASE_HELD=""
while IFS= read -r one_id; do
  [ -n "${one_id}" ] || continue
  RECOVERED=$(lease_reclaim "${one_id}")
  [ -n "${RECOVERED}" ] &&
    log_event skip "recovered the writer lease left by run ${RECOVERED}"
  if lease_acquire "${one_id}" "${STORE_RUN_ID}"; then
    LEASE_HELD="${LEASE_HELD}${one_id}
"
  else
    # Give back what this run has taken before standing down. Without this a
    # run that lost the race on the third workspace would keep the first two
    # until its EXIT trap ran, and `skip` exits through that trap - but saying
    # so here is what makes the release part of the decision rather than a
    # side effect of it.
    while IFS= read -r taken; do
      [ -n "${taken}" ] || continue
      lease_release "${taken}" "${STORE_RUN_ID}" >/dev/null 2>&1
    done <<EOF
${LEASE_HELD}
EOF
    LEASE_HELD=""
    skip "another run holds the writer lease on ${one_id#*:} (run $(lease_holder "${one_id}"))"
  fi
done <<EOF
${WS_IDENTITIES}
EOF

# One run, one advancer. A run id is new every time, so nothing can be holding
# this one and the lock cannot be refused by another run — it is refused by a
# filesystem that will not take the file, and a run that could not take the lock
# on itself does not advance. It becomes contended when something other than
# this process can move a run forward.
RUN_LOCK_NAME="run-${STORE_RUN_ID}"
RUN_LOCK_HELD=""
if lock_acquire "${RUN_LOCK_NAME}" 0; then
  RUN_LOCK_HELD=1
else
  skip "could not take the lock for run ${STORE_RUN_ID}"
fi

# The pid file, and here rather than at the top, because it is written by the
# run that holds the checkout and by no other. It used to be written before any
# of this — safe only while the global lock meant no second runner ever got
# here, and a bug the moment that went: a second runner would put its own pid in
# the file `hzl off` kills by, and then delete it on the way out, leaving the
# live run running and unreachable by the one command meant to stop it.
printf '%s' "$$" >"${RUN_PID_FILE}"
RUN_PID_HELD=1

# --- a ledger commit that was interrupted -----------------------------------
# A run that stopped inside its commit left an intent and no receipt: the ledger
# transition it was about to make, and nothing saying it made it. This run holds
# the writer lease for the checkout now, so it is the one that finishes it —
# once, and before it writes the ledger itself (§13.4, §21.1).
#
# Recovery moves `tasks_done_total`, because a run that stopped there never
# reached its own counter. So gate 3 is asked again afterwards: a completion
# recovered here is spent budget, and a run that starts anyway would be spending
# it twice.
while IFS= read -r pending; do
  [ -n "${pending}" ] || continue
  [ "${pending}" = "${STORE_RUN_ID}" ] && continue
  log_event skip "finished the ledger commit left unrecorded by run ${pending} ($(finalize_recover "${pending}" "${BACKLOG}"))"
done <<EOF
$(finalize_pending "${BACKLOG}")
EOF
DONE_TOTAL=$(state_get .tasks_done_total 0)
REMAINING=$((MAX_TOTAL - DONE_TOTAL))
[ "${REMAINING}" -gt 0 ] || skip "session budget spent (${DONE_TOTAL}/${MAX_TOTAL})"

# --- claims left behind ----------------------------------------------------
# A run that was killed left its claims in `HEINZEL_HOME`, where nothing it ran
# could have tidied them. The writer lease above means no other run is working
# this checkout, so every claim standing here belongs to a run that has
# stopped — but each is still released under its own run id, one run at a time.
# That is what makes a release attributable, and what stays correct when the
# lock stops covering the whole run (§13.4, §14.3).
# Every workspace this run holds the lease on, and not only the one it is
# about to work in. A run killed in workspace B left its claims there, and
# under one workspace the next run always cleaned them because there was
# nowhere else to be; under several, waiting for a run that happens to pick B
# again would leave a task marked `[~]` for as long as nothing needed that
# checkout. The lease is what makes this safe and this run holds all of them.
CLAIMS_READY=""
while IFS= read -r one_id; do
  [ -n "${one_id}" ] || continue
  CLAIMS_READY=1
  while IFS= read -r stale_run; do
    [ -n "${stale_run}" ] || continue
    [ "${stale_run}" = "${STORE_RUN_ID}" ] && continue
    log_event skip "released the claims left by run ${stale_run} in ${one_id#*:} ($(with_backlog_lock claims_rollback_run "${one_id}" "${BACKLOG}" "${stale_run}") marker(s) reset)"
  done <<EOF
$(claims_runs "${one_id}")
EOF
done <<EOF
${WS_IDENTITIES}
EOF

# --- the sweep -------------------------------------------------------------
# Everything closed, and everything waiting on a person, leaves the backlog
# before this run reads it, so that what a human opens is the queue and what the
# runner attacks is only what it can attack. Here and not at the end of a run,
# and not inside the ledger transition: any commit left unrecorded has already
# been recovered above, and the intent and receipt of §13.4 digest one file at
# the moment they are written. What this run closes or blocks is swept by the
# next one, which is also what keeps the review gate able to find its own
# completions - and able to move them back to `[!]` in the file it read them in.
# A sweep that failed prints `0`, which is also what a sweep with nothing to do
# prints, so the status is read and not just the number. Neither failure stops
# the run — the sweep is housekeeping, and a night spent on nothing because the
# blocked file could not be rewritten would be worse than a night worked from a
# backlog that still has yesterday's completions in it. It is a skip, which is
# the class for "this run went ahead without something it wanted" (§12).
if ARCHIVED=$(with_backlog_lock backlog_archive_done "${BACKLOG}"); then
  case ${ARCHIVED} in ""|*[!0-9]*) ARCHIVED=0 ;; esac
  [ "${ARCHIVED}" -gt 0 ] &&
    log_event swept "moved ${ARCHIVED} completed task(s) into $(ledger_archive "${BACKLOG}")"
else
  ARCHIVED=0
  log_event skip "could not move completed tasks out of ${BACKLOG}; they are still in the queue this run reads"
fi

if SWEPT_BLOCKED=$(with_backlog_lock backlog_sweep_blocked "${BACKLOG}"); then
  BLOCKED_OUT=$(printf '%s' "${SWEPT_BLOCKED}" | cut -d' ' -f1)
  BLOCKED_BACK=$(printf '%s' "${SWEPT_BLOCKED}" | cut -d' ' -f2)
  case ${BLOCKED_OUT} in ""|*[!0-9]*) BLOCKED_OUT=0 ;; esac
  case ${BLOCKED_BACK} in ""|*[!0-9]*) BLOCKED_BACK=0 ;; esac
  [ "${BLOCKED_OUT}" -gt 0 ] &&
    log_event swept "moved ${BLOCKED_OUT} blocked task(s) into $(ledger_blocked_file "${BACKLOG}")"
  # The way back. A task somebody unblocked by hand is a task this run may pick
  # up, and it is only pickable once it is in the file the worksheet is built
  # from.
  [ "${BLOCKED_BACK}" -gt 0 ] &&
    log_event swept "${BLOCKED_BACK} task(s) are no longer blocked and are back in ${BACKLOG}"
else
  BLOCKED_OUT=0
  BLOCKED_BACK=0
  # The direction that costs something: a task a person unblocked before going
  # to bed stays in the blocked file, and the worksheet is built from the
  # backlog, so this run cannot pick it up however high its priority.
  log_event skip "could not sweep ${BACKLOG} and $(ledger_blocked_file "${BACKLOG}"); anything unblocked by hand stays out of this run"
fi

# --- gate 7: is there anything to do? -------------------------------------
# Last, and immediately before the only expensive thing in this file.
# The blanket reset stays: it is the legacy path, and it is what puts back a
# `[~]` that no claim ever covered — one written by hand, or by a build older
# than the claims directory.
with_backlog_lock backlog_reset_inprogress "${BACKLOG}" >/dev/null
TODO_BEFORE=$(backlog_count "${BACKLOG}" " ")
[ "${TODO_BEFORE}" -gt 0 ] || skip "nothing to do (0 todo)"

# --- everything below here costs money ------------------------------------

MAX_TASKS=${MAX_PER_RUN}
[ "${REMAINING}" -lt "${MAX_TASKS}" ] && MAX_TASKS=${REMAINING}

with_backlog_lock backlog_assign_ids "${BACKLOG}"
DONE_BEFORE=$(backlog_count "${BACKLOG}" x)

# --- which workspace this run works in ------------------------------------
# The order of attack picks the task and the workspace follows from it: a
# session with six checkouts still has one queue, and the highest-priority task
# left in it decides where the night starts. The run then takes only that
# workspace's tasks, because an engine launch has one working directory - a
# worksheet spanning two would list tasks the agent could not reach half of.
#
# After `backlog_assign_ids`, deliberately. A task written by hand has no id
# until that line runs, and the branch below has to be able to name the task it
# is blocking.
#
# A task naming a workspace this session does not have is blocked, not skipped
# over. Skipping is the quieter failure and by far the worse one: the task
# stays at the top of the queue, so it is chosen again the next night and every
# night after, and each of those runs reports "nothing to do" about a backlog
# with work in it. `[!]` is where a task that needs a person goes, and a
# `(dir:)` naming no configured workspace needs a person - to fix the spelling,
# or to add the checkout to `DEFAULT_WORKDIR` and run `hzl install`.
while :; do
  RUN_WS=$(backlog_next_workspace "${BACKLOG}") || RUN_WS=""
  # The queue emptied under us, or every remaining task has just been blocked
  # by the loop below. Either way there is nothing to work.
  [ -n "${RUN_WS}" ] || skip "nothing to do (0 todo)"

  if WORKDIR=$(workdir_path_in "${RUN_WS}" "${WORKDIRS}"); then
    RUN_ROLES_RAW=$(backlog_next_roles "${BACKLOG}")
    if RUN_ROLES=$(task_roles_effective "${RUN_ROLES_RAW}"); then
      break
    fi
    BAD_ID=$(backlog_next_id "${BACKLOG}")
    [ -n "${BAD_ID}" ] || abort "the next task has an invalid roles directive and no id to block it by"
    if [ "${RUN_ROLES_RAW}" = none ] || [ -z "${RUN_ROLES_RAW}" ]; then
      ROLE_REASON="the roles directive has no producer; choose planner or executor, with reviewer optional"
    else
      ROLE_REASON="invalid roles directive '${RUN_ROLES_RAW}'; use a comma-separated subset of planner,executor,reviewer"
    fi
    if with_backlog_lock ledger_set_state "${BACKLOG}" "${BAD_ID}" "!" \
         "blocked:$(iso_at) reason:$(oneline "${ROLE_REASON}") run:${RUN_ID}"; then
      log_event skip "blocked ${BAD_ID}: ${ROLE_REASON}"
      WORKDIR=""
      continue
    fi
    abort "cannot block ${BAD_ID}, which has ${ROLE_REASON}"
  fi
  WORKDIR=""

  BAD_ID=$(backlog_next_id "${BACKLOG}")
  [ -n "${BAD_ID}" ] ||
    abort "the next task names workspace '${RUN_WS}', which this session does not have, and has no id to block it by"
  if with_backlog_lock ledger_set_state "${BACKLOG}" "${BAD_ID}" "!" \
       "blocked:$(iso_at) reason:$(oneline "no workspace named '${RUN_WS}' in this session (have: $(printf '%s' "$(workdir_names_of "${WORKDIRS}")"))") run:${RUN_ID}"; then
    # `skip`, which §12 gives as "a gate closed": this run went ahead without
    # a task it would otherwise have worked, and said which and why.
    log_event skip "blocked ${BAD_ID}: it names workspace '${RUN_WS}', which this session does not have"
  else
    abort "cannot block ${BAD_ID}, which names workspace '${RUN_WS}' that this session does not have"
  fi
done

RUN_PLANNER=0 RUN_EXECUTOR=0 RUN_REVIEWER=0
task_role_enabled "${RUN_ROLES}" planner && RUN_PLANNER=1
task_role_enabled "${RUN_ROLES}" executor && RUN_EXECUTOR=1
task_role_enabled "${RUN_ROLES}" reviewer && RUN_REVIEWER=1

# The identity of the one workspace this run chose, out of the several it holds
# leases on. Claims, the quiesce generation and the merge are all about the
# checkout being worked, so all of them read this one.
WS_IDENTITY=$(claims_workspace_identity "${WORKDIR}")
[ -n "${WS_IDENTITY}" ] ||
  abort "cannot identify the workspace at ${WORKDIR}"

# The agent works from a worksheet, not from the ledger: this run's slice of
# the queue, carrying the ids it may touch and nothing else. See SPEC §8.1.
#
# It lives in the working directory because that is the only place the agent
# can write - the sandbox is what confines it, and the sandbox is a path
# boundary. `.heinzel` is already on hzl-changeset's prune list, so the
# worksheet never shows up as a change the reviewer has to explain.
#
# The id list does *not* live there. It is what the merge checks the agent's
# work against, so it is kept in the log tree, which the agent cannot reach.
mkdir -p "${EXEC_DIR}" || abort "cannot create ${EXEC_DIR}"

# The store is created here, past the last gate, so the four nights in five with
# nothing to do leave no directories behind. A store that cannot be created is
# a line in the log and nothing more: this run is not about to fail over its
# own bookkeeping.
if runstore_init "${STORE_RUN_ID}"; then
  STORE_READY=1
  store_snapshot queued
  store_event run.queued \
    "${MAX_TASKS} task(s) allowed, ${TODO_BEFORE} todo, trigger ${TRIGGER}, workspace ${RUN_WS} (${WORKDIR})"
else
  log_event skip "could not create the run store for ${STORE_RUN_ID}; this run keeps no durable record of itself, and writes into no other run's"
fi

WS_DIR="${WORKDIR}/.heinzel"
WORKSHEET="${WS_DIR}/worksheet.md"
WORKSHEET_IDS="${EXEC_DIR}/worksheet-ids.txt"
mkdir -p "${WS_DIR}" || abort "cannot create ${WS_DIR}"
worksheet_write "${BACKLOG}" "${MAX_TASKS}" "${WORKSHEET}" "${RUN_WS}" "${RUN_ROLES}" >"${WORKSHEET_IDS}" ||
  abort "could not build a worksheet from ${BACKLOG}"
# `TODO_BEFORE` counts the whole queue and the worksheet is one workspace's
# slice of it, so the two differ whenever more than one checkout has work. The
# workspace is named here for that reason: "0 of 7" is a puzzle without it.
[ -s "${WORKSHEET_IDS}" ] ||
  abort "the worksheet came out empty for workspace ${RUN_WS} with ${TODO_BEFORE} todo(s) waiting across the queue"

# Claim them before the engine starts. The claim in HEINZEL_HOME is the record
# — it names this run and the agent cannot reach it — and the ledger's `[~]` is
# the projection of it, so that a human reading the ledger mid-run sees what is
# being worked on. The merge, or failing that the EXIT trap, releases both.
#
# A task already claimed by another run does not get a marker: displaying a
# claim this run does not hold would be a false statement about the ledger, and
# a quiet one.
CLAIMED_IDS="${EXEC_DIR}/claimed-ids.txt"
: >"${CLAIMED_IDS}" || abort "cannot write ${CLAIMED_IDS}"
# One transaction: the markers this run is about to show a human go into the
# ledger together, and a reader arriving in the middle of it sees the run before
# it started or after it claimed, never half way through claiming.
#
# Each id is re-read from the ledger before it is claimed, and one that is no
# longer `[ ]` is dropped rather than overwritten - `worksheet_claim_refusal`
# holds the rule and the reason it exists. The check is here, inside the lock,
# because that is the only place the answer stays true long enough to act on.
claim_worksheet_tasks() {
  local wid why
  while IFS= read -r wid; do
    [ -n "${wid}" ] || continue
    if ! why=$(worksheet_claim_refusal "${BACKLOG}" "${wid}"); then
      log_event skip "task ${wid} is ${why} - leaving it off the worksheet"
      continue
    fi
    if [ -n "${CLAIMS_READY}" ] &&
       ! claims_acquire "${WS_IDENTITY}" "${wid}" "${STORE_RUN_ID}"; then
      log_event skip "task ${wid} is claimed by run $(claims_holder "${WS_IDENTITY}" "${wid}") - leaving it off the worksheet"
      continue
    fi
    backlog_set_state "${BACKLOG}" "${wid}" "~" "run:${RUN_ID}"
    printf '%s\n' "${wid}" >>"${CLAIMED_IDS}"
  done <"${WORKSHEET_IDS}"
  return 0
}
with_backlog_lock claim_worksheet_tasks

# What the run holds is what the run works on. The worksheet was written from
# the ledger before any claim was taken, so a task another run got to first is
# still on it — with no `[~]`, and with nothing but a log line saying why. That
# is a task in front of the agent that it may not touch, and asking it not to
# touch one is a weaker guarantee than not showing it (§13.4).
#
# So the worksheet is written again from the claims this run actually holds, and
# the id list the merge checks scope against is replaced with the same set. The
# two must not disagree: the ids file is what makes the scope enforced rather
# than requested.
if ! cmp -s "${CLAIMED_IDS}" "${WORKSHEET_IDS}"; then
  [ -s "${CLAIMED_IDS}" ] ||
    skip "every task on the worksheet was claimed by another run or closed before this one could claim it"
  # Into a temp file and then into place: the id list is the scope of the run,
  # and a render that failed half-way through must not leave a truncated one
  # behind for the merge to read.
  worksheet_render "${BACKLOG}" "${CLAIMED_IDS}" "${WORKSHEET}" >"${WORKSHEET_IDS}.new" ||
    abort "could not rebuild the worksheet from this run's claims"
  [ -s "${WORKSHEET_IDS}.new" ] ||
    abort "the rebuilt worksheet came out empty with $(wc -l <"${CLAIMED_IDS}" | tr -d ' ') claim(s) held"
  mv -f "${WORKSHEET_IDS}.new" "${WORKSHEET_IDS}" ||
    abort "could not replace the worksheet id list"
  # The agent is told how many tasks it may close, and it is now a smaller
  # number than the budget this run started with.
  MAX_TASKS=$(wc -l <"${WORKSHEET_IDS}" | tr -d ' ')
  log_event skip "worksheet rebuilt: ${MAX_TASKS} task(s) claimed by this run"
fi

{
  printf '=== run %s (%s)\n' "${RUN_ID}" "${TRIGGER}"
  printf 'workdir  %s\n' "${WORKDIR}"
  printf 'budget   %s task(s) this run, %s/%s this session\n' "${MAX_TASKS}" "${DONE_TOTAL}" "${MAX_TOTAL}"
  printf 'roles    %s\n' "${RUN_ROLES}"
  [ "${RUN_PLANNER}" = 1 ] && printf 'planner  %s %s effort=%s\n' \
    "${HEINZEL_PLANNER_ENGINE}" "$(_engine_role_model "${HEINZEL_PLANNER_ENGINE}" planner)" \
    "$(_engine_role_effort "${HEINZEL_PLANNER_ENGINE}" planner)"
  [ "${RUN_EXECUTOR}" = 1 ] && printf 'executor %s %s effort=%s\n' \
    "${HEINZEL_EXECUTOR_ENGINE}" "$(_engine_role_model "${HEINZEL_EXECUTOR_ENGINE}" executor)" \
    "$(_engine_role_effort "${HEINZEL_EXECUTOR_ENGINE}" executor)"
  [ "${RUN_REVIEWER}" = 1 ] && printf 'reviewer %s %s effort=%s\n' \
    "${HEINZEL_REVIEWER_ENGINE}" "$(_engine_role_model "${HEINZEL_REVIEWER_ENGINE}" reviewer)" \
    "$(_engine_role_effort "${HEINZEL_REVIEWER_ENGINE}" reviewer)"
  printf 'mode     %s\n' "$(session_operating_mode)"
  # Written on every run, including the runs where it is on, because "was safe
  # mode on that night?" is a question asked of a log after the fact and the
  # answer has to be in it rather than inferred from the absence of a line.
  if [ "${HEINZEL_SAFE_MODE}" = 1 ]; then
    printf 'safe     on - gcloud, kubectl, terraform, ssh, publish and deploy commands denied\n'
  else
    printf 'safe     OFF - nothing refuses a command that reaches a real environment\n'
  fi
  printf 'power    %s\n' "$(on_ac_power && echo AC || echo "battery $(battery_pct)")"
  printf 'todo     %s\n\n' "${TODO_BEFORE}"
} >"${RUN_LOG}"

# Replace placeholders literally. sed would treat & and \ in a task description
# as replacement syntax, which is a silent corruption of the prompt.
# The value is passed through the environment, not with awk -v: awk rejects a
# literal newline in a -v assignment, and several of these values are
# multi-line (a task and its notes, a list of findings). Passing them with -v
# silently produced an empty prompt.
render() {
  local key=$1
  HZL_RENDER_VAL=$2 awk -v key="${key}" '
    BEGIN { val = ENVIRON["HZL_RENDER_VAL"] }
    {
      while ((i = index($0, key)) > 0)
        $0 = substr($0, 1, i - 1) val substr($0, i + length(key))
      print
    }'
}

PROMPT_FILE="${EXEC_DIR}/prompt.md"
# The agent is told which mode it is in either way. Not because the sentence is
# what enforces anything - the deny list is - but because an agent that knows a
# command will be refused blocks the task with a request a person can act on,
# where one that finds out by being refused writes a worse one. When the mode is
# off the instruction stands and the enforcement does not, and saying so is the
# only honest thing to put in a prompt.
if [ "${HEINZEL_SAFE_MODE}" = 1 ]; then
  SAFE_NOTE='- run anything that reaches a real environment: `gcloud`, `kubectl`,
  `terraform`, `helm`, `ssh`, a `docker push`, an `npm publish`. Safe mode is on
  for this run and they are denied; a task that needs one is a block, not an
  attempt'
else
  SAFE_NOTE='- reach a real environment on your own initiative. Safe mode is off for this
  run, so nothing refuses `gcloud`, `kubectl`, `terraform`, `ssh`, a `docker
  push` or an `npm publish`: run one only where the task text asks for it by
  name, and block rather than improvise'
fi

STARTED=$(now_epoch)
[ "${DRY_RUN}" = 1 ] && export HEINZEL_DRY_RUN=1

# The claimed ids are on the worksheet by now, so the snapshot written here is
# the one that matters for recovery: it names what a run that never comes back
# was holding. A planner is read-only, but it is still a paid part of the run
# and therefore starts only after this durable record exists.
store_snapshot running

PLANNER_HANDOFF="No separate planner ran. Inspect the repository and make the implementation plan before editing."
PLANNER_DIR="${EXEC_DIR}/planner"
PLANNER_RC=0
PLANNER_VERDICT=disabled
if [ "${RUN_PLANNER}" = 1 ]; then
  mkdir -p "${PLANNER_DIR}" || abort "cannot create ${PLANNER_DIR}"
  < "${HEINZEL_ROOT}/prompts/plan.md" \
    render '{{WORKDIR}}' "${WORKDIR}" |
    render '{{WORKSHEET}}' "${WORKSHEET}" |
    render '{{MAX_TASKS}}' "${MAX_TASKS}" |
    render '{{RUN_ID}}' "${RUN_ID}" >"${PLANNER_DIR}/prompt.md"
  [ -s "${PLANNER_DIR}/prompt.md" ] || abort "the rendered planner prompt is empty"
  if grep -q '{{[A-Z_]*}}' "${PLANNER_DIR}/prompt.md"; then
    abort "planner prompt still contains placeholders"
  fi
  store_event engine.started \
    "${HEINZEL_PLANNER_ENGINE} planner, ${HEINZEL_PLANNER_TIMEOUT}s, tasks $(store_task_ids)"
  engine_run "${HEINZEL_PLANNER_ENGINE}" planner "${WORKDIR}" \
    "${PLANNER_DIR}/prompt.md" "${PLANNER_DIR}" "${HEINZEL_PLANNER_TIMEOUT}" \
    >>"${RUN_LOG}" 2>&1
  PLANNER_RC=$?
  if [ -r "${PLANNER_DIR}/result.json" ]; then
    PLANNER_VERDICT=$(jq -r '.verdict // "error"' "${PLANNER_DIR}/result.json")
  else
    PLANNER_VERDICT=error
  fi
  if [ "${PLANNER_VERDICT}" = ok ] && [ -s "${PLANNER_DIR}/last.txt" ]; then
    PLANNER_HANDOFF=$(cat "${PLANNER_DIR}/last.txt")
  else
    PLANNER_HANDOFF="The requested planner did not produce a usable plan (verdict: ${PLANNER_VERDICT}). Inspect and plan the work yourself before editing."
    log_event skip "planner ended with '${PLANNER_VERDICT}'; the executor will plan for itself"
  fi
  store_event engine.ended \
    "planner verdict ${PLANNER_VERDICT}, exit ${PLANNER_RC}"
fi

< "${HEINZEL_ROOT}/prompts/backlog-run.md" \
  render '{{SAFE_MODE_NOTE}}' "${SAFE_NOTE}" |
  render '{{WORKDIR}}' "${WORKDIR}" |
  render '{{WORKSHEET}}' "${WORKSHEET}" |
  render '{{MAX_TASKS}}' "${MAX_TASKS}" |
  render '{{TODO_COUNT}}' "${TODO_BEFORE}" |
  render '{{RUN_ID}}' "${RUN_ID}" |
  render '{{DEADLINE}}' "$(short_at "${EXPIRES}")" |
  render '{{RUN_TIMEOUT_MIN}}' "$((RUN_TIMEOUT / 60))" |
  render '{{PLANNER_HANDOFF}}' "${PLANNER_HANDOFF}" >"${PROMPT_FILE}"

# An empty prompt would sail past the placeholder check below and be sent as a
# blank instruction. Check for substance before checking for leftovers.
[ -s "${PROMPT_FILE}" ] || abort "the rendered prompt is empty"

# A placeholder that survived rendering means the prompt is wrong in a way the
# model would silently work around.
if grep -q '{{[A-Z_]*}}' "${PROMPT_FILE}"; then
  abort "prompt still contains placeholders: $(grep -o '{{[A-Z_]*}}' "${PROMPT_FILE}" | sort -u | tr '\n' ' ')"
fi

# A shell-only snapshot, so the review stage can diff without an LLM.
if [ -x "${HEINZEL_ROOT}/bin/hzl-changeset" ] && [ "${RUN_REVIEWER}" = 1 ]; then
  "${HEINZEL_ROOT}/bin/hzl-changeset" snapshot "${WORKDIR}" "${SNAP_DIR}" \
    >>"${RUN_LOG}" 2>&1 || log_event skip "snapshot failed; review will be skipped"
fi

if [ "${RUN_EXECUTOR}" = 1 ]; then
  store_event engine.started \
    "${HEINZEL_EXECUTOR_ENGINE} executor, ${RUN_TIMEOUT}s, tasks $(store_task_ids)"
  engine_run "${HEINZEL_EXECUTOR_ENGINE}" executor "${WORKDIR}" \
    "${PROMPT_FILE}" "${EXEC_DIR}" "${RUN_TIMEOUT}" >>"${RUN_LOG}" 2>&1
  ENGINE_RC=$?
elif [ "${RUN_PLANNER}" = 1 ]; then
  # A planner-only task has a plan as its artifact. The read-only agent cannot
  # edit the worksheet, so the runner closes the assigned rows only when a real
  # (not dry-run) planner produced a non-empty handoff.
  if [ "${DRY_RUN}" != 1 ] && [ "${PLANNER_VERDICT}" = ok ] &&
     [ -s "${PLANNER_DIR}/last.txt" ]; then
    awk '{ if ($0 ~ /^- \[ \] \(id:/) sub(/^- \[ \]/, "- [x]"); print }' \
      "${WORKSHEET}" >"${WORKSHEET}.planned" &&
      mv -f "${WORKSHEET}.planned" "${WORKSHEET}"
  fi
  cp "${PLANNER_DIR}/result.json" "${EXEC_DIR}/result.json" 2>/dev/null || true
  cp "${PLANNER_DIR}/last.txt" "${EXEC_DIR}/last.txt" 2>/dev/null || true
  ENGINE_RC=${PLANNER_RC}
else
  # Defensive only: task_roles_effective refuses a set without a producer.
  # Record a failed attempt rather than silently closing work nobody performed
  # if those two decisions ever drift apart.
  ENGINE_RC=1
  jq -n --argjson schema_version "${HEINZEL_RESULT_SCHEMA}" \
    '{schema_version: $schema_version, engine: "none", role: "executor",
      verdict: "error", exit_code: 1, duration_sec: 0, text: "",
      backend: "local", runtime_state: "EXITED", native_exit_code: null,
      attempt_outcome: "FAILED"}' >"${EXEC_DIR}/result.json"
  : >"${EXEC_DIR}/last.txt"
  log_event skip "reviewer-only task has no planner or executor to produce work"
fi
ENDED=$(now_epoch)

# --- the quiesce: the write barrier between working and being read -----------
# Between the engine ending and anything acting on what it wrote there is one
# barrier (§9.2 `QUIESCING`). Two things have to be true on the far side of it:
# the writer this run started is gone, and the state of the working directory it
# left is frozen — because everything from here on is evidence *about* that
# state, and evidence about a workspace that has since moved is not evidence
# about this one (§13.2).
#
# `hzl_timeout` has already waited for the engine on every ordinary path, so
# this is almost always an observation rather than a stop. The case it exists
# for is the engine that outlived its own watchdog: a live writer, and a run
# about to read the files it is still writing.
ORPHANED=""
if [ -n "${HEINZEL_ENGINE_PID:-}" ] && pid_alive "${HEINZEL_ENGINE_PID}"; then
  store_event engine.quiescing "the engine outlived its own wait; stopping it"
  if ! cancel_stop "${HEINZEL_ENGINE_PID}" "${CANCEL_GRACE_SEC}" "${CANCEL_KILL_SEC}" tree; then
    # Not verified, not merged, nothing released. A stop that cannot be
    # confirmed does not go on to write the ledger, and the EXIT trap below
    # keeps the claims and the lease for the same reason (§9.2).
    ORPHANED=1
    store_event run.orphaned \
      "the engine could not be confirmed stopped; the ledger was not written"
    log_event HALT "run ${RUN_ID} is ORPHANED: its engine could not be stopped, so nothing it produced was verified or merged."
    exit 1
  fi
fi
QUIESCE_GEN=$(quiesce_freeze "${STORE_RUN_ID}" "${WS_IDENTITY}" "${WORKDIR}")
if [ -n "${QUIESCE_GEN}" ]; then
  store_event workspace.frozen \
    "generation ${QUIESCE_GEN}, digest $(quiesce_digest "${STORE_RUN_ID}")"
else
  log_event skip "could not freeze the workspace digest for run ${STORE_RUN_ID}"
fi

RESULT="${EXEC_DIR}/result.json"
if [ -r "${RESULT}" ]; then
  VERDICT=$(jq -r '.verdict' "${RESULT}" 2>/dev/null)
  # Read through the schema-aware readers, so a result.json of either version
  # answers. Every gate below still branches on the verdict and only on the
  # verdict: the outcome is recorded, not yet acted on (§13.7).
  ATTEMPT_OUTCOME=$(engine_result_attempt_outcome "${RESULT}")
  ATTEMPT_BACKEND=$(engine_result_backend "${RESULT}")
else
  # No result at all is a failed run for the verdict, which is the compatibility
  # field, and an unknown outcome for the one that means what it says: nothing
  # was collected, so nothing is known about the attempt.
  VERDICT=error
  ATTEMPT_OUTCOME=UNKNOWN
  ATTEMPT_BACKEND=$(runtime_selected)
fi
[ -n "${VERDICT}" ] || VERDICT=error
[ -n "${ATTEMPT_OUTCOME}" ] || ATTEMPT_OUTCOME=UNKNOWN

store_event engine.ended \
  "verdict ${VERDICT}, outcome ${ATTEMPT_OUTCOME}, backend ${ATTEMPT_BACKEND}, exit ${ENGINE_RC}, $((ENDED - STARTED))s"
store_snapshot merging

# --- the merge -------------------------------------------------------------
# Where the run's work becomes visible, and the only place the ledger is
# written. It runs whatever the verdict was: a run killed at the wall clock may
# still have finished its first task, and that is on the worksheet either way.
# Anything the agent did not close goes back to `[ ]` here rather than staying
# claimed by a run that is over.
#
# It goes through `finalize_commit`: the worksheet is parsed into candidates and
# checked for scope, an intent naming them and digesting the ledger they are
# about to be applied to is saved, the transition is applied once under the
# backlog lock, and a receipt digesting the ledger it produced is written
# (§13.4). The transition itself is the same `worksheet_merge` it always was.
# Without a run store there is nowhere to put an intent, so the merge runs on
# its own and says so: the store is not load-bearing, and a run must not lose
# its work because its own bookkeeping failed.
#
# It still takes the backlog lock. What this path loses is the receipt, not the
# guarantee that the ledger has one writer: `finalize_commit` takes the lock
# inside itself, so calling `worksheet_merge` bare here made the fallback the
# one ledger mutation in the program that raced. A `hzl done` typed in the
# second it takes would have been read, rewritten and overwritten by whichever
# of the two wrote last, and the run store failing to be created - which is the
# only way to get here - is exactly the kind of night when nobody is watching
# for it. `with_backlog_lock` and not `lock_with` because this is one ordinary
# mutation, and a refusal to run it should be as loud here as anywhere else.
if [ -n "${STORE_READY}" ]; then
  MERGE_COUNTS=$(finalize_commit "${STORE_RUN_ID}" "${WORKSHEET}" "${BACKLOG}" \
    "${RUN_ID}" "${WORKSHEET_IDS}" "${WS_IDENTITY}")
  MERGE_RC=$?
else
  log_event skip "no run store for ${STORE_RUN_ID}; the ledger commit leaves no receipt"
  MERGE_COUNTS=$(with_backlog_lock worksheet_merge "${WORKSHEET}" "${BACKLOG}" \
    "${RUN_ID}" "${WORKSHEET_IDS}")
  MERGE_RC=$?
fi
MERGED_DONE=$(printf '%s' "${MERGE_COUNTS}" | cut -d' ' -f1)
MERGED_BLOCKED=$(printf '%s' "${MERGE_COUNTS}" | cut -d' ' -f2)
MERGED_NEW=$(printf '%s' "${MERGE_COUNTS}" | cut -d' ' -f3)
MERGED_IGNORED=$(printf '%s' "${MERGE_COUNTS}" | cut -d' ' -f4)
if [ "${MERGE_RC}" -eq 75 ]; then
  log_event skip "the backlog lock was held at merge time; nothing was applied and this run's work is still on ${WORKSHEET}"
elif [ "${MERGE_RC}" -ne 0 ]; then
  log_event skip "the worksheet was unreadable at merge time; nothing was applied"
fi
# Loud, because it is how a prompt that has drifted out of the format shows
# itself: the agent reports work it did and the ledger records none of it.
if [ "${MERGED_IGNORED}" -gt 0 ]; then
  log_event skip "${MERGED_IGNORED} worksheet line(s) ignored (out of scope or unparseable)"
fi
printf 'merge    %s done, %s blocked, %s new, %s ignored\n' \
  "${MERGED_DONE}" "${MERGED_BLOCKED}" "${MERGED_NEW}" "${MERGED_IGNORED}" >>"${RUN_LOG}"
store_event worksheet.merged \
  "${MERGED_DONE} done, ${MERGED_BLOCKED} blocked, ${MERGED_NEW} new, ${MERGED_IGNORED} ignored"

# The run is done with its tasks, so it gives them back: whatever the merge left
# at `[~]` returns to `[ ]` and this run's claims go. Scoped to this run id, so
# a claim held by anything else survives — which is the whole difference between
# this and the blanket pass below it.
if [ -n "${CLAIMS_READY}" ]; then
  printf 'claims   %s marker(s) returned to todo, this run only\n' \
    "$(with_backlog_lock claims_rollback_run "${WS_IDENTITY}" "${BACKLOG}" "${STORE_RUN_ID}")" \
    >>"${RUN_LOG}"
fi
# Belt and braces, and the legacy path: an id the merge never saw, or a `[~]`
# that no claim ever covered, is still marked in progress. Then the ids: new
# tasks arrive without one, and the ledger is not left in a state where a human
# could add one by hand before the next run allocates it. One transaction,
# because a ledger seen between the two has lines nothing can refer to.
finish_ledger() {
  backlog_reset_inprogress "${BACKLOG}" >/dev/null
  [ "${MERGED_NEW}" -gt 0 ] && backlog_assign_ids "${BACKLOG}"
  return 0
}
with_backlog_lock finish_ledger

# Keep the finished worksheet with the rest of the run's record, then take it
# out of the working directory: it is the runner's scaffolding, not the user's
# file. rm -f and rmdir, never rm -r on a path built from configuration. The
# steps the agent wrote for a person go first: the merge has already put them
# beside the ledger, and `rmdir` on a directory that still holds them would
# leave the working directory with a `blocked/` in it.
stash_steps "${EXEC_DIR}"
cp "${WORKSHEET}" "${EXEC_DIR}/worksheet.md" 2>/dev/null
rm -f "${WORKSHEET}"
rmdir "${WS_DIR}" 2>/dev/null

# --- review ----------------------------------------------------------------
# The gate runs before the tally, so work that is rejected is never counted as
# done. Nothing here may cost a task: a reviewer that is absent, broken or slow
# leaves the ledger exactly as the executor left it.

# Move back to `[!]` exactly what this run closed, and print how many. The
# `run:` field on the completion line is what makes that possible: without it a
# reject would roll back other runs' work and lines a human closed by hand.
#
# It prints its count rather than incrementing a variable, because it is called
# inside a command substitution and a variable set there is set in a shell that
# is about to end. One function for both the reject and the revise-to-blocked
# path: they differ by the reason and by nothing else.
review_revert_done() { # reason
  local reason=$1 rid n=0
  while IFS= read -r rid; do
    [ -z "${rid}" ] && continue
    backlog_set_state "${BACKLOG}" "${rid}" "!" \
      "blocked:$(iso_at) reason:${reason} run:${RUN_ID}" && n=$((n + 1))
  done < <(backlog_ids_done_by_run "${BACKLOG}" "${RUN_ID}")
  printf '%s' "${n}"
}

# The follow-up a fix pass that did not settle leaves behind: a line with no id
# yet, and the allocation that gives it one. Both, or a ledger with a task a
# human could collide with by adding an id by hand.
add_review_followup() {
  # Routed to the workspace the review was of. A follow-up on findings in one
  # checkout queued against another is a task the next run cannot even read.
  printf -- '- [ ] %sfollow up on review findings from run %s\n' \
    "$(task_route_prefix "${RUN_WS:-}")" "${RUN_ID}" \
    >>"${BACKLOG}" || return 1
  backlog_assign_ids "${BACKLOG}"
}

REVIEW_VERDICT=disabled
REVIEW_ACTION="review is off"
REVIEW_ENGINE=null
REVIEW_FINDINGS=0
REVIEW_DURATION=0
REVIEW_REVERTED=0
REVIEW_TRUNCATED=false
REVIEW_FIXED=false
REVIEW_DIR="${RUN_DIR}/review-$(date +%H%M%S)"

if [ "${RUN_REVIEWER}" = 1 ]; then
  if [ "${VERDICT}" != ok ]; then
    REVIEW_VERDICT=skipped
    REVIEW_ACTION="the producing role ended with '${VERDICT}', nothing to review"
  else
    "${HEINZEL_ROOT}/bin/hzl-review" "${WORKDIR}" "${SNAP_DIR}" "${RUN_ID}" \
      "${REVIEW_DIR}" "$(backlog_ids_done_by_run "${BACKLOG}" "${RUN_ID}" | tr '\n' ' ')" \
      >>"${RUN_LOG}" 2>&1
    REVIEW_RC=$?
    VERDICT_FILE="${REVIEW_DIR}/verdict.json"
    if [ -r "${VERDICT_FILE}" ]; then
      REVIEW_VERDICT=$(jq -r '.verdict // "failed"' "${VERDICT_FILE}")
      REVIEW_ENGINE=$(jq -c '.engine // null' "${VERDICT_FILE}")
      REVIEW_FINDINGS=$(jq -r '(.findings // []) | length' "${VERDICT_FILE}")
      REVIEW_DURATION=$(jq -r '.duration_sec // 0' "${VERDICT_FILE}")
      REVIEW_TRUNCATED=$(jq -r 'if .truncated then "true" else "false" end' "${VERDICT_FILE}")
      REVIEW_ACTION=$(jq -r '.summary // ""' "${VERDICT_FILE}" | head -1)
    else
      REVIEW_VERDICT=failed
      REVIEW_ACTION="the review produced no verdict"
    fi

    # Is the verdict about this working directory, or about one that has since
    # gone? The reviewer read the tree that was frozen at the quiesce; if
    # something moved it while the review was running — another process, a human
    # editing the checkout, a build left running — then the verdict describes a
    # state that no longer exists (§13.2).
    #
    # Stale evidence is not reused in either direction. Not the approval, which
    # is not evidence that what is there now passes; and not the rejection,
    # which would revert real work on the strength of a reading of something
    # else. The work stands, the ledger is left as the executor left it, and the
    # handover says the review did not conclude — which is the shape of
    # `NEEDS_REVIEW` in a runner that does not have a workflow outcome yet.
    if ! quiesce_unchanged "${STORE_RUN_ID}" "${WORKDIR}"; then
      store_event verification.stale \
        "the workspace moved under the review; verdict '${REVIEW_VERDICT}' not reused"
      log_event skip "the working directory changed while run ${RUN_ID} was being reviewed; the verdict was not applied"
      REVIEW_VERDICT=stale
      REVIEW_ACTION="NOT REVIEWED: the working directory changed while the review was running, so its verdict is about a state that no longer exists"
      REVIEW_RC=stale
    fi

    case ${REVIEW_RC} in
      # Nothing is applied. `REVIEW_ACTION` above is the whole of what happens.
      stale) ;;
      0)
        REVIEW_ACTION="approved: ${REVIEW_ACTION}"
        ;;
      10)
        # note-only by default: record the findings and leave the work alone.
        case ${HEINZEL_REVIEW_ON_REVISE} in
          block)
            REVIEW_REVERTED=$(with_backlog_lock review_revert_done review-revise)
            : "${REVIEW_REVERTED:=0}"
            REVIEW_ACTION="revise, moved ${REVIEW_REVERTED} task(s) back to blocked"
            ;;
          fix-once)
            # Exactly one round trip, never a loop. Re-reviewing against the
            # same snapshot means the second verdict is about the final state
            # of the work, not about the repair in isolation.
            LEFT_NOW=$((EXPIRES - $(now_epoch)))
            if [ "${LEFT_NOW}" -lt 120 ]; then
              REVIEW_ACTION="revise, no time left to fix (${REVIEW_FINDINGS} finding(s) recorded)"
            else
              FIX_DIR="${RUN_DIR}/fix-$(date +%H%M%S)"
              mkdir -p "${FIX_DIR}"
              FINDINGS_TEXT=$(jq -r '.findings[]? | "- \(.severity) \(.file):\(.line) \(.what) - \(.why)"' \
                "${VERDICT_FILE}" 2>/dev/null)
              < "${HEINZEL_ROOT}/prompts/review-fix.md" \
                render '{{WORKDIR}}' "${WORKDIR}" |
                render '{{RUN_ID}}' "${RUN_ID}" |
                render '{{RUN_TIMEOUT_MIN}}' "$((LEFT_NOW / 60))" |
                render '{{FINDINGS}}' "${FINDINGS_TEXT}" >"${FIX_DIR}/prompt.md"
              engine_run "${HEINZEL_EXECUTOR_ENGINE}" fixer "${WORKDIR}" \
                "${FIX_DIR}/prompt.md" "${FIX_DIR}" "${LEFT_NOW}" >>"${RUN_LOG}" 2>&1
              REVIEW_FIXED=true
              # The fixer is a writer, under the same lease, so the barrier runs
              # again and the freeze is retaken. What it left behind is a new
              # state of the working directory, and the re-review is evidence
              # about that one — a new generation, not a second reading of the
              # first (§9.2).
              if [ -n "${HEINZEL_ENGINE_PID:-}" ] && pid_alive "${HEINZEL_ENGINE_PID}"; then
                cancel_stop "${HEINZEL_ENGINE_PID}" "${CANCEL_GRACE_SEC}" \
                  "${CANCEL_KILL_SEC}" tree
              fi
              store_event workspace.frozen \
                "generation $(quiesce_freeze "${STORE_RUN_ID}" "${WS_IDENTITY}" "${WORKDIR}"), after the fix pass"
              REVIEW_DIR2="${RUN_DIR}/review2-$(date +%H%M%S)"
              "${HEINZEL_ROOT}/bin/hzl-review" "${WORKDIR}" "${SNAP_DIR}" "${RUN_ID}" \
                "${REVIEW_DIR2}" "re-review after one fix pass" >>"${RUN_LOG}" 2>&1
              RC2=$?
              if [ -r "${REVIEW_DIR2}/verdict.json" ]; then
                REVIEW_VERDICT=$(jq -r '.verdict // "failed"' "${REVIEW_DIR2}/verdict.json")
                REVIEW_FINDINGS=$(jq -r '(.findings // []) | length' "${REVIEW_DIR2}/verdict.json")
              fi
              if ! quiesce_unchanged "${STORE_RUN_ID}" "${WORKDIR}"; then
                # The same rule as above, one step later: a second verdict about
                # a workspace that moved under it is not reused either.
                store_event verification.stale \
                  "the workspace moved under the re-review; verdict '${REVIEW_VERDICT}' not reused"
                REVIEW_VERDICT=stale
                REVIEW_ACTION="revise, fixed in one pass; NOT REVIEWED: the working directory changed while the re-review was running"
              elif [ "${RC2}" -eq 0 ]; then
                REVIEW_ACTION="revise, fixed in one pass, then approved"
              else
                # Still not right: the work stays done and a follow-up task is
                # added, because a human is better placed to judge the rest.
                with_backlog_lock add_review_followup
                REVIEW_ACTION="revise, one fix pass did not settle it; added a follow-up task"
              fi
            fi
            ;;
          *)
            REVIEW_ACTION="revise (${REVIEW_FINDINGS} finding(s), recorded only): ${REVIEW_ACTION}"
            ;;
        esac
        ;;
      20)
        REVIEW_REVERTED=$(with_backlog_lock review_revert_done review-reject)
        : "${REVIEW_REVERTED:=0}"
        REVIEW_ACTION="rejected, reverted ${REVIEW_REVERTED} task(s): ${REVIEW_ACTION}"
        ;;
      *)
        # Explicitly not a reject. The work stands and the handover says so.
        REVIEW_ACTION="NOT REVIEWED: ${REVIEW_ACTION}"
        ;;
    esac
  fi
fi

# Count what actually changed in the ledger rather than what the agent says it
# did. The two disagree exactly when it matters most. Taken after the gate, so
# rejected work is not counted as done.
DONE_AFTER=$(backlog_count "${BACKLOG}" x)
TASKS_DONE=$((DONE_AFTER - DONE_BEFORE))
[ "${TASKS_DONE}" -lt 0 ] && TASKS_DONE=0
TASKS_BLOCKED=$(ledger_count "${BACKLOG}" "!")

# Session state moves under the same lock as the ledger, and for the same
# reason: `state_update` reads the file, filters it and renames the result over
# the top, so two of them at once is one of them lost — and a completion counted
# in `state.json` but not in the ledger is the same bug either way round.
case ${VERDICT} in
  ok)
    with_backlog_lock state_update ".consecutive_failures = 0 | .runs_completed = (.runs_completed + 1)"
    ;;
  auth)
    # No point retrying every hour against an expired credential.
    with_backlog_lock state_update '.halt_reason = "auth"'
    log_event HALT "authentication failed - fix it, then run 'hzl resume'"
    ;;
  timeout|error)
    with_backlog_lock state_update ".consecutive_failures = (.consecutive_failures + 1)"
    if [ "$(state_get .consecutive_failures 0)" -ge 3 ]; then
      with_backlog_lock state_update '.halt_reason = "consecutive-failures"'
      log_event HALT "three failures in a row - fix the cause, then 'hzl resume'"
    fi
    ;;
esac

# Add to the session total before writing the run record, so the same number is
# never computed in two places.
if [ "${TASKS_DONE}" -gt 0 ]; then
  with_backlog_lock state_update ".tasks_done_total = (.tasks_done_total + ${TASKS_DONE})"
fi

# The handover: what a human reads in the morning instead of the logs.
{
  printf '\n## run %s (%s)\n\n' "${RUN_ID}" "$(iso_at "${STARTED}")"
  printf -- '- result: %s in %ss, %s task(s) done, %s blocked\n' \
    "${VERDICT}" "$((ENDED - STARTED))" "${TASKS_DONE}" "${TASKS_BLOCKED}"
  if [ -r "${EXEC_DIR}/last.txt" ]; then
    sed -n '/=== HEINZEL SUMMARY ===/,$p' "${EXEC_DIR}/last.txt" | sed 's/^/  /'
  fi
  if [ "${MERGED_IGNORED}" -gt 0 ] || [ "${MERGED_NEW}" -gt 0 ]; then
    printf -- '- worksheet: %s new task(s), %s line(s) ignored\n' \
      "${MERGED_NEW}" "${MERGED_IGNORED}"
  fi
  printf -- '- review: %s - %s\n' "${REVIEW_VERDICT}" "${REVIEW_ACTION}"
  if [ "${REVIEW_FINDINGS}" -gt 0 ] && [ -r "${REVIEW_DIR}/verdict.json" ]; then
    jq -r '.findings[]? | "  - \(.severity) \(.file):\(.line) \(.what)"' \
      "${REVIEW_DIR}/verdict.json" 2>/dev/null
  fi
} >>"${NOTES}"

# The run record, v2: every v1 field where it was, plus the schema, the backend
# the attempt ran on and its attempt outcome. `result` keeps its old meaning —
# legacy runner completion — and a new consumer reads the outcome fields
# instead. `workflow_outcome` is not here because there is no workflow to have
# one yet; it arrives with Phase 4 (§13.7).
PLANNER_RESULT_JSON=null
if [ -r "${PLANNER_DIR}/result.json" ]; then
  PLANNER_RESULT_JSON=$(jq -c . "${PLANNER_DIR}/result.json" 2>/dev/null) ||
    PLANNER_RESULT_JSON=null
fi
jq -n -c \
  --argjson schema_version "${HEINZEL_RUN_RECORD_SCHEMA}" \
  --arg backend "${ATTEMPT_BACKEND}" \
  --arg attempt_outcome "${ATTEMPT_OUTCOME}" \
  --arg run_id "${RUN_ID}" --arg trigger "${TRIGGER}" \
  --arg started_at "$(iso_at "${STARTED}")" --argjson started_at_epoch "${STARTED}" \
  --arg ended_at "$(iso_at "${ENDED}")" --argjson duration_sec "$((ENDED - STARTED))" \
  --arg result "${VERDICT}" --argjson exit_code "${ENGINE_RC}" \
  --arg roles "${RUN_ROLES}" \
  --argjson planner_result "${PLANNER_RESULT_JSON}" \
  --argjson tasks_done "${TASKS_DONE}" --argjson tasks_blocked "${TASKS_BLOCKED}" \
  --argjson tasks_done_total "$(state_get .tasks_done_total 0)" \
  --argjson max_tasks_total "${MAX_TOTAL}" \
  --argjson todo_before "${TODO_BEFORE}" \
  --argjson todo_after "$(backlog_count "${BACKLOG}" " ")" \
  --argjson ws_size "$(wc -l <"${WORKSHEET_IDS}" | tr -d ' ')" \
  --argjson ws_done "${MERGED_DONE}" \
  --argjson ws_blocked "${MERGED_BLOCKED}" \
  --argjson ws_new "${MERGED_NEW}" \
  --argjson ws_ignored "${MERGED_IGNORED}" \
  --slurpfile engine_result "${RESULT}" \
  --arg review_verdict "${REVIEW_VERDICT}" \
  --argjson review_engine "${REVIEW_ENGINE}" \
  --arg review_action "${REVIEW_ACTION}" \
  --argjson review_findings "${REVIEW_FINDINGS}" \
  --argjson review_duration "${REVIEW_DURATION}" \
  --argjson review_reverted "${REVIEW_REVERTED}" \
  --argjson review_fixed "${REVIEW_FIXED}" \
  --argjson review_truncated "${REVIEW_TRUNCATED}" \
  --arg log "${RUN_LOG}" \
  '{schema_version: $schema_version,
    run_id: $run_id, trigger: $trigger,
    started_at: $started_at, started_at_epoch: $started_at_epoch,
    ended_at: $ended_at, duration_sec: $duration_sec,
    result: $result, exit_code: $exit_code,
    roles: ($roles | split(",")),
    tasks_done: $tasks_done, tasks_blocked: $tasks_blocked,
    tasks_done_total: $tasks_done_total, max_tasks_total: $max_tasks_total,
    todo_before: $todo_before, todo_after: $todo_after,
    worksheet: {size: $ws_size, done: $ws_done, blocked: $ws_blocked,
                new: $ws_new, ignored: $ws_ignored},
    backend: $backend, attempt_outcome: $attempt_outcome,
    engine: ($engine_result[0].engine // null),
    model: ($engine_result[0].model // null),
    effort: ($engine_result[0].effort // null),
    models_used: ($engine_result[0].models_used // []),
    session_id: ($engine_result[0].session_id // null),
    cost_usd: ($engine_result[0].cost_usd // null),
    turns: ($engine_result[0].turns // 0),
    tokens_in: ($engine_result[0].tokens_in // 0),
    tokens_out: ($engine_result[0].tokens_out // 0),
    planner: (if $planner_result == null then null else {
      engine: ($planner_result.engine // null),
      model: ($planner_result.model // null),
      effort: ($planner_result.effort // null),
      verdict: ($planner_result.verdict // "error"),
      cost_usd: ($planner_result.cost_usd // null),
      tokens_in: ($planner_result.tokens_in // 0),
      tokens_out: ($planner_result.tokens_out // 0),
      duration_sec: ($planner_result.duration_sec // 0)
    } end),
    review: {verdict: $review_verdict, engine: $review_engine,
             action: $review_action, findings: $review_findings,
             duration_sec: $review_duration, reverted: $review_reverted,
             fixed: $review_fixed, truncated: $review_truncated},
    log: $log}' >>"${RUNS_JSONL}" 2>/dev/null

store_event run.ended \
  "${VERDICT} review=${REVIEW_VERDICT} ${TASKS_DONE} done, ${TASKS_BLOCKED} blocked"
store_snapshot ended
STORE_ENDED=1

log_event ok "${RUN_ID} ${VERDICT} review=${REVIEW_VERDICT} ${TASKS_DONE} done, ${TASKS_BLOCKED} blocked, $((ENDED - STARTED))s, total $(state_get .tasks_done_total 0)/${MAX_TOTAL}"

# Housekeeping. Only date-shaped directories are eligible, so a stray directory
# in the log tree is never deleted by a wildcard.
find "${LOG_DIR}" -maxdepth 1 -type d -name '20[0-9][0-9]-[0-1][0-9]-[0-3][0-9]' \
  -mtime "+${LOG_RETENTION_DAYS}" -exec rm -rf {} + 2>/dev/null
# And the same window for the run store, which had no prune at all: one
# directory per run, one run a night, growing for as long as Heinzel is
# installed. Only runs that ended are swept, and never this one — it ended a
# second ago and the age check is what says so (§14.7).
PRUNED=$(runstore_prune "${LOG_RETENTION_DAYS}" | wc -l | tr -d ' ')
case ${PRUNED} in
  ""|0) ;;
  *) log_event ok "pruned ${PRUNED} run store(s) older than ${LOG_RETENTION_DAYS} day(s)" ;;
esac
if [ -f "${RUNS_JSONL}" ]; then
