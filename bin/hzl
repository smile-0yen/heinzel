#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# hzl — Heinzel's interactive command line. The only place privilege is used.
#
# Three public modes combine posture and unattended work (DESIGN 2):
#
#   work     remote posture + session on
#   off      travel posture + session off
#   mobile   travel posture + session on (explicit battery consent)
#
# Everything here assumes a human is present. The unattended lane is bin/hzl-run
# and it never calls into this file.

set -uo pipefail

# bash 3.2 ends a $( ) substitution at the first `)` of a case pattern, so the
# patterns below are written in their parenthesised form. Removing those
# leading parens reintroduces a syntax error only on the stock macOS bash.
HEINZEL_ROOT=$(
  src=${BASH_SOURCE[0]}
  while [ -L "${src}" ]; do
    dir=$(cd -P "$(dirname "${src}")" && pwd)
    src=$(readlink "${src}")
    case ${src} in
      (/*) ;;
      (*) src=${dir}/${src} ;;
    esac
  done
  cd -P "$(dirname "${src}")/.." && pwd
)
export HEINZEL_ROOT

# The same three directories bin/hzl-run appends, and for a related reason.
# There it is launchd handing over a minimal environment; here it is that `hzl`
# can be reached from any shell at all - an ssh command line, a GUI terminal, a
# cron entry, something that sourced only .zshenv - and the engine it looks for
# usually lives in ~/.local/bin. The runner hardened this and the CLI did not,
# so `hzl doctor` could report an engine as missing that the 03:00 run would
# then find perfectly well. Disagreeing about that is worse than either answer.
export PATH="${PATH}:/usr/local/bin:/opt/homebrew/bin:${HOME}/.local/bin"

# shellcheck source=lib/common.sh
. "${HEINZEL_ROOT}/lib/common.sh"
# shellcheck source=lib/posture.sh
. "${HEINZEL_ROOT}/lib/posture.sh"
# The registry, for one reason only: a live-mode command records the session's runtime
# backend in state.json, and a name the registry does not know has to be refused
# here rather than at 03:00, when the run that reads it aborts and nobody is
# awake to see why (DESIGN principle 6).
# shellcheck source=lib/runtimes.sh
. "${HEINZEL_ROOT}/lib/runtimes.sh"
# The workspace identity, which the lock file names need, and the short backlog
# lock. A human typing `hzl done` and a run merging its worksheet are two
# writers of one ledger, and this is the side of that pair that used to write
# with nothing held at all.
# shellcheck source=lib/claims.sh
. "${HEINZEL_ROOT}/lib/claims.sh"
# shellcheck source=lib/locks.sh
. "${HEINZEL_ROOT}/lib/locks.sh"
# `hzl off` has to find the runs it owns, write a durable cancel intent for each
# and settle their snapshots once they have stopped, so the interactive side
# needs the store and the barrier that reads it (RUNTIME-BACKENDS §14.4).
# shellcheck source=lib/watchdog.sh
. "${HEINZEL_ROOT}/lib/watchdog.sh"
# shellcheck source=lib/runstore.sh
. "${HEINZEL_ROOT}/lib/runstore.sh"
# shellcheck source=lib/cancel.sh
. "${HEINZEL_ROOT}/lib/cancel.sh"

RUNNER="${HEINZEL_ROOT}/bin/hzl-run"
PLIST_DIR="${HOME}/Library/LaunchAgents"

# Running any of this under sudo leaves state.json owned by root at 0600, after
# which every unprivileged run fails to read it. The privileged subcommands
# escalate internally instead; that is why this check has no exceptions.
require_not_root() {
  if [ "$(id -u)" -eq 0 ]; then
    err "do not run hzl with sudo."
    err "it escalates by itself where it needs to; running the whole tool as root"
    err "would leave ${STATE_FILE} owned by root and unreadable afterwards."
    exit 1
  fi
}

plist_path() { printf '%s/%s.plist' "${PLIST_DIR}" "${HEINZEL_LABEL}"; }

# --- status ----------------------------------------------------------------

# Read the last run record. A line torn by a concurrent append must not be
# handed to --argjson: jq would print its parse error to stdout and still exit
# 0, so a broken record would look like a successful status.
last_run_json() {
  local line
  [ -r "${RUNS_JSONL}" ] || { printf 'null'; return; }
  line=$(tail -1 "${RUNS_JSONL}" 2>/dev/null)
  if [ -n "${line}" ] && printf '%s' "${line}" | jq -e . >/dev/null 2>&1; then
    printf '%s' "${line}"
  else
    printf 'null'
  fi
}

budget_line() {
  local done_n total
  done_n=$(state_get .tasks_done_total 0)
  total=$(state_get .max_tasks_total 0)
  printf '%s/%s tasks this session' "${done_n}" "${total}"
}

# Where the work is, according to whichever source is entitled to say so.
#
# A live session owns its paths: `hzl work --backlog X` is a promise for that
# session, and the runner must not be moved out from under it by an edit to
# `heinzel.conf` at 02:00. Outside a session nothing owns them but the
# configuration file — and `state.json` keeps a finished session's paths, so
# reading them unconditionally means an edited `heinzel.conf` is ignored with
# no sign that it was, until the next live-mode command. `hzl install` then bakes the
# stale paths into the agent's permission file, which is the version of this
# that matters: the deny list ends up naming a backlog nobody uses.
#
# A live-mode command writes state before it calls `cmd_install`, so a session's own
# paths are still what gets baked in. That order is load-bearing.
session_path() {
  local key=$1 fallback=$2 v
  if [ "$(effective_mode)" = heinzel ]; then
    v=$(state_get "${key}" "")
    if [ -n "${v}" ]; then printf '%s' "${v}"; return 0; fi
  fi
  printf '%s' "${fallback}"
}
cur_workdir() { session_path .workdir "$(workdir_default)"; }
cur_backlog() { session_path .backlog "${DEFAULT_BACKLOG}"; }

# Every workspace this session may work in, one absolute path per line, in the
# order that makes the first one the default.
#
# A live session owns its list for the same reason it owns its paths: `hzl work
# --workdir X` is a promise for that session, and an edit to `heinzel.conf` at
# 02:00 must not add a checkout to a session that was started without it.
cur_workdirs() {
  local v
  if [ "$(effective_mode)" = heinzel ]; then
    v=$(state_get_workdirs)
    if [ -n "${v}" ]; then printf '%s\n' "${v}"; return 0; fi
  fi
  workdirs_list
}

cmd_status() {
  local json=0 quiet=0 mode operating_mode rc
  while [ $# -gt 0 ]; do
    case $1 in
      --json) json=1 ;;
      --quiet) quiet=1 ;;
      *) die "status: unknown option $1" ;;
    esac
    shift
  done

  hzl_eval_mode
  mode=${HZ_MODE}
  if [ "${mode}" = heinzel ]; then
    operating_mode=$(session_operating_mode)
    rc=10
  else
    operating_mode=off
    rc=0
  fi

  if [ "${json}" = 1 ]; then
    # Reported, never repaired: a v1 file reads as v1 here and stays a v1 file.
    # `status` is the command a script runs in a loop, and the one command that
    # must be safe to run against a state file written by another build.
    local schema backend="" nxt next_run=""
    schema=$(state_schema_json)
    [ -r "${STATE_FILE}" ] && backend=$(state_runtime_backend)
    # The next slot, whether or not a session is live: a script asking when the
    # machine next wakes is asking about the schedule, and the schedule does
    # not depend on the session.
    nxt=$(next_slot_epoch) && next_run=$(iso_at "${nxt}")
    jq -n \
      --arg mode "${operating_mode}" \
      --argjson schema_version "${schema}" \
      --arg runtime_backend "${backend}" \
      --arg reason "${HZ_REASON}" \
      --arg posture "$(posture_now)" \
      --arg sleep_disabled "$(sleep_disabled)" \
      --arg backlog "$(state_get .backlog "")" \
      --argjson last_run "$(last_run_json)" \
      --argjson tasks_done "$(state_get .tasks_done_total 0)" \
      --argjson max_total "$(state_get .max_tasks_total 0)" \
      --arg expires_at "$(state_get .expires_at "")" \
      --arg next_run "${next_run}" \
      --arg halt "$(state_get .halt_reason "")" \
      '{mode: $mode, reason: $reason, posture: $posture,
        schema_version: $schema_version,
        runtime_backend: (if $runtime_backend == "" then null else $runtime_backend end),
        sleep_disabled: $sleep_disabled, backlog: $backlog,
        tasks_done_total: $tasks_done, max_tasks_total: $max_total,
        expires_at: $expires_at, halt_reason: (if $halt == "" then null else $halt end),
        next_run: (if $next_run == "" then null else $next_run end),
        last_run: $last_run}'
    return ${rc}
  fi

  [ "${quiet}" = 1 ] && return ${rc}

  local backlog todo blocked posture ss
  backlog=$(cur_backlog)
  posture=$(posture_now)

  printf '\n'
  if [ "${mode}" = heinzel ]; then
    field "mode" "$(good "${operating_mode}") (expires $(short_at "$(state_get .expires_at_epoch 0)"))"
    field "budget" "$(budget_line)"
    field "workdir" "$(workdirs_display "$(cur_workdirs)")"
  else
    field "mode" "off - ${HZ_REASON}"
  fi

  # The other half of "is this doing the right thing". A session that is on
  # says nothing about when the next run starts, and `HEINZEL_HOURS` is the
  # shape of the schedule rather than a time - so the question was answerable
  # only by reading a config file and doing the arithmetic by hand. One line
  # here; `hzl schedule` is the whole picture.
  local nxt exp_at when
  if nxt=$(next_slot_epoch); then
    when="$(short_at "${nxt}") ($(rel_dur $((nxt - $(now_epoch)))))"
    exp_at=$(state_get .expires_at_epoch 0)
    if [ "${mode}" != heinzel ]; then
      field "next run" "${when} - nothing runs until 'hzl work' or 'hzl mobile'"
    elif [ "${exp_at}" -gt 0 ] &&
         [ $((exp_at - nxt)) -lt "$(state_get .run_timeout_sec "${DEFAULT_RUN_TIMEOUT}")" ]; then
      # Both shapes of the same miss: the slot falls after the session ends, or
      # it falls inside it with less than one wall clock to spare, which the
      # runner refuses just as flatly. `hzl schedule` says which.
      field "next run" "${when} - $(bad "too little session left to run")"
    else
      field "next run" "${when}"
    fi
  fi

  case ${posture} in
    travel) field "posture" "travel (closed up)" ;;
    remote) field "posture" "remote (open)" ;;
    mixed)  field "posture" "$(bad "mixed") - run 'hzl doctor' to see which part disagrees" ;;
    *)      field "posture" "not managed (HEINZEL_POSTURE=0)" ;;
  esac

  ss=$(posture_vnc_listening)
  field "screen sharing" "$([ "${ss}" = yes ] && echo "on (5900 listening)" || echo off)"
  field "sleep suppressed" "$([ "$(sleep_disabled)" = 1 ] && echo "yes (disablesleep=1)" || echo no)"
  field "power" "$(on_ac_power && echo "AC" || echo "battery $(battery_pct)")"

  # All four markers, always, even at zero. Three of them was not a shorter
  # version of the same line: `[~]` is a state a task sits in for as long as a
  # run holds it, so leaving it out meant a task the runner had just claimed
  # left `todo` without arriving anywhere. A live-mode command prints this block and
  # launchd starts the run a minute later, which is exactly long enough for
  # "3 todo" and a `next` that finds nothing to look like a contradiction.
  # The counts partition the ledger; that is the property worth reading.
  if [ -n "${backlog}" ] && [ -r "${backlog}" ]; then
    field "backlog" "$(backlog_count "${backlog}" " ") todo / $(backlog_count "${backlog}" "~") in progress / $(ledger_count "${backlog}" "!") blocked / $(backlog_count "${backlog}" x) done"
  else
    field "backlog" "not readable (${backlog:-unset})"
  fi

  local halt
  halt=$(state_get .halt_reason "")
  if [ -n "${halt}" ] && [ "${halt}" != null ]; then
    field "halted" "$(bad "${halt}") - clear it with 'hzl resume'"
  fi

  local lr
  lr=$(last_run_json)
  if [ "${lr}" != null ]; then
    field "last run" "$(printf '%s' "${lr}" | jq -r '"\(.run_id) \(.result) - \(.tasks_done) done, \(.tasks_blocked) blocked"')"
  fi

  # Drift: expiry stops runs by itself, but restoring pmset needs sudo, so the
  # setting outlives the session and only a human can put it back.
  if [ "${mode}" != heinzel ] && [ "$(sleep_disabled)" = 1 ]; then
    printf '\n'
    warn "sleep is still suppressed while no session is running - run 'hzl off' to restore it"
  fi
  printf '\n'
  return ${rc}
}

# --- live modes: work and mobile ------------------------------------------

session_start() {
  local operating_mode=$1
  shift
  require_not_root
  local duration=${DEFAULT_DURATION} max_tasks=${DEFAULT_MAX_TASKS}
  local max_total=${DEFAULT_MAX_TASKS_TOTAL} timeout=${DEFAULT_RUN_TIMEOUT}
  local backlog=${DEFAULT_BACKLOG} workdir="" wanted=""
  local use_sudo=1 force=0 kick=1 dry=0 confirmed=0

  case ${operating_mode} in
    work|mobile) ;;
    *) die "internal error: cannot start mode '${operating_mode}'" ;;
  esac

  while [ $# -gt 0 ]; do
    case $1 in
      --duration) duration=${2:-}; shift ;;
      --max-tasks) max_tasks=${2:-}; shift ;;
      --max-total) max_total=${2:-}; shift ;;
      --timeout) timeout=${2:-}; shift ;;
      --backlog) backlog=${2:-}; shift ;;
      # Repeatable: each occurrence adds one workspace, and the first given
      # is the session's default. Given none, the session gets every workspace
      # `DEFAULT_WORKDIR` lists, which is what a configuration with one
      # workspace has always meant.
      --workdir) wanted="${wanted}${2:-}
"; shift ;;
      --no-sudo) use_sudo=0 ;;
      --force) force=1 ;;
      --yes)
        [ "${operating_mode}" = mobile ] || die "work: unknown option --yes"
        confirmed=1 ;;
      --no-kick) kick=0 ;;
      --dry-run) dry=1 ;;
      *) die "${operating_mode}: unknown option $1" ;;
    esac
    shift
  done

  # 1. Arguments, fail fast and before anything is changed.
  local dur_sec
  dur_sec=$(parse_duration "${duration}") ||
    die "--duration '${duration}' is not a duration in [60s, 24h]"
  case ${max_tasks} in ""|*[!0-9]*) die "--max-tasks must be a positive integer" ;; esac
  case ${max_total} in ""|*[!0-9]*) die "--max-total must be a positive integer" ;; esac
  case ${timeout} in ""|*[!0-9]*) die "--timeout must be a positive integer" ;; esac
  [ "${max_tasks}" -ge 1 ] || die "--max-tasks must be >= 1"
  [ "${max_total}" -ge 1 ] || die "--max-total must be >= 1"
  [ "${timeout}" -ge 60 ] || die "--timeout must be >= 60"

  [ -n "${DEFAULT_WORKDIR}" ] || die "no workdir configured. Set DEFAULT_WORKDIR in etc/heinzel.conf"
  [ -n "${backlog}" ] || die "no backlog configured. Set DEFAULT_BACKLOG in etc/heinzel.conf or pass --backlog"
  backlog=$(abspath "${backlog}")

  # A `--workdir` must name a workspace this installation is configured for -
  # by its name (`heinzel`) or by its path - and is refused otherwise rather
  # than accepted and worked in. An arbitrary path used to be accepted here and
  # was the sharpest edge in the tool: the agent's permission file is generated
  # by `hzl install` from `DEFAULT_WORKDIR`, so a session pointed somewhere else
  # started, ran, and had every write refused by rules naming a tree it was no
  # longer in. Refusing here is what makes live modes and the installed rules
  # incapable of disagreeing.
  local one resolved configured
  configured=$(abspath_lines "$(workdirs_list)")
  if [ -n "${wanted}" ]; then
    while IFS= read -r one; do
      [ -n "${one}" ] || continue
      # By name first, because that is what a person types and what a task
      # writes. A path is accepted too, and has to be one of the configured
      # ones after `abspath`, so `--workdir .` from inside a checkout works.
      resolved=$(workdir_of_name "${one}") || resolved=$(abspath "${one}")
      resolved=$(abspath "${resolved}")
      if ! printf '%s\n' "${configured}" | grep -qxF -- "${resolved}"; then
        err "--workdir ${one}: not a configured workspace"
        err "configured: $(workdir_names | tr '\n' ' ' | sed 's/ $//')"
        err "add it to DEFAULT_WORKDIR in etc/heinzel.conf, then run 'hzl install'"
        exit 1
      fi
      workdir="${workdir}${resolved}
"
    done <<EOF
${wanted}
EOF
  else
    workdir=${configured}
  fi
  workdir=$(printf '%s\n' "${workdir}" | grep -v '^$')
  [ -n "${workdir}" ] || die "no workdir resolved - set DEFAULT_WORKDIR in etc/heinzel.conf"

  # Every one of them, not just the first. A workspace that does not exist, or
  # one pointed at Heinzel's own state, is a run that goes wrong on whichever
  # night a task happens to name it - which is a worse time to find out.
  #
  # ~/.heinzel is denied to the agent wholesale, on purpose: it holds
  # state.json, the lock, and the logs. Pointing a working directory at it
  # produces a run where every write is refused - and the failure reads as an
  # agent that could not manage the task, not as a configuration mistake.
  while IFS= read -r one; do
    [ -d "${one}" ] || die "workdir does not exist: ${one}"
    case ${one} in
      "${HEINZEL_HOME}"|"${HEINZEL_HOME}"/*)
        err "workdir is inside ${HEINZEL_HOME}, which the agent is denied entirely."
        err "that directory is Heinzel's own state; an agent working there can write nothing."
        err "point DEFAULT_WORKDIR at the code you want worked on."
        exit 1 ;;
    esac
  done <<EOF
${workdir}
EOF

  if [ "${timeout}" -gt 3600 ]; then
    warn "a run may use up to ${timeout}s, which is longer than the gap between slots;"
    warn "a run that uses its whole budget will cost the next slot"
  fi

  # The session's runtime backend is recorded, so a run reads it from the
  # session that promised it rather than from whatever the environment happens
  # to say at 03:00. A key the registry does not know stops the session here.
  local runtime_backend=${HEINZEL_RUNTIME:-local}
  runtime_known "${runtime_backend}" ||
    die "HEINZEL_RUNTIME names no runtime backend this build has: '${runtime_backend}' (have: $(runtime_backends | tr '\n' ' ' | sed 's/ *$//'))"

  # Mobile is the exceptional choice: it keeps scheduled runs eligible on
  # battery. The warning is unconditional because a machine plugged in now
  # may be unplugged after this command returns.
  if [ "${operating_mode}" = mobile ]; then
    warn "mobile mode lets scheduled runs continue on battery and may drain it while travelling."
    if [ "${dry}" = 0 ] && [ "${confirmed}" != 1 ]; then
      if [ ! -t 0 ]; then
        die "mobile: confirmation required; re-run with --yes"
      fi
      printf 'Continue with mobile mode? [y/N] ' >&2
      local answer=""
      IFS= read -r answer
      case ${answer} in y|Y|yes|YES|Yes) ;; *) die "mobile mode cancelled" ;; esac
    fi
  fi

  # Work keeps the old battery rule. Mobile is itself the explicit consent,
  # and the runner reads the recorded mode so later scheduled runs agree.
  if [ "${operating_mode}" = work ] && ! on_ac_power; then
    if [ "${force}" = 1 ]; then
      warn "on battery ($(battery_pct)), continuing because --force was given"
      warn "scheduled runs will still skip while on battery; 'hzl run-now' will not"
    else
      die "on battery ($(battery_pct)). Plug in, or pass --force"
    fi
  fi

  # Switching between live modes is a real stop/start transition. The old
  # session is stopped below, after dry-run has had its early return.
  if [ "$(state_get .mode normal)" = heinzel ]; then
    warn "a session is already configured - it will be stopped before entering ${operating_mode} mode"
    warn "tasks completed so far ($(state_get .tasks_done_total 0)) will be reset to 0"
  fi

  local now expires slots
  now=$(now_epoch)
  expires=$((now + dur_sec))
  slots=$(slots_within "${expires}")
  [ "${slots}" -eq 0 ] &&
    warn "no scheduled slot falls before this session expires - nothing will run (hours: $(hours_display))"

  # 5. Backlog.
  backlog_ensure "${backlog}" || die "could not create ${backlog}"
  local todo
  todo=$(backlog_count "${backlog}" " ")
  [ "${todo}" -eq 0 ] && warn "the backlog has no todo items - runs will do nothing"

  if [ "${dry}" = 1 ]; then
    # The same transition the real path takes, with the dry-run flag set: what
    # this prints is the list of privileged commands, not a description of them.
    case ${operating_mode} in
      work) mode_apply_posture remote 1 || return 1 ;;
      mobile) mode_apply_posture travel 1 || return 1 ;;
    esac
    printf '\n'
    say "would enter ${operating_mode} mode:"
    field "mode" "${operating_mode}"
    field "expires" "$(short_at "${expires}") (${duration})"
    field "budget" "${max_total} tasks total, ${max_tasks} per run, ${timeout}s wall clock"
    field "workdir" "$(workdirs_display "${workdir}")"
    field "backlog" "${backlog} (${todo} todo)"
    field "slots before expiry" "${slots} (hours: $(hours_display))"
    field "would sudo" "$([ "${use_sudo}" = 1 ] && echo "pmset -a disablesleep 1" || echo "no (--no-sudo)")"
    printf '\n'
    return 0
  fi

  # A live mode owns both sides of the transition. Stop any prior session
  # before changing posture so work -> mobile cannot strand a runner behind a
  # newly closed firewall, and mobile -> work cannot reset a live budget.
  if [ "$(state_get .mode normal)" = heinzel ]; then
    local stop_rc=0
    session_stop || stop_rc=$?
    [ "${stop_rc}" -eq 0 ] || return "${stop_rc}"
  fi

  case ${operating_mode} in
    work) mode_apply_posture remote 0 || return 1 ;;
    mobile) mode_apply_posture travel 0 || return 1 ;;
  esac

  # 6. The liveness marker. Started before the privileged step so that a
  # cancelled password prompt has something to roll back to. No -d: the lid is
  # expected to be closed, and keeping the display awake would waste power.
  mkdir -p "${HEINZEL_HOME}" "${LOG_DIR}" || die "could not create ${HEINZEL_HOME}"
  chmod 700 "${HEINZEL_HOME}"
  local caff_pid
  nohup caffeinate -is >/dev/null 2>&1 &
  caff_pid=$!
  sleep 1
  pid_alive "${caff_pid}" || die "caffeinate failed to start"
  printf '%s' "${caff_pid}" >"${CAFFEINATE_PID_FILE}"

  # 7. The only privileged thing a session does. caffeinate alone cannot keep
  # the machine awake with the lid closed; disablesleep is what does that, and
  # it is undocumented, so the value is read back rather than assumed.
  local prior_disablesleep
  prior_disablesleep=$(sleep_disabled)
  if [ "${use_sudo}" = 1 ]; then
    say "keeping the machine awake with the lid closed needs one privileged step."
    if ! sudo pmset -a disablesleep 1; then
      kill "${caff_pid}" 2>/dev/null
      rm -f "${CAFFEINATE_PID_FILE}"
      die "authentication cancelled - nothing was changed"
    fi
    if [ "$(sleep_disabled)" != 1 ]; then
      warn "disablesleep did not read back as 1; this macOS build may ignore it."
      warn "closing the lid may still put the machine to sleep."
    fi
  else
    warn "--no-sudo: sleep is not suppressed. Leave the lid open."
  fi

  # 8. Close the write-capable sudo window for the duration (DESIGN 4.3).
  # Nothing in this build installs `heinzel-ticket`; the posture transition
  # above removes one an older build left behind. A ticket already granted
  # outlives the file it came from, so the outstanding timestamps go too. The
  # removal is repeated rather than assumed: it is a no-op when the file is
  # absent, it also runs with posture management on but no transition to make,
  # and this is the step the guarantee is written against.
  local ticket_suspended=false
  if [ "${HEINZEL_POSTURE}" = 1 ]; then
    if posture_remove_sudoers ticket && posture_purge_tickets; then
      ticket_suspended=true
      say "the relaxed sudo ticket window is closed for the duration of this session"
    fi
  fi

  # 9. State. Written last, so anything above failing leaves no session behind.
  local state
  state=$(jq -n \
    --argjson schema_version "${HEINZEL_STATE_SCHEMA}" \
    --arg runtime_backend "${runtime_backend}" \
    --arg operating_mode "${operating_mode}" \
    --arg activated_at "$(iso_at "${now}")" \
    --argjson activated_at_epoch "${now}" \
    --arg expires_at "$(iso_at "${expires}")" \
    --argjson expires_at_epoch "${expires}" \
    --arg duration "${duration}" \
    --arg boot_id "$(boot_id_now)" \
    --arg workdir "$(printf '%s\n' "${workdir}" | head -1)" \
    --argjson workdirs "$(printf '%s\n' "${workdir}" | jq -R . | jq -s .)" \
    --arg backlog "${backlog}" \
    --argjson max_tasks_per_run "${max_tasks}" \
    --argjson max_tasks_total "${max_total}" \
    --argjson run_timeout_sec "${timeout}" \
    --arg hours "$(hours_normalised)" \
    --argjson caffeinate_pid "${caff_pid}" \
    --arg prior_disablesleep "${prior_disablesleep}" \
    --argjson sudo_used "$([ "${use_sudo}" = 1 ] && echo true || echo false)" \
    --argjson ticket_suspended "${ticket_suspended}" \
    '{schema_version: $schema_version, runtime_backend: $runtime_backend,
      mode: "heinzel", operating_mode: $operating_mode,
      activated_at: $activated_at, activated_at_epoch: $activated_at_epoch,
      expires_at: $expires_at, expires_at_epoch: $expires_at_epoch,
      duration: $duration, boot_id: $boot_id,
      workdir: $workdir, workdirs: $workdirs, backlog: $backlog,
      max_tasks_per_run: $max_tasks_per_run, max_tasks_total: $max_tasks_total,
      tasks_done_total: 0, run_timeout_sec: $run_timeout_sec,
      hours: $hours, caffeinate_pid: $caffeinate_pid,
      pmset_restore: {disablesleep: $prior_disablesleep},
      sudo_used: $sudo_used, ticket_suspended: $ticket_suspended,
      halt_reason: null, consecutive_failures: 0, runs_completed: 0}')

  # Under the lock like every other session mutation: this one replaces the file
  # wholesale, so an update landing between the compose above and the rename
  # would be written over rather than merged with.
  if ! with_backlog_lock state_write "${state}"; then
    kill "${caff_pid}" 2>/dev/null
    rm -f "${CAFFEINATE_PID_FILE}"
    [ "${use_sudo}" = 1 ] && sudo pmset -a disablesleep 0
    die "could not write ${STATE_FILE} - rolled back"
  fi

  # 10. Schedule.
  cmd_install --quiet
  if [ "${kick}" = 1 ]; then
    launchctl kickstart "gui/$(id -u)/${HEINZEL_LABEL}" >/dev/null 2>&1 ||
      warn "could not kickstart the agent; it will still fire on schedule"
  fi

  log_event ok "mode=${operating_mode} until $(iso_at "${expires}") budget=${max_total} workdir=$(oneline "${workdir}")"
  local status_rc=0
  cmd_status || status_rc=$?
  # A live status exits 10 for scripts; successfully entering a mode exits 0.
  [ "${status_rc}" -eq 10 ] && status_rc=0
  return "${status_rc}"
}

# --- session: off ----------------------------------------------------------

# Every run under this HEINZEL_HOME that has not ended: what `off` owns and has
# to stop (§14.4). A run whose snapshot cannot be read is not listed — there is
# nothing to stop it *by* — and `runstore_runner_state` is what is asked rather
# than the snapshot's own word, so a run that says `running` and has no process
# behind it is already settled and not signalled again.
off_active_runs() {
  local r s
  while IFS= read -r r; do
    [ -n "${r}" ] || continue
    s=$(runstore_runner_state "${r}" 2>/dev/null)
    case ${s} in
      queued|running|merging|cancelling) printf '%s\n' "${r}" ;;
    esac
  done <<EOF
$(runstore_runs)
EOF
}

# Give back what a stopped run was holding. Only called once the process has
# been observed gone: a run killed outright never ran its own EXIT trap, so this
# is the only thing that will release its claims and its writer lease, and
# calling it any earlier would hand the checkout to the next run while a writer
# was still in it (§14.3, invariant 14).
# The backlog is passed in rather than read here, and the workdir comes from the
# run's own snapshot. `cur_backlog` and `cur_workdir` answer only while a session
# is live, and step 1 of `off` has already set the mode to `normal` by the time
# anything is released — so asking them here would return the compiled-in
# default, and the rollback would quietly move no markers at all.
off_release() { # run-id backlog
  local r=$1 b=$2 wd ident n=0
  wd=$(runstore_read "${r}" 2>/dev/null | jq -r '.workdir // empty' 2>/dev/null)
  [ -n "${wd}" ] || wd=$(state_get .workdir "${DEFAULT_WORKDIR}")
  ident=$(claims_workspace_identity "${wd}" 2>/dev/null)
  if [ -n "${ident}" ]; then
    n=$(with_backlog_lock claims_rollback_run "${ident}" "${b}" "${r}")
    : "${n:=0}"
    lease_release "${ident}" "${r}" >/dev/null 2>&1
  fi
  runstore_event "${r}" run.cancelled \
    "stopped by 'hzl off'; ${n} marker(s) returned to todo" 2>/dev/null
  runstore_set_state "${r}" cancelled >/dev/null 2>&1
  [ "${n}" -gt 0 ] && say "  returned ${n} task(s) to todo"
  return 0
}

# The other answer, and the one this whole barrier exists to be able to give.
# `ORPHANED` is not a failure and not a success: it is a stop nothing could
# confirm, so ownership is kept, no new writer is started, and a human is told
# in words rather than by an exit code alone (§9.2, §14.4).
off_orphan() { # run-id why
  local r=$1 why=$2
  runstore_event "${r}" run.orphaned "${why}; claims and the writer lease are kept" 2>/dev/null
  runstore_set_state "${r}" orphaned >/dev/null 2>&1
  bad "run ${r} could not be confirmed stopped (${why})."
  err "it is ORPHANED: its task claims and its writer lease are kept, so no new"
  err "run will touch that checkout until you have looked at it."
  log_event HALT "run ${r} is ORPHANED after 'hzl off': ${why}"
}

session_stop() {
  require_not_root
  local unload=0 use_sudo=1
  while [ $# -gt 0 ]; do
    case $1 in
      --unload) unload=1 ;;
      --no-sudo) use_sudo=0 ;;
      *) die "off: unknown option $1" ;;
    esac
    shift
  done

  local was_on started done_n runs backlog
  was_on=$(effective_mode)
  started=$(state_get .activated_at_epoch 0)
  done_n=$(state_get .tasks_done_total 0)
  runs=$(state_get .runs_completed 0)
  # Read while the session is still live. Everything below runs after the mode
  # has been set to `normal`, and `cur_backlog` answers with the compiled-in
  # default from that moment on.
  backlog=$(cur_backlog)

  # 1. First, so that any run starting from here on no-ops. Everything else is
  # cleanup and can fail without leaving a session that still fires.
  if [ -f "${STATE_FILE}" ]; then
    with_backlog_lock state_update '.mode = "normal"' ||
      warn "could not update ${STATE_FILE}"
  fi

  # 2. Stop the runs in flight, and do not report a stop that did not happen.
  #
  # The order is fixed by §14.4: new dispatch stops first (step 1 above), then a
  # durable cancel intent goes down for every run this HEINZEL_HOME owns, then
  # the barrier, and only after the barrier confirms the process is gone are the
  # claims and the writer lease released. The intent is written before anything
  # is signalled because `hzl off` can be interrupted too: without it, a stop
  # requested and never completed is indistinguishable afterwards from a run
  # that fell over for no reason.
  local orphaned=0 r rp
  while IFS= read -r r; do
    [ -n "${r}" ] || continue
    rp=$(runstore_read "${r}" 2>/dev/null | jq -r '.pid // empty' 2>/dev/null)
    cancel_request "${r}" off "${rp:-0}" >/dev/null 2>&1 ||
      warn "could not record the cancel intent for run ${r}"
    runstore_set_state "${r}" cancelling >/dev/null 2>&1
    if pid_alive "${rp}"; then
      say "stopping run ${r} (pid ${rp})"
      if ! cancel_stop "${rp}" "${CANCEL_RUNNER_GRACE_SEC}" "${CANCEL_KILL_SEC}"; then
        off_orphan "${r}" "the runner did not stop"
        orphaned=$((orphaned + 1))
        continue
      fi
    fi
    cancel_confirm "${r}" "the runner process is gone" >/dev/null 2>&1
    off_release "${r}" "${backlog}"
  done <<EOF
$(off_active_runs)
EOF

  # The run with no store. Creating one is allowed to fail and the run happens
  # anyway, so `run.pid` is still the only handle on such a run. Nothing durable
  # can be recorded for it — there is no store to record it in — but it is
  # stopped by the same barrier and confirmed the same way. A run that was
  # handled above is already gone by now, so this is a no-op for it.
  if [ -r "${RUN_PID_FILE}" ]; then
    rp=$(cat "${RUN_PID_FILE}" 2>/dev/null)
    if pid_alive "${rp}"; then
      say "stopping the run in progress (pid ${rp})"
      if ! cancel_stop "${rp}" "${CANCEL_RUNNER_GRACE_SEC}" "${CANCEL_KILL_SEC}"; then
        bad "the run at pid ${rp} could not be confirmed stopped."
        err "it is ORPHANED: whatever it was holding is still held."
        log_event HALT "'hzl off' could not stop the run at pid ${rp}"
        orphaned=$((orphaned + 1))
      fi
    fi
  fi

  # 3. Always restore 0, never the recorded prior value. Honouring the recorded
  # value compounds one missed `off` into permanent sleep suppression: the
  # leaked 1 becomes the next session's baseline (DESIGN 4.2).
  if [ "${use_sudo}" = 1 ] && [ "$(sleep_disabled)" = 1 ]; then
    sudo pmset -a disablesleep 0 || warn "could not restore disablesleep - it is still 1"
  fi

  # 4. The liveness marker.
  if [ -r "${CAFFEINATE_PID_FILE}" ]; then
    local cp
    cp=$(cat "${CAFFEINATE_PID_FILE}" 2>/dev/null)
    pid_alive "${cp}" && kill "${cp}" 2>/dev/null
    rm -f "${CAFFEINATE_PID_FILE}"
  fi

  [ "${unload}" = 1 ] && cmd_uninstall --quiet

  printf '\n'
  if [ "${was_on}" = heinzel ] && [ "${started}" -gt 0 ]; then
    local secs
    secs=$(( $(now_epoch) - started ))
    field "session ran for" "$((secs / 3600))h $(((secs % 3600) / 60))m"
    field "runs completed" "${runs}"
    field "tasks done" "${done_n}"
  else
    say "no session was running; cleaned up anyway."
  fi
  # The one read at the top, not a fresh one: the session is `normal` by now and
  # `cur_backlog` would answer with the compiled-in default, so this line has
  # been counting the wrong file — usually no file at all — since the mode
  # started being flipped first.
  if [ -n "${backlog}" ] && [ -r "${backlog}" ]; then
    field "blocked, needs you" "$(ledger_count "${backlog}" "!")"
  fi
  local notes today
  today=$(date +%Y-%m-%d)
  notes="${LOG_DIR}/${today}/notes.md"
  [ -r "${notes}" ] && field "handover notes" "${notes}"
  printf '\n'

  # Setting the mode to `normal` is not the same statement as "it has stopped",
  # and this is where the two stop being reported as one (§14.4). The session is
  # off either way and no new run will start; what a non-zero exit says is that
  # something is still holding a checkout and nobody watched it let go.
  if [ "${orphaned}" -gt 0 ]; then
    log_event HALT "session off, but ${orphaned} run(s) are ORPHANED"
    bad "${orphaned} run(s) could not be confirmed stopped."
    err "the session is off and no new run will start, but the work those runs"
    err "were doing is still claimed and their checkouts are still leased."
    return 1
  fi
  log_event ok "session off after ${runs} run(s), ${done_n} task(s)"
  return 0
}

cmd_resume() {
  require_not_root
  [ -f "${STATE_FILE}" ] || die "no state file - there is nothing to resume"
  local halt
  halt=$(state_get .halt_reason "")
  if [ -z "${halt}" ] || [ "${halt}" = null ]; then
    say "not halted; nothing to do."
    return 0
  fi
  with_backlog_lock state_update '.halt_reason = null | .consecutive_failures = 0' ||
    die "could not update ${STATE_FILE}"
  good "cleared the halt (was: ${halt}). Runs will resume at the next slot."
}

cmd_set() {
  require_not_root
  [ -f "${STATE_FILE}" ] || die "no state file - start a session first"
  if [ $# -eq 0 ]; then
    printf '\n'
    field "max-total" "$(state_get .max_tasks_total 0)"
    field "max-tasks" "$(state_get .max_tasks_per_run 0)"
    field "timeout" "$(state_get .run_timeout_sec 0)s"
    printf '\n'
    return 0
  fi
  local key=$1 val=${2:-}
  case ${val} in ""|*[!0-9]*) die "set ${key}: needs a positive integer" ;; esac
  case ${key} in
    max-total) [ "${val}" -ge 1 ] || die "max-total must be >= 1"
      with_backlog_lock state_update ".max_tasks_total = ${val}" ;;
    max-tasks) [ "${val}" -ge 1 ] || die "max-tasks must be >= 1"
      with_backlog_lock state_update ".max_tasks_per_run = ${val}" ;;
    timeout) [ "${val}" -ge 60 ] || die "timeout must be >= 60"
      with_backlog_lock state_update ".run_timeout_sec = ${val}" ;;
    *) die "set: unknown key '${key}' (max-total, max-tasks, timeout)" ;;
  esac || die "could not update ${STATE_FILE}"
  good "${key} = ${val}"
}

# --- combined modes --------------------------------------------------------

# Apply the OS half of a mode when posture management is enabled. It remains
# opt-in because these settings can disconnect remote access; with it disabled
# the session half still works and status reports the posture as unmanaged.
mode_apply_posture() { # travel|remote dry-run
  local want=$1 dry=$2
  if [ "${HEINZEL_POSTURE}" != 1 ]; then
    if [ "${dry}" = 1 ]; then
      dim "posture management is off; OS posture would remain unmanaged."
    else
      dim "posture management is off; OS posture remains unmanaged."
    fi
    return 0
  fi

  POSTURE_DRY_RUN=${dry}
  if posture_apply "${want}"; then
    if [ "${dry}" = 1 ]; then
      good "${want} posture would be applied."
    else
      good "${want} posture applied."
    fi
    return 0
  fi
  bad "${want} posture applied with ${POSTURE_FAILED} problem(s) - see above."
  return 1
}

cmd_work() {
  session_start work "$@"
}

cmd_mobile() {
  session_start mobile "$@"
}

cmd_off() {
  require_not_root

  # Stop first, but close the machine up even when a runner cannot be
  # confirmed gone. An inbound firewall left open is the worse failure; the
  # non-zero stop status is still returned so ORPHANED is never called success.
  local stop_rc=0 posture_rc=0
  session_stop "$@" || stop_rc=$?
  mode_apply_posture travel 0 || posture_rc=$?

  if [ "${stop_rc}" -ne 0 ]; then
    printf '\n'
    bad "off mode closed the machine up, but a run could not be confirmed stopped."
    err "it is ORPHANED and still owns its checkout - see the message above."
    return "${stop_rc}"
  fi
  [ "${posture_rc}" -eq 0 ] || return "${posture_rc}"
  good "off mode applied."
  return 0
}

# --- the ledger ------------------------------------------------------------

need_backlog() {
  local b
  b=$(cur_backlog)
  [ -n "${b}" ] || die "no backlog configured (DEFAULT_BACKLOG in etc/heinzel.conf)"
  [ -r "${b}" ] || die "backlog not readable: ${b}"
  printf '%s' "${b}"
}

# What `[~]` means when there is nothing left to hand out: a run is holding
# these, or one died holding them. Claims are the authority and the marker is
# display (§13.4), so the run id is read from the claim rather than from the
# trailing comment the marker carries; a `[~]` with no claim behind it is stale
# and is listed saying so instead of being left out.
next_in_progress() {
  local b=$1 rows n ident id holders

  rows=$(backlog_scan "${b}" 2>/dev/null | awk -F'\t' '$3 == "~"')
  [ -n "${rows}" ] || { say "nothing to do - no todo items."; return 0; }
  n=$(printf '%s\n' "${rows}" | awk 'END {print NR}')

  # Who holds them, deduplicated: one run claiming all three is the ordinary
  # case, and repeating its id on every row would say nothing per row.
  ident=$(claims_workspace_identity "$(cur_workdir)" 2>/dev/null)
  holders=""
  if [ -n "${ident}" ]; then
    for id in $(printf '%s\n' "${rows}" | cut -f4); do
      holders="${holders}$(claims_holder "${ident}" "${id}" 2>/dev/null)
"
    done
    holders=$(printf '%s' "${holders}" | sed '/^$/d' | sort -u | tr '\n' ' ' |
      sed 's/ *$//')
  fi

  printf '\n'
  say "no todo items - ${n} in progress:"
  printf '\n'
  printf '%s\n' "${rows}" | awk -F'\t' '{printf "  P%-3s %-8s %s\n", $2, $4, $5}'
  printf '\n'
  if [ -n "${holders}" ]; then
    dim "  held by run ${holders} - nothing here is waiting on you"
  else
    # A marker with no claim behind it is the residue of a run that died
    # holding one. Only a run releases those — `hzl-run`'s "claims left
    # behind" pass, which runs once it holds the writer lease — so there is no
    # command to offer here. Saying which way it resolves is the useful part;
    # inventing a `hzl` subcommand for it would not be.
    dim "  no claim holds these - a run that died left the markers; the next run releases them"
  fi
  printf '\n'
}

cmd_next() {
  local b row
  b=$(need_backlog) || exit 1
  row=$(backlog_next_row "${b}")
  # `backlog_next_row` only ever returns a `[ ]`, so "empty" here is both "the
  # ledger is finished" and "a run has claimed everything that was left".
  # Reporting the first when the second is true is how a `hzl work` that says
  # 3 todo and a `hzl next` a minute later that says nothing to do end up
  # looking like they disagree about the same file.
  [ -n "${row}" ] || { next_in_progress "${b}"; return 0; }
  local nid
  nid=$(printf '%s' "${row}" | cut -f4)
  # Ids are allocated by the runner, so a task typed by hand has none yet.
  [ -n "${nid}" ] || nid="(id assigned at the next run)"
  printf '\n'
  field "next up" "${nid}"
  field "priority" "P$(printf '%s' "${row}" | cut -f2)"
  # Which checkout this task sends the next run to. Printed always, and not
  # only when several are configured: the answer to "where will it work" should
  # not depend on how many workspaces there happen to be today, and a task that
  # names one that no longer exists is worth seeing before the run blocks it.
  local nws nwd
  nws=$(task_workspace_name "$(printf '%s' "${row}" | cut -f6)")
  if nwd=$(workdir_path_in "${nws}" "$(cur_workdirs)"); then
    field "workspace" "${nws} (${nwd})"
  else
    field "workspace" "$(bad "${nws}") - no such workspace here; the next run will block this task"
  fi
  say ""
  say "  $(printf '%s' "${row}" | cut -f5)"
  backlog_notes_for_line "${b}" "$(printf '%s' "${row}" | cut -f1)"
  printf '\n'
}

# Blocked tasks are the ones a human has to close. Without an id this lists
# them; with an id it writes a prompt to paste into an interactive session.
#
# Read across the live ledger, not out of the backlog: after a sweep the blocked
# tasks are in the blocked file, and this command exists for exactly them.
cmd_take() {
  local b id=${1:-}
  b=$(need_backlog) || exit 1
  if [ -z "${id}" ]; then
    local n
    n=$(ledger_count "${b}" "!")
    if [ "${n}" -eq 0 ]; then
      say "nothing is blocked."
      return 0
    fi
    printf '\n'
    say "blocked, waiting for you:"
    printf '\n'
    # The workspace, when a task names one. Only then: with one checkout
    # configured every line would carry the same word, and the column would be
    # noise in the one place a person is trying to read a list quickly.
    ledger_scan_live "${b}" |
      awk -F'\t' '$3 == "!" {
        printf "  P%-3s %-8s %s%s\n", $2, $4, ($6 == "" ? "" : "[" $6 "] "), $5
      }'
    printf '\n'
    dim "  'hzl take <id>' prints a prompt for an interactive session"
    printf '\n'
    return 0
  fi

  local f text marker lineno steps
  # The file the line is in, so that the notes under it are read from the same
  # place the text was - and so the prompt names the file a person can open.
  f=$(ledger_file_of_id "${b}" "${id}") || { err "no such id: ${id}"; exit 3; }
  text=$(backlog_text_of_id "${f}" "${id}")
  [ -n "${text}" ] || { err "no such id: ${id}"; exit 3; }
  marker=$(backlog_marker_of_id "${f}" "${id}")
  lineno=$(backlog_line_of_id "${f}" "${id}")

  # Which checkout the task is about, and the `cd` that gets there. This is the
  # first thing a person needs and the easiest to get wrong: a task pasted into
  # a session opened in the wrong tree is worked on the wrong tree, and the
  # session finds out at the first file that is not where it should be.
  local tws twd=""
  tws=$(task_workspace_name "$(ledger_scan_live "${b}" 2>/dev/null |
    awk -F'\t' -v want="${id}" '$4 == want {print $6; exit}')")
  twd=$(workdir_path_in "${tws}" "$(cur_workdirs)") || twd=""

  printf '\n--- paste this into an interactive session ---\n\n'
  if [ -n "${twd}" ]; then
    printf 'Work in %s (workspace %s):\n\n    cd %s\n\n' "${twd}" "${tws}" "${twd}"
  else
    printf 'This task names workspace %s, which is not configured here.\n' "${tws}"
    printf 'Configured: %s\n\n' "$(workdir_names_of "$(cur_workdirs)")"
  fi
  printf 'Task %s from %s:\n\n' "${id}" "${f}"
  printf '  %s\n' "${text}"
  backlog_notes_for_line "${f}" "${lineno}"
  if [ "${marker}" = "!" ]; then
    steps=$(ledger_steps_file "${b}" "${id}")
    if [ -n "${steps}" ] && [ -r "${steps}" ]; then
      # The whole file, not a path. What is pasted into a session has to carry
      # the instructions with it, or the session is being asked to guess at them
      # the same way the run that stopped was.
      printf '\nThe run that stopped on this left instructions in %s:\n\n' "${steps}"
      sed 's/^/  /' "${steps}"
    else
      printf '\nThis was blocked by an unattended run, which means it needed a\n'
      printf 'judgement call, a privilege, or an irreversible action it would not take\n'
      printf 'on its own. It left no instructions. Start them with\n\n'
      printf '    hzl steps %s\n\n' "${id}"
      printf 'which writes a form to fill in at %s\n' "${steps}"
      printf 'Then work out what the task needs, do it with me, and put what you did\n'
      printf 'in that form, so that the next person - or the next block - starts from it.\n'
    fi
  fi
  printf '\nWhen it is finished, close it out with:  hzl done %s "<what changed>"\n' "${id}"
  printf '\n--- end ---\n\n'
}

# Closing a task by hand is two mutations, the marker and the note, and they go
# in together under one lock: a run reading the ledger between them would see a
# completion with nothing saying what changed. `ledger_close_with_note` holds
# the transition and its statuses - 3 for no such id, 4 for a marker that was
# set while its note was not; what is here is only what makes it `by:human`.
done_with_note() { # backlog id note
  ledger_close_with_note "$1" "$2" "done:$(iso_at) by:human" "$3"
}

# Blocking and unblocking are a marker change and a move, and they are one
# change: an unblocked task still sitting in the blocked file when `hzl next`
# looks is an unblock that did not happen. The runner would sweep it at the top
# of the next run, which is hours away and long after the person went to bed.
#
# Which is why a sweep that failed is reported rather than swallowed. Status 5
# is the half-done state — the marker moved, the task did not — and it is not a
# rollback, for the same reason `hzl done`'s status 4 is not: the marker is the
# true half of the record, and putting it back to hide the half that failed
# would discard both. The caller says which half stands (§8.1).
set_state_and_sweep() { # backlog id marker meta
  ledger_set_state "$1" "$2" "$3" "${4:-}" || return $?
  backlog_sweep_blocked "$1" >/dev/null || return 5
  return 0
}

cmd_done() {
  require_not_root
  local b id=${1:-} note=${2:-}
  [ -n "${id}" ] || die "usage: hzl done <id> [note]"
  b=$(need_backlog) || exit 1
  with_backlog_lock done_with_note "${b}" "${id}" "${note}"
  case $? in
    0) ;;
    3) err "no such id: ${id}"; exit 3 ;;
    4) good "${id} done."
       err "but the note was not written to $(ledger_file_of_id "${b}" "${id}")"
       dim "  the task is closed; the reason it closed is not recorded"
       dim "  add it by hand, or re-run: hzl done ${id} \"${note}\""
       exit 4 ;;
    *) die "could not update ${b}" ;;
  esac
  good "${id} done."
}

cmd_block() {
  require_not_root
  local b id=${1:-} reason=${2:-}
  [ -n "${id}" ] || die "usage: hzl block <id> <reason>"
  [ -n "${reason}" ] || die "a reason is required - it is what tells you what to do later"
  b=$(need_backlog) || exit 1
  with_backlog_lock set_state_and_sweep "${b}" "${id}" "!" "blocked:$(iso_at) reason:${reason}"
  case $? in
    0) ;;
    3) err "no such id: ${id}"; exit 3 ;;
    5) good "${id} blocked: ${reason}"
       err "but it could not be moved to $(ledger_blocked_file "${b}")"
       dim "  the marker is set; the task is still listed in ${b}"
       dim "  finish the move with: hzl archive"
       exit 5 ;;
    *) die "could not update ${b}" ;;
  esac
  good "${id} blocked: ${reason}"
  dim "  it is in $(ledger_blocked_file "${b}") now, with the rest of what needs you"
  dim "  'hzl steps ${id}' starts the instructions, for when one line is not enough"
}

cmd_unblock() {
  require_not_root
  local b id=${1:-} steps
  [ -n "${id}" ] || die "usage: hzl unblock <id>"
  b=$(need_backlog) || exit 1
  steps=$(ledger_steps_file "${b}" "${id}")
  with_backlog_lock set_state_and_sweep "${b}" "${id}" " " ""
  case $? in
    0) ;;
    3) err "no such id: ${id}"; exit 3 ;;
    5) err "${id} is unblocked, but it is still in $(ledger_blocked_file "${b}")"
       dim "  nothing picks it up while it is there - the worksheet is built from ${b}"
       dim "  move it with: hzl archive"
       exit 5 ;;
    *) die "could not update ${b}" ;;
  esac
  good "${id} is back in the queue."
  # Left where it is deliberately. The instructions were answered rather than
  # made wrong, and a run that blocks this task again writes its own file over
  # this one; nothing reads it while the task is not `[!]`.
  [ -n "${steps}" ] && [ -r "${steps}" ] &&
    dim "  what it asked of you is still in ${steps}"
  return 0
}

# The instructions a blocked task asks for, for the tasks that have none: a
# block written by `hzl block`, or by a run from before the steps file existed,
# carries one line of reason and nothing more. One line can say what to decide.
# It cannot say which page to open, what to type, or how to tell it worked.
#
# With no id this says which blocked tasks are still missing theirs. With an id
# it creates the file from the skeleton and prints the path. It never writes
# over a file that is there: once it exists, it belongs to whoever wrote it.
cmd_steps() {
  require_not_root
  local b id=${1:-} rows row n reason steps
  b=$(need_backlog) || exit 1
  rows=$(ledger_blocked_rows "${b}")

  if [ -z "${id}" ]; then
    n=$(printf '%s' "${rows}" | grep -c .)
    if [ "${n}" -eq 0 ]; then
      say "nothing is blocked, so nothing is waiting for steps."
      return 0
    fi
    printf '\n'
    say "what each blocked task asks of you:"
    printf '\n'
    printf '%s\n' "${rows}" |
      awk -F'\t' '{ if ($5 != "") s = $5; else s = "no steps yet - '\''hzl steps " $2 "'\'' starts one"
                    printf "  %-8s %s\n           %s\n", $2, $4, s }'
    printf '\n'
    return 0
  fi

  row=$(printf '%s\n' "${rows}" | awk -F'\t' -v i="${id}" '$2 == i' | head -1)
  if [ -z "${row}" ]; then
    ledger_file_of_id "${b}" "${id}" >/dev/null 2>&1 ||
      { err "no such id: ${id}"; exit 3; }
    die "${id} is not blocked - steps are for the tasks that are waiting on you"
  fi

  steps=$(printf '%s' "${row}" | cut -f5)
  if [ -n "${steps}" ]; then
    say "${id} already has steps:"
    printf '  %s\n' "${steps}"
    return 0
  fi

  reason=$(printf '%s' "${row}" | cut -f3)
  steps=$(ledger_steps_file "${b}" "${id}") || die "could not name a steps file for ${id}"
  # The row above says "no steps" when the file is not *readable*; a file that
  # is there and cannot be read - wrong mode after a hand edit, written under
  # another account - is still somebody's, and is not written over.
  if [ -e "${steps}" ]; then
    err "${id} has a steps file that cannot be read: ${steps}"
    err "  fix its permissions rather than writing over it"
    exit 1
  fi
  mkdir -p "$(dirname "${steps}")" || die "could not create $(dirname "${steps}")"
  # shellcheck disable=SC2059
  printf "${STEPS_TEMPLATE}" "${id}" "${reason}" "${id}" "${id}" >"${steps}" ||
    die "could not write ${steps}"
  good "${id}: a form to fill in is waiting at"
  printf '  %s\n' "${steps}"
  dim "  replace each <angle bracket> with what a person who was not here should do"
  dim "  'hzl take ${id}' pastes the task and the steps into an interactive session"
  return 0
}

# The same sweep the runner does at the top of a run, on demand. Both halves of
# it: a `hzl archive` that moved completions and left the blocked tasks where
# they were would leave the backlog in a state no run ever leaves it in.
cmd_archive() {
  require_not_root
  local b n swept out back
  b=$(need_backlog) || exit 1
  # The status, not just the shape of the output: both sweeps print a count and
  # then say separately whether they managed it, and a sweep that failed prints
  # `0` — which reads exactly like a sweep that found nothing to do.
  n=$(with_backlog_lock backlog_archive_done "${b}") ||
    die "could not move completed tasks out of ${b}"
  case ${n} in ""|*[!0-9]*) die "could not sweep ${b}" ;; esac
  swept=$(with_backlog_lock backlog_sweep_blocked "${b}") ||
    die "could not move blocked tasks out of ${b}"
  out=$(printf '%s' "${swept}" | cut -d' ' -f1)
  back=$(printf '%s' "${swept}" | cut -d' ' -f2)
  case ${out}${back} in ""|*[!0-9]*) die "could not sweep ${b}" ;; esac
  [ "${n}" -gt 0 ] && good "${n} completed task(s) moved to $(ledger_archive "${b}")"
  [ "${out}" -gt 0 ] && good "${out} blocked task(s) moved to $(ledger_blocked_file "${b}")"
  [ "${back}" -gt 0 ] && good "${back} task(s) are no longer blocked and are back in ${b}"
  [ $((n + out + back)) -eq 0 ] &&
    say "nothing to sweep - the backlog holds only what is queued."
  return 0
}

# --- the morning report ----------------------------------------------------
#
# What a human needs to know after a night of unattended runs, and nothing else:
# what is waiting on a decision, and what got done. `hzl status` answers "is the
# machine doing the right thing"; this answers "is there anything for me".
#
# Blocked comes first and completed second, because blocked is the only part
# that is actually addressed to the reader. Everything else in this file prints
# the queue in the order the runner would attack it; this one prints it in the
# order a person triages it.
#
# Exit 10 means something is blocked. That is what makes the report usable from
# a scheduled job — `hzl report --quiet || notify` — without parsing its output.

cmd_report() {
  local b days=1 json=0 quiet=0 since blocked completions n_blocked n_done n_todo
  while [ $# -gt 0 ]; do
    case $1 in
      --days) days=${2:-1}; shift ;;
      --json) json=1 ;;
      --quiet) quiet=1 ;;
      *) die "report: unknown option $1" ;;
    esac
    shift
  done
  case ${days} in ""|*[!0-9]*) die "report: --days takes a number of days" ;; esac
  b=$(need_backlog) || exit 1

  # BSD date, like every other date arithmetic in this tool. A day boundary and
  # not 24 hours: "since yesterday" is what a person means in the morning, and
  # the ledger only records completions to the day anyway.
  since=$(date -v-"${days}"d +%F 2>/dev/null)
  [ -n "${since}" ] || die "could not compute a date ${days} day(s) ago"

  blocked=$(ledger_blocked_rows "${b}")
  completions=$(ledger_completed_since "${b}" "${since}")
  n_blocked=$(printf '%s' "${blocked}" | grep -c . )
  n_done=$(printf '%s' "${completions}" | grep -c . )
  n_todo=$(backlog_count "${b}" " ")

  if [ "${json}" = 1 ]; then
    jq -n \
      --arg since "${since}" \
      --arg backlog "${b}" \
      --arg archive "$(ledger_archive "${b}")" \
      --arg blocked_file "$(ledger_blocked_file "${b}")" \
      --argjson todo "${n_todo}" \
      --argjson blocked "$(printf '%s\n' "${blocked}" | jq -R -s -c 'split("\n") | map(select(length > 0)) | map(split("\t")) | map({at: .[0], id: .[1], reason: .[2], text: .[3], steps: (if (.[4] // "") == "" then null else .[4] end)})')" \
      --argjson completed "$(printf '%s\n' "${completions}" | jq -R -s -c 'split("\n") | map(select(length > 0)) | map(split("\t")) | map({at: .[0], id: .[1], text: .[2]})')" \
      '{since: $since, backlog: $backlog, blocked_file: $blocked_file,
        archive: $archive, todo: $todo, blocked: $blocked, completed: $completed}'
    [ "${n_blocked}" -gt 0 ] && exit 10
    return 0
  fi

  if [ "${quiet}" = 1 ]; then
    [ "${n_blocked}" -gt 0 ] && exit 10
    return 0
  fi

  printf '\n'
  if [ "${n_blocked}" -eq 0 ]; then
    good "nothing is blocked."
  else
    bad "${n_blocked} task(s) blocked, waiting for you:"
    printf '\n'
    # The reason is the ask, in one line. The steps are the rest of it, and the
    # path is printed rather than the file: this is a list to triage, and the
    # one item you decide to do is the one you open.
    printf '%s\n' "${blocked}" |
      awk -F'\t' '{printf "  %-8s %-11s %s\n           %s\n", $2, $1, $4, $3
                   if ($5 != "") printf "           steps: %s\n", $5
                   else printf "           steps: none written - '\''hzl steps %s'\'' starts one\n", $2}'
    dim "  'hzl take <id>' prints the task and its steps for an interactive session"
  fi

  printf '\n'
  if [ "${n_done}" -eq 0 ]; then
    say "nothing completed since ${since}."
  else
    say "completed since ${since} (${n_done}):"
    printf '\n'
    printf '%s\n' "${completions}" | sort |
      awk -F'\t' '{printf "  %-8s %-11s %s\n", $2, $1, $3}'
  fi

  printf '\n'
  field "still to do" "${n_todo}"
  printf '\n'
  [ "${n_blocked}" -gt 0 ] && exit 10
  return 0
}

# --- runs ------------------------------------------------------------------

cmd_runnow() {
  require_not_root
  [ -x "${RUNNER}" ] || die "runner not found or not executable: ${RUNNER}"
  "${RUNNER}" --from manual "$@"
}

cmd_logs() {
  local follow=0 n=1
  while [ $# -gt 0 ]; do
    case $1 in
      -f) follow=1 ;;
      -n) n=${2:-1}; shift ;;
      *) die "logs: unknown option $1" ;;
    esac
    shift
  done
  # Plain glob, sorted by mtime. Piping through xargs would let it split the
  # list and destroy the ordering.
  local latest
  latest=$(ls -t "${LOG_DIR}"/*/run-*.log 2>/dev/null | head -"${n}")
  if [ -z "${latest}" ]; then
    [ -r "${RUNNER_LOG}" ] || die "no logs yet"
    tail -n 40 "${RUNNER_LOG}"
    return 0
  fi
  if [ "${follow}" = 1 ]; then
    tail -f "$(printf '%s' "${latest}" | head -1)"
  else
    local f
    printf '%s\n' "${latest}" | while IFS= read -r f; do
      printf '\n=== %s\n' "${f}"
      cat "${f}"
    done
  fi
}

# --- doctor ----------------------------------------------------------------

DOC_PROBLEMS=0
doc_ok()   { printf '  %s %s\n' "$(good ok)" "$*"; }
doc_warn() { printf '  %s %s\n' "$(printf '%s??%s' "${_C_YELLOW}" "${_C_OFF}")" "$*"; }
doc_bad()  { printf '  %s %s\n' "$(bad XX)" "$*"; DOC_PROBLEMS=$((DOC_PROBLEMS + 1)); }

cmd_doctor() {
  printf '\n1. prerequisites\n'
  local c
  # Reported, not required: `hzl web` is a window a person opens, and every
  # unattended path in this program runs without it. A machine that never
  # serves the dashboard is not misconfigured for lacking python3.
  if have python3; then
    doc_ok "python3 present ($(python3 -V 2>&1) - only 'hzl web' uses it)"
  else
    doc_warn "python3 not found - 'hzl web' will not start (xcode-select --install). Nothing else needs it"
  fi
  for c in jq caffeinate pmset launchctl lockf; do
    if have "${c}"; then doc_ok "${c}"; else doc_bad "${c} is missing"; fi
  done
  if have "${HEINZEL_EXECUTOR_ENGINE}"; then
    doc_ok "${HEINZEL_EXECUTOR_ENGINE} ($(${HEINZEL_EXECUTOR_ENGINE} --version 2>/dev/null | head -1))"
  else
    # "not on PATH" is not a diagnosis, and this is the one prerequisite whose
    # absence depends on how hzl was invoked rather than on what is installed.
    # Print what was actually searched, so the next report is answerable.
    doc_bad "executor engine '${HEINZEL_EXECUTOR_ENGINE}' is not on PATH"
    printf '       searched: %s\n' "${PATH}"
    printf '       set HEINZEL_EXECUTOR_ENGINE in etc/heinzel.conf, or put the CLI on PATH.\n'
  fi
  # Absence is expected on stock macOS and is not a problem: we ship our own.
  if have timeout || have gtimeout; then
    doc_ok "coreutils timeout present (unused - hzl carries its own watchdog)"
  else
    doc_ok "no coreutils timeout, as expected - using the bundled watchdog"
  fi

  printf '\n2. configuration\n'
  if [ -f "${HEINZEL_ROOT}/etc/heinzel.conf" ]; then
    doc_ok "etc/heinzel.conf"
  else
    doc_warn "no etc/heinzel.conf - running on defaults (copy heinzel.conf.example)"
  fi
  if hzl_validate_conf >/dev/null 2>&1; then
    doc_ok "configuration values are valid"
  else
    doc_bad "configuration is invalid:"
    hzl_validate_conf 2>&1 | sed 's/^/       /'
  fi
  local settings="${HEINZEL_ROOT}/etc/heinzel-settings.json"
  if [ -f "${settings}" ]; then
    if jq -e . "${settings}" >/dev/null 2>&1; then
      doc_ok "etc/heinzel-settings.json is valid JSON"
      # The deny list names the ledger, so it goes stale the moment the
      # configured backlog moves. Nothing else notices: the runner checks the
      # file parses, not that it is about the right paths.
      local cur_bl want
      cur_bl=$(cur_backlog)
      if [ -n "${cur_bl}" ]; then
        cur_bl=$(abspath "${cur_bl}")
        want="Edit(//${cur_bl#/})"
        if jq -e --arg p "${want}" \
             '(.permissions.deny // []) | index($p)' "${settings}" >/dev/null 2>&1; then
          doc_ok "the deny list names the configured backlog"
        else
          doc_bad "the deny list does not name ${cur_bl} - run 'hzl install'"
        fi
      fi
      # Self-hosting: when the agent works on Heinzel itself, etc/ is the one
      # part of the repository it must not reach - every file in there is a way
      # to widen its own boundary instead of doing the task. Nothing else
      # notices if that rule goes missing; the run would simply be unconfined
      # in the direction that matters most.
      #
      # Any of the session's workspaces, not the default one: this repository
      # being the second entry in the list makes it no less this repository,
      # and the carve-out is what stands between a run that reaches it and its
      # own deny list.
      if printf '%s\n' "$(cur_workdirs)" | grep -qxF -- "${HEINZEL_ROOT}"; then
        if jq -e --arg p "Edit(//${HEINZEL_ROOT#/}/etc/**)" \
             '(.permissions.deny // []) | index($p)' "${settings}" >/dev/null 2>&1; then
          doc_ok "self-hosting: the agent may edit the repository but not etc/"
        else
          doc_bad "self-hosting without the etc/ carve-out - the agent could rewrite its own deny list"
          printf '       workdir is %s and etc/** is not denied. Run '"'"'hzl install'"'"'.\n' "${HEINZEL_ROOT}"
        fi
      fi
      # Safe mode is a claim etc/heinzel.conf makes and this file keeps. The two
      # go out of step the moment the setting changes without `hzl install`, and
      # nothing else notices - so it is asked of the file, not of the setting.
      local sm_missing
      sm_missing=$(safe_mode_missing_rules "${settings}")
      if [ "${HEINZEL_SAFE_MODE}" = 1 ]; then
        if [ -z "${sm_missing}" ]; then
          doc_ok "safe mode: $(hzl_safe_mode_commands | grep -c .) commands that reach a real environment are denied"
        else
          doc_bad "HEINZEL_SAFE_MODE=1 but the permission file does not deny $(printf '%s\n' "${sm_missing}" | safe_mode_missing_summary) - run 'hzl install'"
        fi
      elif [ -z "${sm_missing}" ]; then
        doc_warn "safe mode is off in etc/heinzel.conf, but the installed file still carries it - 'hzl install' to make them agree"
      else
        doc_warn "safe mode is OFF - an unattended run may call gcloud, kubectl, terraform and the rest"
      fi
    else
      # claude --print silently ignores a malformed settings file, which would
      # drop every deny rule without a word.
      doc_bad "etc/heinzel-settings.json is NOT valid JSON - runs will abort rather than run unprotected"
    fi
  else
    doc_bad "etc/heinzel-settings.json is missing - the deny list is what confines the agent"
  fi

  printf '\n3. launch agent\n'
  local pl
  pl=$(plist_path)
  if launchctl print "gui/$(id -u)/${HEINZEL_LABEL}" >/dev/null 2>&1; then
    doc_ok "${HEINZEL_LABEL} is loaded"
  else
    doc_warn "${HEINZEL_LABEL} is not loaded (run 'hzl install')"
  fi
  if [ -f "${pl}" ]; then
    if generate_plist | diff -q - "${pl}" >/dev/null 2>&1; then
      doc_ok "the installed plist matches the current configuration"
    else
      # Name what differs. This is a whole-file diff, not an HEINZEL_HOURS
      # check, and saying otherwise sends the reader to the one line that is
      # usually fine.
      doc_bad "the installed plist differs from what this configuration generates - run 'hzl install'"
      generate_plist | diff - "${pl}" 2>/dev/null | sed -n '1,12p;13s/.*/       .../p' | sed 's/^/       /'
    fi
  else
    doc_warn "no plist at ${pl}"
  fi

  printf '\n4. session state\n'
  local mode
  hzl_eval_mode
  mode=${HZ_MODE}
  if [ -f "${STATE_FILE}" ]; then
    if jq -e . "${STATE_FILE}" >/dev/null 2>&1; then
      # A file older than the schema field says v1 here and is left as one:
      # doctor diagnoses, it does not migrate.
      doc_ok "state.json is valid (schema v$(state_schema_version), runtime backend $(state_runtime_backend))"
    else
      doc_bad "state.json is corrupt - 'hzl work' or 'hzl mobile' will rebuild it"
    fi
    local owner
    owner=$(stat -f '%Su' "${STATE_FILE}" 2>/dev/null)
    if [ "${owner}" = root ]; then
      doc_bad "state.json is owned by root - hzl was run under sudo. chown it back to $(id -un)"
    fi
  else
    doc_warn "no state file yet"
  fi
  if [ "${mode}" = heinzel ]; then
    doc_ok "$(session_operating_mode) mode, expires $(short_at "$(state_get .expires_at_epoch 0)"), $(budget_line)"
  else
    doc_ok "off mode (${HZ_REASON})"
  fi
  local halt
  halt=$(state_get .halt_reason "")
  if [ -n "${halt}" ] && [ "${halt}" != null ]; then
    doc_bad "halted: ${halt} - fix the cause, then 'hzl resume'"
  fi

  printf '\n5. power and sleep\n'
  if on_ac_power; then
    doc_ok "on AC power"
  elif [ "${mode}" = heinzel ] && session_allows_battery; then
    doc_warn "on battery ($(battery_pct)) - mobile mode allows scheduled runs"
  else
    doc_warn "on battery ($(battery_pct)) - scheduled runs will skip"
  fi
  if [ "${mode}" != heinzel ] && [ "$(sleep_disabled)" = 1 ]; then
    doc_bad "sleep is suppressed with no session running - run 'hzl off' to restore it"
  else
    doc_ok "sleep suppression matches the session state"
  fi

  printf '\n6. working directories and backlog\n'
  local b w ws_all ws_n ws_ok=0 first=1 ws_reachable=""
  ws_all=$(cur_workdirs)
  ws_n=$(printf '%s\n' "${ws_all}" | grep -c .)
  b=$(cur_backlog)
  if [ -z "${ws_all}" ] || [ -z "${b}" ]; then
    doc_bad "not configured yet - set DEFAULT_WORKDIR and DEFAULT_BACKLOG in etc/heinzel.conf"
  else
    # Every workspace, each one checked the same way. A checkout that has been
    # moved or renamed is a whole class of tasks that cannot be worked, and
    # under one working directory the first run said so; under several, only a
    # run that reached a task naming *that* one would - which could be weeks.
    while IFS= read -r w; do
      [ -n "${w}" ] || continue
      if case ${w} in ("${HEINZEL_HOME}"|"${HEINZEL_HOME}"/*) true ;; (*) false ;; esac; then
        doc_bad "workspace ${w} is inside ${HEINZEL_HOME} - the agent is denied all of it"
        printf '       %s holds state.json, the lock and the logs. An agent working\n' "${HEINZEL_HOME}"
        printf '       there can write nothing, and the run looks like a capable agent failing.\n'
        printf "       point DEFAULT_WORKDIR at the code you want worked on. 'hzl work' refuses this.\n"
      elif [ ! -d "${w}" ]; then
        doc_bad "workspace ${w} does not exist"
        printf '       create it, or take it out of DEFAULT_WORKDIR.\n'
        printf "       'hzl work' refuses to start without it, because launchd runs with cwd=/\n"
      else
        ws_ok=$((ws_ok + 1))
        if [ "${first}" = 1 ]; then
          doc_ok "workspace $(workdir_name "${w}") - ${w} (the default: a task with no (dir:) goes here)"
        else
          doc_ok "workspace $(workdir_name "${w}") - ${w}"
        fi
      fi
      first=0
      # The agent works from a worksheet the runner merges back, so it never
      # needs the ledger - and the sandbox is a path boundary, so a ledger kept
      # outside every working directory is one a subprocess cannot reach
      # either. Checked against each of them: it only takes one to reach it.
      case ${b} in
        "${w}"/*)
          ws_reachable=1
          doc_warn "the backlog is inside workspace ${w}, so the agent can reach it"
          printf '       backlog %s\n       workdir %s\n' "${b}" "${w}"
          printf '       move it out (e.g. %s/backlog.md) and re-run '"'"'hzl install'"'"'\n' "${HEINZEL_HOME}" ;;
      esac
    done <<EOF
${ws_all}
EOF
    # It only takes one workspace to reach the ledger, so this is said once,
    # about all of them, and only when none of them can.
    [ -n "${ws_reachable}" ] ||
      doc_ok "the backlog is outside every working directory, out of the agent's reach"
    case ${ws_n} in
      1) ;;
      *) doc_ok "${ws_n} workspaces; the queue is shared and a task picks one with (dir:<name>)" ;;
    esac
    w=$(printf '%s\n' "${ws_all}" | head -1)
    if [ -r "${b}" ]; then
      doc_ok "${b}: $(backlog_count "${b}" " ") todo, $(backlog_count "${b}" "~") in progress, $(backlog_count "${b}" x) done, $(ledger_count "${b}" "!") blocked"
    else
      # Not a fault: a live-mode command creates it from a template.
      doc_warn "no backlog at ${b} yet - 'hzl work' will create it"
    fi
  fi

  printf '\n7. review pipeline\n'
  if [ "${HEINZEL_REVIEW}" = 1 ]; then
    if have "${HEINZEL_REVIEWER_ENGINE}"; then
      doc_ok "reviewer '${HEINZEL_REVIEWER_ENGINE}' is present"
    else
      doc_bad "review is on but '${HEINZEL_REVIEWER_ENGINE}' is not on PATH"
    fi
    local schema="${HEINZEL_ROOT}/etc/review-schema.json"
    if jq -e . "${schema}" >/dev/null 2>&1; then
      doc_ok "review-schema.json is valid"
    else
      doc_bad "review-schema.json is missing or invalid"
    fi
  else
    doc_ok "review is off (HEINZEL_REVIEW=0)"
  fi

  printf '\n8. posture\n'
  if [ "${HEINZEL_POSTURE}" = 1 ]; then
    local p
    p=$(posture_now)
    case ${p} in
      travel|remote) doc_ok "posture is ${p}" ;;
      *) doc_bad "posture is ${p} - components disagree:" ;;
    esac
    printf '       screen sharing %s / wake-on-LAN %s / sudoers %s / firewall %s\n' \
      "$(posture_screensharing)" "$(posture_wol)" "$(posture_sudoers)" "$(posture_firewall)"
    printf '       screen lock %s / idle sleep %s\n' "$(screenlock_now)" "$(pmset_ac_value sleep)"
    # The only way to reach this is a restore path that failed, so it is a
    # defect rather than a warning (DESIGN 4.3).
    if [ "${mode}" = heinzel ] && [ -f "${SUDOERS_TICKET}" ]; then
      doc_bad "the relaxed sudo ticket window is OPEN during a session - it should have been removed"
    fi
    # Closing our own ticket file achieves nothing if another drop-in grants
    # the same thing. Heinzel only manages its own two files, so anything else
    # in sudoers.d is outside the guarantee and has to be named.
    local others="" f
    for f in /etc/sudoers.d/*; do
      [ -e "${f}" ] || continue
      f=${f##*/}
      case ${f} in
        heinzel-*) continue ;;
      esac
      others="${others}${f} "
    done
    if [ -n "${others}" ]; then
      local leaky=""
      for f in ${others}; do
        if sudo -n grep -lq 'tty_tickets\|timestamp_timeout' "/etc/sudoers.d/${f}" 2>/dev/null; then
          leaky="${leaky}${f} "
        fi
      done
      if [ -n "${leaky}" ]; then
        doc_bad "another sudoers file keeps a ticket window open: ${leaky}"
        printf '       every mode removes heinzel-ticket, but these grant the same thing,\n'
        printf '       so the write-capable sudo window is NOT closed during a session.\n'
      elif sudo -n true 2>/dev/null; then
        doc_ok "no other sudoers file grants a ticket window (${others})"
      else
        doc_warn "other sudoers files present and not readable from here: ${others}"
        printf '       they are outside Heinzel'"'"'s control; check them for !tty_tickets by hand.\n'
      fi
    fi
  else
    doc_ok "posture management is off"
  fi

  printf '\n'
  if [ "${DOC_PROBLEMS}" -eq 0 ]; then
    good "no problems found."
  else
    bad "${DOC_PROBLEMS} problem(s) found."
  fi
  printf '\n'
  [ "${DOC_PROBLEMS}" -eq 0 ]
}

# --- install ---------------------------------------------------------------

generate_plist() {
  local cal="" h
  for h in $(hours_normalised); do
    cal="${cal}    <dict><key>Hour</key><integer>${h}</integer><key>Minute</key><integer>0</integer></dict>
"
  done
  # Built without a trailing newline of its own: a here-document would leave
  # $'\n' literal and put a blank line into the plist.
  cal=${cal%
}
  # A generated file must be a function of configuration and nothing else. This
  # baked in `${PATH}` - the path of whichever shell happened to run `hzl
  # install` - so the plist differed between one install and the next, and the
  # drift check below (a whole-file diff) then reported a schedule that had not
  # moved. The runner appends these three directories itself; the plist gives
  # launchd a sane base, and now a reproducible one.
  local plist_path="/usr/local/bin:/opt/homebrew/bin:${HOME}/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  sed -e "s|__LABEL__|${HEINZEL_LABEL}|g" \
      -e "s|__RUNNER__|${RUNNER}|g" \
      -e "s|__PATH__|${plist_path}|g" \
      -e "s|__HOME__|${HOME}|g" \
      -e "s|__LOGDIR__|${LOG_DIR}|g" \
      "${HEINZEL_ROOT}/etc/agent.plist.in" |
  HZL_CAL=${cal} awk '
    BEGIN { cal = ENVIRON["HZL_CAL"] }
    { if ($0 == "__CALENDAR__") print cal; else print }'
}

# The allow list has to name every working directory and the deny list the
# ledger, both of which are configuration, so the file the runner validates is
# generated rather than shipped.
generate_settings() {
  local workdirs=$1 backlog=$2 out="${HEINZEL_ROOT}/etc/heinzel-settings.json"
  local blocked completed rules="" wd
  # The ledger is three files, and all three are denied by name. The other two
  # are derived from the backlog rather than looked up, because `ledger_files`
  # answers with the files that exist and this list has to hold for the ones
  # that do not exist yet: a blocked file is created by the first sweep that has
  # something to put in it, and a rule written after the fact would leave the
  # agent free to edit its own blocked queue until then. These two functions are
  # pure string work for that reason.
  blocked=$(ledger_blocked_file "${backlog}") || return 1
  completed=$(ledger_archive "${backlog}") || return 1
  # __HOME__ as well as the rest: the credential denials are written out in
  # full rather than with a tilde, so they do not depend on permission rules
  # performing tilde expansion - a behaviour this project has not verified.
  # An absolute path in a Read/Edit rule needs two leading slashes: one slash
  # anchors at the settings file's own location, which silently matches
  # nothing. The paths are anchored here so the template cannot get it wrong.
  # One workspace or several: the allow list carries the same two rules for
  # each. `$1` is the whole of `DEFAULT_WORKDIR`, one absolute path per line,
  # so a single-workspace configuration produces exactly the four lines this
  # file has always had.
  #
  # A generated block and not a `sed` substitution, for the same reason the
  # plist's calendar is one: the number of entries is a function of
  # configuration, and `sed` replaces a placeholder with a value rather than
  # with a list.
  while IFS= read -r wd; do
    [ -n "${wd}" ] || continue
    rules="${rules}      \"Read(//${wd#/}/**)\",
      \"Edit(//${wd#/}/**)\",
      \"Read(//${wd#/}/.heinzel/worksheet.md)\",
      \"Edit(//${wd#/}/.heinzel/worksheet.md)\",
"
  done <<EOF
${workdirs}
EOF
  # The last entry of a JSON array takes no comma. Stripped from the last line
  # rather than by building the block backwards, because a `}` at the start of
  # a line would end this function as far as the test that lifts it out of
  # bin/hzl is concerned.
  rules=$(printf '%s' "${rules}" | sed -e '$ s/,$//')
  [ -n "${rules}" ] || { err "no workspace to allow - DEFAULT_WORKDIR is empty"; return 1; }

  # Safe mode, on unless `HEINZEL_SAFE_MODE=0` says otherwise: two deny rules
  # per command that reaches a cluster, a cloud account, a registry, a package
  # index or another host. The list and the reasoning are in lib/common.sh's
  # `hzl_safe_mode_commands`; `:-1` is the same default as `hzl_load_conf`, so
  # this function generates a confined file even when it is called with no
  # configuration loaded at all.
  #
  # Merged into the parsed document rather than substituted into the template
  # the way the workspace rules are, and that is not a preference: `etc/` is
  # denied to the unattended agent - every file in it is control surface - so a
  # run improving Heinzel cannot add a placeholder to the template it would then
  # fill in. Building the rules here keeps the whole change inside `bin/`, which
  # is open and reviewed. A human moving this block into
  # etc/heinzel-settings.json.in later loses nothing: the output is the same
  # file either way.
  local safe_json="[]"
  if [ "${HEINZEL_SAFE_MODE:-1}" = 1 ]; then
    safe_json=$(hzl_safe_mode_commands |
      jq -R -s -c 'split("\n") | map(select(length > 0))
                   | map(["Bash(" + . + " *)", "Bash(" + . + ":*)"]) | add') || {
      err "could not build the safe-mode deny rules"
      return 1
    }
  fi

  local tmp="${out}.new"
  sed -e "s|__BACKLOG_ABS__|//${backlog#/}|g" \
      -e "s|__BACKLOG_BLOCKED_ABS__|//${blocked#/}|g" \
      -e "s|__BACKLOG_COMPLETED_ABS__|//${completed#/}|g" \
      -e "s|__HEINZEL_HOME_ABS__|//${HEINZEL_HOME#/}|g" \
      -e "s|__HEINZEL_ROOT_ABS__|//${HEINZEL_ROOT#/}|g" \
      "${HEINZEL_ROOT}/etc/heinzel-settings.json.in" |
  HZL_WS_RULES=${rules} awk '
    BEGIN { rules = ENVIRON["HZL_WS_RULES"] }
    { if ($0 == "__WORKSPACE_RULES__") print rules; else print }' >"${tmp}" || return 1
  # First, so that what follows is working on a document and not on a guess.
  jq -e . "${tmp}" >/dev/null 2>&1 || {
    err "generated ${tmp} is not valid JSON"
    return 1
  }
  # In front of the template's own denials, so that the file a person opens
  # leads with what this machine refuses to touch.
  jq --argjson safe "${safe_json}" \
     '.permissions.deny = ($safe + (.permissions.deny // []))' "${tmp}" >"${out}" || {
    err "could not merge the safe-mode rules into ${out}"
    return 1
  }
  rm -f "${tmp}"
  jq -e . "${out}" >/dev/null 2>&1 || {
    err "generated ${out} is not valid JSON"
    return 1
  }
  # A placeholder that survived is the worst shape this file can take: still
  # valid JSON, so the runner's gate 7 passes, and every rule carrying one
  # matches nothing. Accepted and then ignored, exactly as in DESIGN 4.6.
  if grep -q '__[A-Z_]*__' "${out}"; then
    err "generated ${out} still contains placeholders: $(grep -o '__[A-Z_]*__' "${out}" | sort -u | tr '\n' ' ')"
    return 1
  fi
}

cmd_install() {
  require_not_root
  local quiet=0
  [ "${1:-}" = --quiet ] && quiet=1
  mkdir -p "${PLIST_DIR}" "${LOG_DIR}" || die "could not create ${PLIST_DIR}"

  local wd bl
  wd=$(cur_workdirs)
  [ -n "${wd}" ] || die "no workdir configured - set DEFAULT_WORKDIR in etc/heinzel.conf"
  # The backlog is named in the deny list, so it has to be known here. An empty
  # value would render as a path rule of `//`, which is a rule about the whole
  # filesystem rather than about nothing.
  bl=$(cur_backlog)
  [ -n "${bl}" ] || die "no backlog configured - set DEFAULT_BACKLOG in etc/heinzel.conf"
  # Through abspath, exactly as a live mode stores it. Without this, installing before
  # the first session writes allow rules for /tmp/x while the agent runs in
  # /private/tmp/x, and the rules match nothing. Every workspace, not the first:
  # a rule that matches nothing is silent, and it would be silent for whichever
  # checkout happened to be listed second.
  wd=$(abspath_lines "${wd}")
  bl=$(abspath "${bl}")
  generate_settings "${wd}" "${bl}" || die "could not generate the agent permission file"
  local pl
  pl=$(plist_path)
  generate_plist >"${pl}" || die "could not write ${pl}"
  launchctl bootout "gui/$(id -u)/${HEINZEL_LABEL}" >/dev/null 2>&1
  if ! launchctl bootstrap "gui/$(id -u)" "${pl}" 2>/dev/null; then
    warn "could not bootstrap ${HEINZEL_LABEL}; check ${pl}"
  fi
  [ "${quiet}" = 1 ] && return 0
  good "installed ${HEINZEL_LABEL}"
  field "schedule" "$(hours_display) (on the hour)"
  field "plist" "${pl}"
  # One workspace prints as it always did. Several print one per line, the
  # first marked, because "the default" is a fact about the list and means
  # nothing when the list is one long.
  local first=1 one many=""
  [ "$(printf '%s\n' "${wd}" | grep -c .)" -gt 1 ] && many=1
  while IFS= read -r one; do
    [ -n "${one}" ] || continue
    if [ "${first}" = 1 ]; then
      field "agent confined to" "${one}${many:+ $(dim "(default)")}"
      first=0
    else
      field "" "${one}"
    fi
  done <<EOF
${wd}
EOF
}

cmd_uninstall() {
  require_not_root
  local quiet=0
  [ "${1:-}" = --quiet ] && quiet=1
  launchctl bootout "gui/$(id -u)/${HEINZEL_LABEL}" >/dev/null 2>&1
  rm -f "$(plist_path)"
  [ "${quiet}" = 1 ] && return 0
  good "removed ${HEINZEL_LABEL}"
}

# --- add -------------------------------------------------------------------

# Put a task in the queue. The one writer the ledger has, reached from a
# person's hands rather than from a run.
#
# Tasks were added by opening `backlog.md` in an editor, which is fine for a
# person at the machine and impossible for anything else - a form on a page, a
# script, a phone. This is that same edit, made through the backlog lock and
# the same insertion the merge uses, so a task added while a run is merging
# lands cleanly instead of racing a rename.
#
# The id is allocated here rather than left to the next run. SPEC §8 says ids
# are the runner's to allocate and never hand-written, and that still holds:
# `backlog_assign_ids` is the runner's own allocator, called under the same
# lock. What it buys is that the person who just added a task is told what it
# is called, which is what they need to say `hzl take` or `hzl block` about it.
_add_locked() { # backlog priority text
  backlog_insert_at_priority "$1" "$2" "$3" || return 1
  backlog_assign_ids "$1" >/dev/null || return 1
}

cmd_add() {
  local b prio=99 dir="" text=""
  while [ $# -gt 0 ]; do
    case $1 in
      --priority|-p) prio=${2:-}; shift ;;
      --dir|-d) dir=${2:-}; shift ;;
      --) shift; break ;;
      -*) die "add: unknown option $1" ;;
      *) break ;;
    esac
    shift
  done

  text=$(oneline "$*")
  [ -n "${text}" ] || die "add: nothing to add. Usage: hzl add [--priority N] [--dir NAME] <text>"
  case ${prio} in
    ""|*[!0-9]*) die "add: --priority must be an integer in 1..99" ;;
  esac
  [ "${prio}" -ge 1 ] && [ "${prio}" -le 99 ] ||
    die "add: --priority must be an integer in 1..99"

  # A workspace that does not exist would be accepted by the ledger and refused
  # by the next run, which would block the task for a reason the person who
  # typed it could have been told immediately.
  if [ -n "${dir}" ]; then
    workdir_path_in "${dir}" "$(cur_workdirs)" >/dev/null || {
      err "add: no workspace named '${dir}'"
      err "configured: $(workdir_names_of "$(cur_workdirs)")"
      exit 1
    }
  fi

  b=$(cur_backlog)
  [ -n "${b}" ] || die "no backlog configured (DEFAULT_BACKLOG in etc/heinzel.conf)"
  backlog_ensure "${b}" || die "could not create ${b}"

  # A task that is already in the ledger word for word is almost always a
  # double submit - a form posted twice, a script re-run. Refused rather than
  # queued twice, because two identical tasks are worked twice and the second
  # one finds nothing to do.
  if ledger_has_text "${b}" "${text}"; then
    err "add: that task is already in the ledger, word for word"
    exit 4
  fi

  with_backlog_lock _add_locked "${b}" "${prio}" "${dir:+(dir:${dir}) }${text}" ||
    die "could not add to ${b}"

  # `LC_ALL=C`: this looks the task up by its own text, which is routinely
  # Japanese here, and BSD awk under a UTF-8 locale reports two different
  # multibyte strings as equal - measured 2026-09-08, and it made this print
  # the id of an unrelated task. Byte comparison is what equality wants.
  local id
  id=$(backlog_scan "${b}" 2>/dev/null |
    LC_ALL=C awk -F'\t' -v t="${text}" '$5 == t {print $4; exit}')
  printf '\n'
  field "added" "${id:-(no id allocated)}"
  field "priority" "P${prio}"
  field "workspace" "${dir:-$(workdir_name "$(workdir_default)") (default)}"
  field "backlog" "${b}"
  printf '\n'
  return 0
}

# --- dashboard -------------------------------------------------------------

# One JSON document holding everything a person could ask this tool at a
# glance: the session, the schedule, the workspaces, every task in the live
# ledger and the recent archive, and the recent runs with their own event
# trails.
#
# It exists so that the web UI has exactly one thing to fetch and no parser of
# its own. The rule the rest of this program follows - the ledger is parsed in
# one place - does not stop being true because the reader is a browser, and a
# second implementation of "what the backlog says" written in JavaScript would
# be the copy that falls behind.
dashboard_tasks_json() { # backlog days
  local b=$1 days=$2 cutoff def
  cutoff=$(date -r "$(( $(now_epoch) - days * 86400 ))" +%Y-%m-%d)
  # The *session's* default workspace, not the configuration's. A session keeps
  # the workspaces it was started with, so after an edit to `heinzel.conf` the
  # two disagree - and the one that decides where an untagged task is worked is
  # the session's. Saying otherwise would put a workspace on the page that the
  # next run will not use.
  def=$(workdir_name "$(cur_workdirs | head -1)")
  {
    ledger_scan_live "${b}" | awk '{print "live\t" $0}'
    backlog_scan "$(ledger_archive "${b}")" 2>/dev/null | awk '{print "archive\t" $0}'
  } |
  jq -R -s --arg def "${def}" --arg cutoff "${cutoff}" '
    def after(k): if (.meta | test(k + ":")) then
        (.meta | sub(".*" + k + ":"; "") | sub("[ ].*"; ""))
      else null end;
    split("\n") | map(select(length > 0)) | map(split("\t")) |
    map({
      source:    .[0],
      line:      (.[1] | tonumber),
      priority:  (.[2] | tonumber),
      marker:    .[3],
      id:        (if .[4] == "" then null else .[4] end),
      text:      .[5],
      workspace: (if .[6] == "" then $def else .[6] end),
      meta:      (.[7] // "")
    })
    | map(. + {
        done_at:    after("done"),
        blocked_at: after("blocked"),
        run:        after("run"),
        reason:     (if (.meta | test("reason:")) then
                       (.meta | capture("reason:(?<r>.*?)(?:[ ](?:run|recovered):|$)").r)
                     else null end)
      })
    # The archive is the record and it only grows; a dashboard that carried all
    # of it would spend most of its bytes on work finished months ago. The live
    # files come whole - they are the queue and what is waiting on a person -
    # and the archive is cut to the window the caller asked for.
    | map(select(.source == "live" or ((.done_at // "") >= $cutoff)))
    | map(del(.meta))
  '
}

# The scheduled slots either side of now: what launchd will do, whether or not
# a run came of it. The past ones are what the actual runs are read against -
# a slot with no run is the thing this page exists to make visible.
dashboard_slots_json() { # back-hours forward-count
  local back=$1 want=$2 now probe mm ss h hh out
  now=$(now_epoch)
  mm=$(date -r "${now}" +%M); mm=${mm#0}; [ -z "${mm}" ] && mm=0
  ss=$(date -r "${now}" +%S); ss=${ss#0}; [ -z "${ss}" ] && ss=0
  probe=$((now - mm * 60 - ss - back * 3600))
  out=""
  while [ "${probe}" -lt "$((now + 48 * 3600))" ]; do
    hh=$(date -r "${probe}" +%H); hh=${hh#0}; [ -z "${hh}" ] && hh=0
    for h in $(hours_normalised); do
      if [ "${h}" -eq "${hh}" ]; then
        out="${out}${probe}
"
        break
      fi
    done
    probe=$((probe + 3600))
  done
  printf '%s' "${out}" | jq -R -s --argjson now "${now}" --argjson want "${want}" '
    split("\n") | map(select(length > 0)) | map(tonumber)
    | (map(select(. <= $now))) as $past
    | (map(select(. > $now)) | .[0:$want]) as $future
    | ($past + $future)
    | map({epoch: ., past: (. <= $now)})'
}

# The recent runs, each with the event trail it wrote about itself. The trail
# is passed through rather than summarised: it is what turns a row into a line
# on the diagram, and deciding here which stages matter would put that decision
# in the wrong place.
dashboard_runs_json() { # limit
  local limit=$1 d n=0
  {
    # A glob and not `ls`: run ids are this program's own and hold nothing
    # exotic, but parsing a directory listing by word is the habit that breaks
    # on the one name that does. Newest first, which is how the page reads them.
    while IFS= read -r d; do
      [ -r "${d}events.jsonl" ] || continue
      n=$((n + 1))
      [ "${n}" -gt "${limit}" ] && break
      jq -s --arg id "$(basename "${d}")" \
        '{id: $id, events: map({kind, at, message})}' "${d}events.jsonl" 2>/dev/null
    done <<EOF
$(printf '%s\n' "${HEINZEL_HOME}"/runs/*/ 2>/dev/null | sort -r)
EOF
  } | jq -s 'sort_by(.events[0].at // "") | reverse'
}

# What the runner said, as classes and not as prose to be grepped. A `skip` is
# a gate that closed and it is the most common thing in this file; the page
# shows it against the slot it happened at, which is how "it did nothing all
# night" becomes "it was on battery at 01:00".
dashboard_log_json() { # lines
  tail -n "$1" "${LOG_DIR}/runner.log" 2>/dev/null |
  jq -R -s '
    split("\n") | map(select(test("^[0-9]{4}-")))
    | map(capture("^(?<at>[^ ]+) +(?<class>[A-Za-z]+) +(?<message>.*)$"))'
}

cmd_dashboard() {
  local days=3 b
  while [ $# -gt 0 ]; do
    case $1 in
      --json) ;;
      --days) days=${2:-}; shift ;;
      *) die "dashboard: unknown option $1" ;;
    esac
    shift
  done
  case ${days} in ""|*[!0-9]*) die "dashboard: --days must be a positive integer" ;; esac

  b=$(cur_backlog)
  [ -n "${b}" ] || die "no backlog configured (DEFAULT_BACKLOG in etc/heinzel.conf)"

  local nxt="" nslot session_json
  nslot=$(next_slot_epoch) && nxt=$(iso_at "${nslot}")

  # `status --json` exits 10 when a session is live - that code is its answer,
  # not a failure - so the output is taken first and the code ignored. Written
  # as `$(cmd_status --json || echo null)` it appended the word `null` after a
  # perfectly good document every time a session was running, which is exactly
  # the case this page exists for.
  session_json=$(cmd_status --json 2>/dev/null)
  [ -n "${session_json}" ] || session_json=null

  local ws_json
  ws_json=$(printf '%s\n' "$(cur_workdirs)" | jq -R -s '
    split("\n") | map(select(length > 0))
    | to_entries | map({
        path: .value,
        name: (.value | sub("/$"; "") | split("/") | last),
        default: (.key == 0)
      })')
  # Whether each one is actually there, asked of the filesystem rather than of
  # the configuration. A checkout that has been moved is a class of tasks that
  # cannot be worked, and this is the page that should say so.
  local one exists="["
  while IFS= read -r one; do
    [ -n "${one}" ] || continue
    exists="${exists}$([ -d "${one}" ] && echo true || echo false),"
  done <<EOF
$(cur_workdirs)
EOF
  exists="${exists%,}]"
  ws_json=$(jq -n --argjson w "${ws_json}" --argjson e "${exists}" \
    '[$w, $e] | transpose | map(.[0] + {exists: .[1]})')

  jq -n \
    --arg generated_at "$(iso_at)" \
    --argjson generated_at_epoch "$(now_epoch)" \
    --arg host "$(hostname -s 2>/dev/null || echo localhost)" \
    --arg version "${HEINZEL_VERSION}" \
    --arg backlog "${b}" \
    --argjson session "${session_json}" \
    --arg hours "$(hours_normalised)" \
    --arg hours_display "$(hours_display)" \
    --argjson min_gap_sec "${HEINZEL_MIN_RUN_GAP_SEC}" \
    --arg next_run "${nxt}" \
    --argjson agent_loaded "$(launchctl print "gui/$(id -u)/${HEINZEL_LABEL}" >/dev/null 2>&1 && echo true || echo false)" \
    --argjson slots "$(dashboard_slots_json 30 6)" \
    --argjson workspaces "${ws_json}" \
    --argjson tasks "$(dashboard_tasks_json "${b}" "${days}")" \
    --argjson runs "$(dashboard_runs_json 40)" \
    --argjson log "$(dashboard_log_json 200)" \
    --arg review "$([ "${HEINZEL_REVIEW}" = 1 ] && echo "${HEINZEL_REVIEWER_ENGINE}" || echo "")" \
    --arg executor "${HEINZEL_EXECUTOR_ENGINE}" \
    --arg model "${HEINZEL_MODEL}" \
    '{generated_at: $generated_at, generated_at_epoch: $generated_at_epoch,
      host: $host, version: $version, backlog: $backlog,
      session: $session,
      schedule: {hours: $hours, display: $hours_display,
                 min_gap_sec: $min_gap_sec,
                 next_run: (if $next_run == "" then null else $next_run end),
                 agent_loaded: $agent_loaded, slots: $slots},
      engines: {executor: $executor, model: $model,
                reviewer: (if $review == "" then null else $review end)},
      workspaces: $workspaces, tasks: $tasks, runs: $runs, log: $log}'
}

# --- web -------------------------------------------------------------------

# Serve the dashboard on loopback, for as long as the terminal that started it
# is willing to hold it.
#
# Not a LaunchAgent and deliberately not one. Everything else Heinzel installs
# runs unattended and is confined for it; this is a window a person opens while
# they are sitting there, and the moment it becomes a service it is a service
# that can write the backlog, running all day, whether or not anyone is looking.
# `hzl off` closes inbound access to this machine — a resident web server
# would be the one thing that stayed listening through it.
#
# python3 is the only new dependency in the whole program, and it is confined
# to this command: `bin/hzl-run` and every gate it walks are untouched by it.
# macOS ships /usr/bin/python3 with the Command Line Tools, so this is a
# dependency on a machine that already has one, and `hzl doctor` reports it as
# needed for `hzl web` and nothing else.
cmd_web() {
  require_not_root
  local port=${HEINZEL_WEB_PORT} days=3 open=1
  while [ $# -gt 0 ]; do
    case $1 in
      --port) port=${2:-}; shift ;;
      --days) days=${2:-}; shift ;;
      --no-open) open=0 ;;
      *) die "web: unknown option $1" ;;
    esac
    shift
  done
  case ${port} in ""|*[!0-9]*) die "web: --port must be a port number" ;; esac
  [ "${port}" -ge 1024 ] && [ "${port}" -le 65535 ] ||
    die "web: --port must be in 1024..65535 (a privileged port would need root, and this refuses to run as root)"
  case ${days} in ""|*[!0-9]*) die "web: --days must be a positive integer" ;; esac

  have python3 || die "web: python3 not found. macOS ships one with the Command Line Tools: xcode-select --install"
  local ui="${HEINZEL_ROOT}/lib/web"
  [ -r "${ui}/server.py" ] || die "web: missing ${ui}/server.py"

  # The backlog has to exist before the page offers a form that writes to it,
  # or the first thing a person does is met with an error about a missing file.
  local b
  b=$(cur_backlog)
  [ -n "${b}" ] || die "no backlog configured (DEFAULT_BACKLOG in etc/heinzel.conf)"
  backlog_ensure "${b}" || die "could not create ${b}"

  local url="http://127.0.0.1:${port}/"
  printf '\n'
  good "serving the dashboard"
  field "url" "${url}"
  field "reachable from" "this machine only (127.0.0.1)"
  field "writes" "the backlog, through 'hzl add', from the form on the page"
  field "stop it with" "ctrl-c"
  printf '\n'

  # Opened after the server is up rather than before, so the first request is
  # not the one that races the bind.
  if [ "${open}" = 1 ] && have open; then
    ( sleep 1; open "${url}" >/dev/null 2>&1 ) &
  fi

  # `exec`, so ctrl-c reaches python rather than this shell, and so there is
  # one process to stop rather than two.
  HZL_BIN="${HEINZEL_ROOT}/bin/hzl" \
  HZL_WEB_UI="${ui}" \
  HZL_WEB_PORT="${port}" \
  HZL_WEB_DAYS="${days}" \
  exec python3 "${ui}/server.py"
}

# --- schedule --------------------------------------------------------------

# "When does this run, and with what settings?"
#
# Both halves of that question had answers before this command and neither was
# reachable: the schedule was a line `hzl install` printed once and an hours
# list in a file the runner reads but nobody opens at nine in the morning, and
# the hour it would next fire was nowhere at all - `hours` is the shape of the
# schedule, not a time. So this prints the next slot as a clock time, and with
# it every setting that decides whether that slot does anything, in the order
# the runner consults them. A slot that will fire and do nothing says so the
# evening before rather than the morning after.
#
# Configuration is not the whole answer and is not printed as though it were:
# `launchctl` is asked whether the agent is actually loaded, and the installed
# plist is diffed against what this configuration generates, because a
# schedule that has been edited but not installed is exactly the failure this
# command exists to catch.
cmd_schedule() {
  [ $# -eq 0 ] || die "schedule: unknown option $1"

  hzl_eval_mode
  local live=0
  [ "${HZ_MODE}" = heinzel ] && live=1

  local now next expires pl loaded=0 throttle
  now=$(now_epoch)
  expires=$(state_get .expires_at_epoch 0)
  next=$(next_slot_epoch "${now}") || next=""
  pl=$(plist_path)
  launchctl print "gui/$(id -u)/${HEINZEL_LABEL}" >/dev/null 2>&1 && loaded=1
  # Read back out of the generated plist rather than written here as well:
  # ThrottleInterval is launchd's floor on re-firing and it belongs to the
  # template, and a second copy of it in this function would be the one that
  # went stale.
  throttle=$(generate_plist |
    awk '/<key>ThrottleInterval<\/key>/ { getline; gsub(/[^0-9]/, ""); print; exit }')

  printf '\nwhen\n'
  field "hours" "$(hours_display) (on the hour)"
  if [ "${HEINZEL_MIN_RUN_GAP_SEC}" -gt 0 ]; then
    field "minimum gap" "${HEINZEL_MIN_RUN_GAP_SEC}s since the last run that ran"
  else
    field "minimum gap" "off (HEINZEL_MIN_RUN_GAP_SEC=0)"
  fi
  field "launchd throttle" "${throttle:-unknown}s between firings"
  field "at load" "does not run - only the schedule starts a run"

  printf '\nthe launch agent\n'
  field "label" "${HEINZEL_LABEL}"
  if [ "${loaded}" = 1 ]; then
    field "loaded" "$(good yes)"
  else
    field "loaded" "$(bad no) - nothing will fire until 'hzl install'"
  fi
  field "plist" "${pl}"
  if [ ! -f "${pl}" ]; then
    field "matches this config" "$(bad "no plist installed") - run 'hzl install'"
  elif generate_plist | diff -q - "${pl}" >/dev/null 2>&1; then
    field "matches this config" "$(good yes)"
  else
    field "matches this config" "$(bad no) - the installed schedule is not this one; run 'hzl install'"
  fi
  field "runner" "${RUNNER}"

  printf '\nnext runs\n'
  if [ -n "${next}" ]; then
    field "next run" "$(short_at "${next}") ($(rel_dur $((next - now))))"
    # The four after it on one line: the left column is a label, and four
    # identical labels would say the same thing four times.
    local more="" e=${next} i=0
    while [ "${i}" -lt 4 ]; do
      e=$(next_slot_epoch "${e}") || break
      more="${more}${more:+, }$(short_at "${e}")"
      i=$((i + 1))
    done
    [ -n "${more}" ] && field "then" "${more}"
  else
    field "next run" "$(bad "no scheduled hour") - check HEINZEL_HOURS"
  fi

  # The gates, asked in the runner's order, so that this is a reading of the
  # same facts and not a second opinion about them.
  local verdict to
  to=$(state_get .run_timeout_sec "${DEFAULT_RUN_TIMEOUT}")
  if [ "${loaded}" != 1 ]; then
    verdict="$(bad no) - the launch agent is not loaded; run 'hzl install'"
  elif [ "${live}" != 1 ]; then
    verdict="$(bad no) - ${HZ_REASON}; use 'hzl work' or 'hzl mobile'"
  elif [ -n "${next}" ] && [ "${expires}" -gt 0 ] && [ "${next}" -ge "${expires}" ]; then
    verdict="$(bad no) - the session expires $(short_at "${expires}"), before that slot"
  elif [ -n "${next}" ] && [ "${expires}" -gt 0 ] && [ $((expires - next)) -lt "${to}" ]; then
    # Gate 5, not a rounding of it: the runner refuses to start a run it cannot
    # finish, so a slot inside the session is still a slot that does nothing
    # when less than one wall clock remains. This is the case a schedule read
    # by eye gets wrong every time.
    verdict="$(bad no) - only $((expires - next))s of session left at that slot, and a run is given ${to}s"
  elif [ "$(state_get .tasks_done_total 0)" -ge "$(state_get .max_tasks_total 0)" ]; then
    verdict="$(bad no) - the session budget is spent ($(budget_line))"
  elif ! on_ac_power && ! session_allows_battery; then
    verdict="$(bad "not while on battery") ($(battery_pct)) - scheduled runs skip; 'hzl run-now' does not"
  elif ! on_ac_power; then
    verdict="$(good yes) - mobile mode permits battery use ($(battery_pct)), unless the backlog is empty or the machine is asleep"
  else
    # Everything knowable now is open. What is left is knowable only then: an
    # empty backlog, a sleeping machine, a run still holding the lease.
    verdict="$(good yes), unless the backlog is empty or the machine is asleep"
  fi
  field "will it run" "${verdict}"

  if [ "${live}" = 1 ]; then
    printf '\nwhat a run will use (this session)\n'
    field "session expires" "$(short_at "${expires}")"
    field "budget" "$(budget_line)"
    field "tasks per run" "$(state_get .max_tasks_per_run 0)"
    field "wall clock per run" "$(state_get .run_timeout_sec 0)s"
    field "workdir" "$(workdirs_display "$(cur_workdirs)")"
    field "backlog" "$(state_get .backlog "")"
  else
    # The defaults, labelled as defaults: outside a session these are what the
    # next `hzl work` would start with, not what anything is running under.
    printf '\nwhat the next session will start with\n'
    field "session length" "${DEFAULT_DURATION}"
    field "tasks per session" "${DEFAULT_MAX_TASKS_TOTAL}"
    field "tasks per run" "${DEFAULT_MAX_TASKS}"
    field "wall clock per run" "${DEFAULT_RUN_TIMEOUT}s"
    field "workdir" "$(workdirs_display "$(workdirs_list)")"
    field "backlog" "${DEFAULT_BACKLOG:-unset}"
  fi

  printf '\nengines\n'
  field "executor" "${HEINZEL_EXECUTOR_ENGINE} (${HEINZEL_MODEL}, ${HEINZEL_EFFORT})"
  if [ "${HEINZEL_REVIEW}" = 1 ]; then
    field "review" "on - ${HEINZEL_REVIEWER_ENGINE}, on revise: ${HEINZEL_REVIEW_ON_REVISE}"
  else
    field "review" "off (HEINZEL_REVIEW=0)"
  fi

  printf '\n'
  return 0
}

# --- dispatch --------------------------------------------------------------

usage() {
  cat <<USAGE
hzl ${HEINZEL_VERSION} - unattended backlog work in one of three modes.

modes
  hzl work [options]         remote posture + unattended work. Options:
                               --duration 10h     TTL, max 24h
                               --max-total N      tasks for the whole session
                               --max-tasks N      tasks per run
                               --timeout N        wall clock per run, seconds
                               --workdir NAME     one of the configured
                                                  workspaces; repeatable.
                                                  Default: all of them
                               --backlog PATH
                               --force            allow starting on battery
                               --no-sudo          do not suppress sleep
                               --no-kick          do not run one immediately
                               --dry-run          say what would happen
  hzl mobile [options]       travel posture + unattended work. Accepts the
                             work options above, plus:
                               --yes              confirm battery use without
                                                  an interactive prompt
  hzl off [--unload]         stop work, restore sleep, and apply travel posture.
                             Exits non-zero if a run could not be confirmed
                             stopped

session controls
  hzl resume                 clear a halt
  hzl set [key N]            show or change limits mid-session
  hzl run-now [--dry-run]    run once now, ignoring the schedule window

backlog
  hzl add [options] <text>   put a task in the queue. Options:
                               --priority N       1..99, default 99
                               --dir NAME         which checkout it is about
  hzl next                   what would be picked up next
  hzl take [id]              list blocked tasks, or print one with its steps
  hzl done <id> [note]       close a task out by hand
  hzl block <id> <reason>    park a task; a reason is required
  hzl unblock <id>           put it back in the queue
  hzl steps [id]             which blocked tasks have instructions for you, or
                             start the instructions for one
  hzl archive                sweep what is closed and what is blocked out of
                             the backlog, and what is unblocked back into it
  hzl report [options]       the morning read: what is blocked, what got done.
                             Exits 10 if anything is blocked. Options:
                               --days N     how far back to look, default 1
                               --json       the same thing, machine-readable
                               --quiet      say nothing; the exit code is the
                                            whole answer

everything else
  hzl status [--json|--quiet]  what is actually true right now
  hzl schedule                 when the next run is, and every setting that
                               decides whether it does anything
  hzl web [--port N]           serve the dashboard on 127.0.0.1 while you
                               watch it. ctrl-c stops it
  hzl dashboard [--days N]     the same thing as one JSON document
  hzl doctor                   check the whole setup
  hzl logs [-f] [-n N]         recent run logs
  hzl install / uninstall      the launchd agent
  hzl version

exit codes: status is 0 when no session is running, 10 when one is, 1 on error.
USAGE
}

hzl_load_conf
if ! hzl_validate_conf; then
  err "refusing to run with an invalid configuration (etc/heinzel.conf)"
  exit 1
fi

cmd=${1:-}
[ $# -gt 0 ] && shift
case ${cmd} in
  status) cmd_status "$@" ;;
  schedule) cmd_schedule "$@" ;;
  add) cmd_add "$@" ;;
  dashboard) cmd_dashboard "$@" ;;
  web) cmd_web "$@" ;;
  work) cmd_work "$@" ;;
  mobile) cmd_mobile "$@" ;;
  off) cmd_off "$@" ;;
  resume) cmd_resume "$@" ;;
  set) cmd_set "$@" ;;
  on)
    err "'hzl on' was replaced; choose 'hzl work' or 'hzl mobile'."
    exit 1
    ;;
  remote)
    err "'hzl remote' was replaced by 'hzl work'."
    exit 1
    ;;
  travel)
    err "'hzl travel' was replaced by 'hzl off'."
    exit 1
    ;;
  next) cmd_next "$@" ;;
  take) cmd_take "$@" ;;
  done) cmd_done "$@" ;;
  block) cmd_block "$@" ;;
  unblock) cmd_unblock "$@" ;;
  steps) cmd_steps "$@" ;;
  archive) cmd_archive "$@" ;;
  report) cmd_report "$@" ;;
  run-now) cmd_runnow "$@" ;;
  logs) cmd_logs "$@" ;;
  doctor) cmd_doctor "$@" ;;
  install) cmd_install "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  version|--version|-v) say "hzl ${HEINZEL_VERSION}" ;;
  help|--help|-h) usage ;;
  "") usage; exit 1 ;;
  *) err "unknown command: ${cmd}"; usage; exit 1 ;;
esac
