#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
#
# hzl-changeset — what did the executor actually change?
#
# Pure shell, no model involved. The review pipeline puts an LLM in exactly one
# position, in the middle; taking the snapshot and computing the diff on either
# side of it are deterministic, so a degraded review can never corrupt the
# ledger.
#
#   hzl-changeset snapshot <workdir> <outdir>
#   hzl-changeset diff     <workdir> <snapdir> [max_bytes]
#
# Two paths, because a working directory is usually not itself a git
# repository while the tasks inside it often are:
#
#   (a) git         repositories found up to two levels down: record HEAD
#                   before, then diff HEAD..HEAD plus the working tree
#   (b) plain files everything else under a size limit: copy, then diff -u

set -uo pipefail

MAX_FILE_BYTES=524288
DIFF_LINE_LIMIT=400
PRUNE_NAMES=".git node_modules .venv venv __pycache__ .pytest_cache .mypy_cache .heinzel"

usage() {
  printf 'usage: %s snapshot <workdir> <outdir>\n' "${0##*/}" >&2
  printf '       %s diff <workdir> <snapdir> [max_bytes]\n' "${0##*/}" >&2
  exit 2
}

# One find invocation with all the prunes attached. Calling `git rev-parse` per
# file instead turns a medium working directory into thousands of process
# spawns, which is slower than the review it feeds.
find_files() {
  local root=$1 name expr=()
  for name in ${PRUNE_NAMES}; do
    expr+=(-name "${name}" -prune -o)
  done
  find "${root}" "${expr[@]}" -type f -size -"${MAX_FILE_BYTES}"c -print 2>/dev/null
}

# Repositories at most two levels down. The path is returned as traversed from
# the working directory, never as git's physical path: when a symlink sits in
# the way (/var -> /private/var is the usual one) a physical path fails to
# prefix-match, and every tracked file gets counted a second time as a plain
# file.
find_git_roots() {
  local root=$1 d
  for d in "${root}" "${root}"/*/ "${root}"/*/*/; do
    [ -d "${d}/.git" ] && printf '%s\n' "${d%/}"
  done 2>/dev/null | sort -u
}

is_under_git() {
  local f=$1 g
  while IFS= read -r g; do
    [ -z "${g}" ] && continue
    case ${f} in
      "${g}"/*) return 0 ;;
    esac
  done <"$2"
  return 1
}

cmd_snapshot() {
  local workdir=$1 outdir=$2 f rel
  [ -d "${workdir}" ] || { printf 'no such workdir: %s\n' "${workdir}" >&2; exit 1; }
  mkdir -p "${outdir}/files" || exit 1

  find_git_roots "${workdir}" >"${outdir}/git-roots.txt"

  : >"${outdir}/git-heads.txt"
  while IFS= read -r g; do
    [ -z "${g}" ] && continue
    printf '%s\t%s\n' "${g}" "$(git -C "${g}" rev-parse HEAD 2>/dev/null || echo none)" \
      >>"${outdir}/git-heads.txt"
  done <"${outdir}/git-roots.txt"

  : >"${outdir}/manifest.txt"
  while IFS= read -r f; do
    [ -z "${f}" ] && continue
    is_under_git "${f}" "${outdir}/git-roots.txt" && continue
    rel=${f#"${workdir}"/}
    printf '%s\n' "${rel}" >>"${outdir}/manifest.txt"
    mkdir -p "${outdir}/files/$(dirname "${rel}")" 2>/dev/null
    cp -p "${f}" "${outdir}/files/${rel}" 2>/dev/null
  done < <(find_files "${workdir}")

  printf 'snapshot: %s git repo(s), %s plain file(s)\n' \
    "$(wc -l <"${outdir}/git-roots.txt" | tr -d ' ')" \
    "$(wc -l <"${outdir}/manifest.txt" | tr -d ' ')"
}

# Truncation is always recorded. A diff silently cut short reads as "reviewed
# in full and approved", which is the one conclusion it must not support.
emit_diff() {
  local label=$1 n
  n=$(wc -l <"$2" | tr -d ' ')
  if [ "${n}" -gt "${DIFF_LINE_LIMIT}" ]; then
    head -"${DIFF_LINE_LIMIT}" "$2"
    printf '\n... TRUNCATED: %s of %s lines shown for %s ...\n' \
      "${DIFF_LINE_LIMIT}" "${n}" "${label}"
  else
    cat "$2"
  fi
}

cmd_diff() {
  local workdir=$1 snapdir=$2 max_bytes=${3:-200000}
  local tmp g head_before head_now f rel changed=0
  [ -d "${snapdir}" ] || { printf 'no snapshot at %s\n' "${snapdir}" >&2; exit 1; }
  tmp=$(mktemp "${TMPDIR:-/tmp}/hzl-diff.XXXXXX") || exit 1

  # (a) git repositories
  while IFS=$(printf '\t') read -r g head_before; do
    [ -z "${g}" ] && continue
    [ -d "${g}" ] || continue
    head_now=$(git -C "${g}" rev-parse HEAD 2>/dev/null || echo none)
    if [ "${head_before}" != "${head_now}" ] && [ "${head_before}" != none ]; then
      printf '\n=== commits in %s (%s..%s)\n' "${g}" "${head_before:0:8}" "${head_now:0:8}"
      git -C "${g}" log --oneline "${head_before}..${head_now}" 2>/dev/null
      git -C "${g}" diff "${head_before}..${head_now}" >"${tmp}" 2>/dev/null
      [ -s "${tmp}" ] && { printf '\n'; emit_diff "${g} commits" "${tmp}"; changed=1; }
    fi
    if [ -n "$(git -C "${g}" status --porcelain 2>/dev/null)" ]; then
      printf '\n=== uncommitted in %s\n' "${g}"
      git -C "${g}" status --porcelain 2>/dev/null
      git -C "${g}" diff HEAD >"${tmp}" 2>/dev/null
      [ -s "${tmp}" ] && { printf '\n'; emit_diff "${g} worktree" "${tmp}"; changed=1; }
    fi
  done <"${snapdir}/git-heads.txt"

  # (b) plain files: added, modified, deleted
  while IFS= read -r f; do
    [ -z "${f}" ] && continue
    is_under_git "${f}" "${snapdir}/git-roots.txt" && continue
    rel=${f#"${workdir}"/}
    if [ ! -e "${snapdir}/files/${rel}" ]; then
      printf '\n=== added: %s\n' "${rel}"
      diff -u /dev/null "${f}" >"${tmp}" 2>/dev/null
      emit_diff "${rel}" "${tmp}"
      changed=1
    elif ! cmp -s "${snapdir}/files/${rel}" "${f}"; then
      printf '\n=== modified: %s\n' "${rel}"
      diff -u "${snapdir}/files/${rel}" "${f}" >"${tmp}" 2>/dev/null
      emit_diff "${rel}" "${tmp}"
      changed=1
    fi
  done < <(find_files "${workdir}")

  while IFS= read -r rel; do
    [ -z "${rel}" ] && continue
    if [ ! -e "${workdir}/${rel}" ]; then
      printf '\n=== deleted: %s\n' "${rel}"
      changed=1
    fi
  done <"${snapdir}/manifest.txt"

  rm -f "${tmp}"
  [ "${changed}" = 1 ] || printf 'no changes\n'
  return 0
}

case ${1:-} in
  snapshot) [ $# -eq 3 ] || usage; cmd_snapshot "$2" "$3" ;;
  diff) [ $# -ge 3 ] || usage; cmd_diff "$2" "$3" "${4:-200000}" ;;
  *) usage ;;
esac
