# Heinzel configuration. Copy to etc/heinzel.conf and edit.
#
# This file is sourced by bash, so it is shell syntax. Every value here is
# validated at startup: a misspelling stops the tool rather than silently
# changing what the unattended run does at 03:00.

# --- what to work on -------------------------------------------------------
# Both must be absolute paths. launchd runs with cwd=/, so a relative path is
# not a latent bug, it is a certain abort.
# There is no sensible default here, so there isn't one: fill both in.
# The directory must already exist; the backlog file is created for you.
#
# DEFAULT_WORKDIR takes SEVERAL checkouts, one per line:
#
#   DEFAULT_WORKDIR="/Users/you/projects/alpha
#   /Users/you/projects/beta"
#
# One line is one workspace, which is what this setting has always been. The
# separator is a newline and not a space, so a path with a space in it keeps
# meaning what it meant.
#
# The queue is still one backlog. A task picks its checkout by name - the last
# component of the path - written at the front of the line:
#
#   ## P1
#   - [ ] (dir:beta) the login page forgets the redirect
#   - [ ] this one has no (dir:), so it goes to alpha
#
# The FIRST line is the default: a task with no `(dir:)` is worked there. A run
# works in one checkout - the one the highest-priority task names - and takes
# only that checkout's tasks, so a night moves through one tree at a time.
#
# Two checkouts cannot share a last component; `hzl doctor` and every command
# refuse the pair rather than let `(dir:x)` mean either of them. Run
# `hzl install` after changing this: the agent's permission file names every
# workspace and is generated from this value.
#
# Keep the backlog OUTSIDE the working directory. The agent works from a
# worksheet the runner merges back into the backlog afterwards, so it never
# needs the file itself - and the sandbox that confines the agent is a path
# boundary, so a backlog outside the working directory is one it cannot reach
# even through a subprocess. `hzl doctor` warns if the two overlap.
#
# The working directory must not be ~/.heinzel or anything inside it: that is
# Heinzel's own state, denied to the agent wholesale, so a run there could
# write nothing. `hzl on` refuses it.
#
# Editing either path takes effect when there is no live session. A running
# session keeps the paths it was started with, and `hzl install` bakes whatever
# is current into the agent's permission file - so after changing one, re-run
# `hzl install` and check `hzl doctor` section 2.
DEFAULT_WORKDIR=""       # e.g. "/Users/you/projects", or several, one per line
DEFAULT_BACKLOG=""       # e.g. "/Users/you/.heinzel/backlog.md"

# --- when to run -----------------------------------------------------------
# Hours (0-23) at which launchd wakes the runner. The single source of truth
# for the schedule: `hzl install` generates the plist from it, and the runner
# guards on it independently, because launchd replays calendar events it missed
# while asleep and would otherwise fire them all at once during the day.
#
# `all` means every hour: a session that is on may work whenever it is on. Write
# the word, not `*` - the value is split by the shell, and `*` would become the
# names of files. Run `hzl install` after changing this; the plist is generated
# from it.
HEINZEL_HOURS="1 2 3 4 5"

# The least time between two runs, in seconds, measured from when the last one
# started. 0 turns it off. It is what stops a wake-up replay from firing every
# slot the machine slept through at once, and it is the only such guard left
# when HEINZEL_HOURS is `all`. An hourly schedule never reaches it: the default
# is under an hour on purpose. Manual runs (`hzl run-now`) are never gated.
HEINZEL_MIN_RUN_GAP_SEC=3000

# --- budget ----------------------------------------------------------------
# Three independent ceilings. The effective per-run limit is
#   min(DEFAULT_MAX_TASKS, DEFAULT_MAX_TASKS_TOTAL - tasks already done)
DEFAULT_MAX_TASKS_TOTAL=3        # per session (on .. off)
DEFAULT_MAX_TASKS=3              # per run
DEFAULT_RUN_TIMEOUT=3600         # wall clock per run, seconds
DEFAULT_DURATION="10h"           # session TTL; the 24h ceiling is not configurable

# --- engines ---------------------------------------------------------------
# Model and effort are always passed explicitly. Interactive settings are
# inherited by the unattended run, so leaving these implicit means someone
# changing their own editor settings silently changes overnight cost.
HEINZEL_EXECUTOR_ENGINE="claude"
HEINZEL_MODEL="claude-opus-5"
HEINZEL_EFFORT="xhigh"           # low|medium|high|xhigh|max

# --- review (opt-in) -------------------------------------------------------
# Off by default: it needs a second engine and it costs money. When enabled,
# the executor's changes are re-read by a different engine in read-only mode.
# A missing or failing reviewer never drops a task; it is a quality gate, not
# an availability dependency.
HEINZEL_REVIEW=0
HEINZEL_REVIEWER_ENGINE="codex"
HEINZEL_CODEX_MODEL="gpt-5.6-sol"
HEINZEL_CODEX_EFFORT="xhigh"
HEINZEL_REVIEW_ON_REVISE="note-only"   # note-only|fix-once|block
HEINZEL_REVIEW_TIMEOUT=900
HEINZEL_REVIEW_MAX_PATCH_BYTES=200000
HEINZEL_CODEX_IGNORE_USER_CONFIG=0

# --- posture (opt-in) ------------------------------------------------------
# `hzl travel` and `hzl remote` change screen sharing, the packet filter,
# wake-on-LAN, the screen lock delay and sudo policy. They refuse to run unless
# this is 1, because guessing at someone else's firewall is not acceptable.
HEINZEL_POSTURE=0
HEINZEL_REMOTE_SCREENLOCK=300          # seconds, or "immediate"
HEINZEL_TRAVEL_SCREENLOCK="immediate"
HEINZEL_REMOTE_IDLE_SLEEP=0            # pmset -c sleep, minutes (0 = never)
HEINZEL_TRAVEL_IDLE_SLEEP=10
HEINZEL_TICKET_TIMEOUT=480             # sudo ticket lifetime, minutes
HEINZEL_CLAUDE_SETTINGS="${HOME}/.claude/settings.json"

# --- housekeeping ----------------------------------------------------------
HEINZEL_LABEL="local.heinzel"          # launchd label
HEINZEL_WEB_PORT=3151                  # `hzl web` listens here, on 127.0.0.1 only
LOG_RETENTION_DAYS=14
