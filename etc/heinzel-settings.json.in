{
  "_comment": [
    "Generated by `hzl install` from etc/heinzel-settings.json.in.",
    "This is defence layer 2: what the unattended agent may and may not do.",
    "deny beats allow. The runner validates this file with `jq -e .` before",
    "every run and aborts if it is malformed, because `claude --print`",
    "silently ignores an invalid settings file - which would drop every rule",
    "below without a word."
  ],
  "permissions": {
    "deny": [
      "Bash(sudo)", "Bash(sudo *)", "Bash(sudo:*)",
      "Bash(su)", "Bash(su *)", "Bash(doas *)",
      "Bash(pmset *)", "Bash(launchctl *)", "Bash(systemsetup *)",
      "Bash(csrutil *)", "Bash(spctl *)", "Bash(nvram *)", "Bash(dscl *)",
      "Bash(defaults write *)", "Bash(crontab *)",
      "Bash(shutdown *)", "Bash(reboot *)", "Bash(halt *)",
      "Bash(diskutil *)", "Bash(dd *)",
      "Bash(git push *)", "Bash(git push:*)",
      "Bash(gh pr create *)", "Bash(gh pr merge *)", "Bash(glab mr merge *)",
      "Bash(rm -rf /*)", "Bash(rm -rf ~*)",

      "Read(~/.claude/settings.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(**/.env)",
      "Read(**/.env.*)",

      "Write(__HEINZEL_HOME__/**)",
      "Edit(__HEINZEL_HOME__/**)",
      "Write(__HEINZEL_ROOT__/**)",
      "Edit(__HEINZEL_ROOT__/**)",
      "Write(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Write(~/Library/LaunchAgents/**)",
      "Edit(~/Library/LaunchAgents/**)"
    ],
    "allow": [
      "Bash(ls *)", "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)",
      "Read(__WORKDIR__/**)",
      "Edit(__WORKDIR__/**)",
      "Write(__WORKDIR__/**)"
    ]
  }
}
