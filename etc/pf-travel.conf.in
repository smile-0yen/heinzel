# Heinzel travel posture - block all inbound traffic.
# Generated by hzl(1) from etc/pf-travel.conf.in. Do not edit the generated file.
#
# socketfilterfw --setblockall is accepted and silently ignored on macOS 26,
# so the actual blocking is done here. Apple's own anchors are preserved so
# that system services that rely on them keep working.

scrub-anchor "com.apple/*"
nat-anchor "com.apple/*"
rdr-anchor "com.apple/*"
dummynet-anchor "com.apple/*"
anchor "com.apple/*"

pass in quick on lo0 all
block drop in all
pass out all

load anchor "com.apple" from "/etc/pf.anchors/com.apple"
